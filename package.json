{
  "name": "kuraberu-ikuji",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^20.19.1 || >=22.12.0",
    "pnpm": "10.11.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "node node_modules/.pnpm/prettier@3.9.6/node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/.pnpm/prettier@3.9.6/node_modules/prettier/bin/prettier.cjs --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "validate:env": "node scripts/validate-build-env.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:rendered": "node scripts/check-rendered-html.mjs",
    "check:deployment": "node scripts/check-deployment-html.mjs",
    "check:external-link-syntax": "node scripts/check-external-links.mjs",
    "check:external-link-reachability": "node scripts/check-external-link-reachability.mjs",
    "check:external-links": "pnpm check:external-link-syntax",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:env && pnpm validate:content && pnpm build && pnpm check:rendered && pnpm check:deployment && pnpm check:external-link-syntax && pnpm test"
  },
  "dependencies": {
    "astro": "6.0.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "vitest": "latest"
  },
  "pnpm": {
    "overrides": {
      "cookie": "1.0.2"
    }
  }
}

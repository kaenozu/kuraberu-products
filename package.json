{
  "name": "kuraberu-ikuji",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.1 || >=22.12.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "astro build && npx playwright test",
    "validate:env": "node scripts/validate-build-env.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:css-usage": "node scripts/report-css-usage.mjs --fail-on-unused",
    "check:spec-claims": "node scripts/spec-claims.mjs check",
    "check:official-links": "node scripts/check-official-links.mjs check",
    "check:rendered": "node scripts/check-rendered-html.mjs",
    "check:deployment": "node scripts/check-deployment-html.mjs",
    "check:post-deploy": "node scripts/test-post-deploy-verification.mjs",
    "check:external-link-syntax": "node scripts/check-external-links.mjs",
    "check:external-link-reachability": "node scripts/check-external-link-reachability.mjs",
    "announce:draft": "node scripts/generate-x-announcements.mjs",
    "verify": "node scripts/verify-pnpm-version.mjs && prettier --check . && eslint . && astro check && node scripts/validate-build-env.mjs && node scripts/validate-content.mjs && node scripts/report-css-usage.mjs --fail-on-unused && astro build && node scripts/check-rendered-html.mjs && node scripts/check-deployment-html.mjs && node scripts/test-post-deploy-verification.mjs && node scripts/check-external-links.mjs && node scripts/check-official-links.mjs check && node scripts/spec-claims.mjs check && node scripts/validate-sns-ranks.mjs check && node scripts/check-radius-tokens.mjs && node scripts/check-purchase-link-consistency.mjs && vitest run"
  },
  "dependencies": {
    "astro": "7.2.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/parser": "8.65.0",
    "cookie": "2.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "prettier": "3.9.6",
    "serve": "^14.2.6",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0"
  }
}

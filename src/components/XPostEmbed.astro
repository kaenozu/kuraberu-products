---
const {url,summary} = Astro.props;
---
<figure class="post"><blockquote class="twitter-tweet"><p>{summary}</p></blockquote><figcaption><a href={url} target="_blank" rel="noopener noreferrer">Xで原文を確認する</a></figcaption></figure><script is:inline>if(!document.querySelector('script[data-x-widget]')){const s=document.createElement('script');s.src='https://platform.twitter.com/widgets.js';s.async=true;s.dataset.xWidget='true';document.head.appendChild(s)}</script>

---
import ProductIdentity from './ProductIdentity.astro';
import VerificationStatus from './VerificationStatus.astro';
import {
  normalizeIdPrefix,
  normalizeVerificationStatus,
  type ComparisonCandidate,
  type ComparisonRow,
  type VerificationStatus as VerificationStatusValue,
} from '../lib/comparison';

interface Props {
  idPrefix: string;
  heading: string;
  conclusion: string;
  left: ComparisonCandidate;
  right: ComparisonCandidate;
  rows?: ComparisonRow[];
  detailHref: string;
  ctaHref?: string;
  eyebrow?: string;
  footerStatuses?: Array<VerificationStatusValue | string>;
  emptyMessage?: string;
}

const {
  idPrefix,
  heading,
  conclusion,
  left,
  right,
  rows = [],
  detailHref,
  ctaHref = '#purchase',
  eyebrow = '30秒比較',
  footerStatuses = ['official'],
  emptyMessage = '比較項目を確認中です。',
} = Astro.props;
const headingId = `${normalizeIdPrefix(idPrefix, 'thirty-second')}-heading`;
const comparisonRows = Array.isArray(rows) ? rows : [];
const statuses = Array.isArray(footerStatuses) ? footerStatuses : [];
---
<section class="thirty-second" aria-labelledby={headingId}>
  <div class="thirty-second-heading"><div><p class="section-label">{eyebrow}</p><h2 id={headingId}>{heading}</h2></div><a class="text-link" href={detailHref}>詳細比較へ ↓</a></div>
  <p class="summary-conclusion"><strong>結論：</strong>{conclusion}</p>
  <div class="summary-products">
    <ProductIdentity {...left} candidate="A" status={normalizeVerificationStatus(left.status)} compact={true} />
    <ProductIdentity {...right} candidate="B" status={normalizeVerificationStatus(right.status)} compact={true} />
  </div>
  {comparisonRows.length > 0 ? (
    <ul class="summary-differences">
      {comparisonRows.map((row) => <li><b>{row.label}</b><span>{row.left}</span><span>{row.right}</span></li>)}
    </ul>
  ) : (
    <p class="summary-empty">{emptyMessage}</p>
  )}
  <div class="summary-footer">{statuses.map((status) => <VerificationStatus status={normalizeVerificationStatus(status)} />)}<a class="cta" href={ctaHref}>購入リンクへ ↓</a></div>
</section>

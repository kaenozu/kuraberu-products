---
/**
 * ComparisonHero — 記事冒頭の「A向き / B向き / 最大の違い」3点構成
 *
 * 仕様（docs/ui-ux-spec-2026-08.md 4.1.1）: タイトル直下に「5秒で違いが分かる」要約を置く。
 * 判断 UI の入口であり、詳細は HeroComparison（30秒比較）・VisualKeyDifferences（差分）に委ねる。
 */
import TrustLine from './TrustLine.astro';

export interface ComparisonHeroLine {
  /** 「軽さ・食洗機を重視する」のような条件句 */
  condition: string;
  brand: string;
  model: string;
}

export interface ComparisonHeroDiff {
  label: string;
  /** 補足（例: 約60g差） */
  note?: string;
}

interface Props {
  lines: ComparisonHeroLine[];
  differences: ComparisonHeroDiff[];
  /** 差分表へのアンカー（例: #key-differences） */
  diffAnchor: string;
  /** 公式情報確認日（YYYY-MM-DD） */
  checkedAt?: string;
}

const { lines, differences, diffAnchor, checkedAt } = Astro.props;
const diffCount = differences.length;
---

<div class="comparison-hero" aria-label="すぐわかる結論">
  <div class="hero-split">
    {
      lines.map((line) => (
        <p class="hero-line">
          <span class="hero-condition">{line.condition} →</span>
          <b>
            {line.brand} {line.model}
          </b>
        </p>
      ))
    }
  </div>
  <div class="hero-diffs">
    <p class="hero-diffs-heading">大きな違いは{diffCount}つ</p>
    <ul>
      {differences.map((diff) => (
        <li>
          {diff.label}
          {diff.note && <span class="hero-diff-note">（{diff.note}）</span>}
        </li>
      ))}
    </ul>
    <a class="hero-diff-link" href={diffAnchor}>違いを詳しく見る →</a>
  </div>
  <TrustLine checkedAt={checkedAt} />
</div>

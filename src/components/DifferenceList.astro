---
import {
  normalizeIdPrefix,
  verificationStatusLabel,
  type DifferenceRow,
} from '../lib/comparison';

interface Props {
  idPrefix: string;
  leftLabel: string;
  rightLabel: string;
  items?: DifferenceRow[];
  eyebrow?: string;
  heading?: string;
  emptyMessage?: string;
}

const {
  idPrefix,
  leftLabel,
  rightLabel,
  items = [],
  eyebrow = '差分だけ',
  heading = '同じ点を省いて、違うところだけ',
  emptyMessage = '比較できる差分はまだありません。',
} = Astro.props;
const headingId = `${normalizeIdPrefix(idPrefix, 'difference')}-heading`;
const rows = Array.isArray(items) ? items : [];
---
<section class="difference-list" aria-labelledby={headingId}>
  <div class="subsection-heading"><p class="section-label">{eyebrow}</p><h2 id={headingId}>{heading}</h2></div>
  {rows.length > 0 ? (
    <div class="difference-table" role="list">
      {rows.map((item) => <div class="difference-row" role="listitem">
        <div class="difference-label">{item.label}</div>
        <div class="difference-value"><strong>{leftLabel}</strong><span>{item.left}</span>{item.leftStatus && <span class="difference-status">{verificationStatusLabel(item.leftStatus)}</span>}</div>
        <div class="difference-value"><strong>{rightLabel}</strong><span>{item.right}</span>{item.rightStatus && <span class="difference-status">{verificationStatusLabel(item.rightStatus)}</span>}</div>
      </div>)}
    </div>
  ) : (
    <p class="difference-empty">{emptyMessage}</p>
  )}
</section>

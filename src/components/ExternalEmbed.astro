---
import {
  createExternalEmbedConfig,
  externalEmbedProviderLabel,
  type ExternalEmbedMatchRank,
  type ExternalEmbedProvider,
} from "../lib/external-embeds";

interface Props {
  provider: ExternalEmbedProvider;
  url: string;
  title: string;
  /** 採用基準ランク: model（型番一致）/ series（シリーズ一致）/ brand（ブランド一般） */
  match: ExternalEmbedMatchRank;
  purpose?: string;
  autoload?: boolean;
  tone?: "good" | "bad" | "mixed";
  /** compact: 埋め込みの会話（返信）を隠して高さを抑える */
  compact?: boolean;
}

const { provider, url, title, purpose, autoload, tone, compact, match } =
  Astro.props;
const config = createExternalEmbedConfig(provider, url);
const providerLabel = externalEmbedProviderLabel(provider);
const toneLabel: Record<NonNullable<Props["tone"]>, string> = {
  good: "良かったという声",
  bad: "気になったという声",
  mixed: "良い・悪い両方の声",
};
---

<aside
  class="external-embed"
  data-external-embed
  data-config={JSON.stringify(config)}
  data-provider={provider}
  data-match={match}
  data-tone={tone}
  data-embed-state="idle"
  data-autoload={autoload ? "true" : undefined}
  data-compact={compact ? "true" : undefined}
  aria-label={`${providerLabel}の外部コンテンツ`}
>
  <div class="external-embed__intro">
    <p class="external-embed__label">外部コンテンツ</p>
    {tone && <p class="external-embed__tone" data-external-embed-tone={tone}>{toneLabel[tone]}</p>}
    <h3>{title}</h3>
    {purpose && <p>{purpose}</p>}
    <p class="external-embed__privacy">
      表示すると、{providerLabel}へIPアドレスや閲覧環境などの情報が送信される場合があります。
    </p>
    <div class="external-embed__actions">
      <button type="button" data-external-embed-load>{providerLabel}の投稿を表示</button>
      <a href={config.canonicalUrl} target="_blank" rel="noopener noreferrer">
        {providerLabel}で直接見る
      </a>
    </div>
    <p class="external-embed__status" data-external-embed-status aria-live="polite"></p>
  </div>
  <div
    class="external-embed__target"
    data-external-embed-target
    tabindex="-1"
    aria-label={`${providerLabel}の埋め込み結果`}
    style={`--external-embed-min-height: ${config.minimumHeight}px`}
    hidden
  ></div>
  <noscript>
    <p>埋め込み表示にはJavaScriptが必要です。上のリンクから元の投稿を確認できます。</p>
  </noscript>
</aside>

<script>
  import {
    assertProviderCallResult,
    createExternalConditionWaiter,
    createExternalEmbedRuntime,
    createExternalLoadWaiter,
    hasConnectedProviderDom,
    renderPinterestWidget,
    type ConditionObserver,
    type EmbedTargetAdapter,
    type PinterestRenderScope,
  } from "../lib/external-embed-runtime";
  import type { ExternalEmbedConfig } from "../lib/external-embeds";
  import {
    clearConsent,
    getCachedConsent,
    setConsent,
    onConsentChange,
    type EmbedConsent,
  } from "../lib/embed-consent";

  type EmbedConfig = {
    provider: "x" | "youtube" | "tiktok" | "pinterest";
    canonicalUrl: string;
    renderer: "iframe" | "widget";
    embedUrl?: string;
    scriptSrc?: string;
    minimumHeight: number;
  };

  type XWindow = Window & {
    twttr?: { widgets?: { load: (element?: HTMLElement) => Promise<void> | void } };
  };

  type PinterestWindow = Window & {
    PinUtils?: { build: () => void };
  };

  const IFRAME_LOAD_TIMEOUT_MS = 15_000;
  // A provider script should not leave the consented embed in an indefinite loading state.
  const SCRIPT_LOAD_TIMEOUT_MS = 15_000;
  // Shared deadline for Pinterest: pinit.js loads pinit_main.js asynchronously,
  // so the API wait and the card render wait share one bounded budget after
  // the script has loaded.
  const WIDGET_RENDER_TIMEOUT_MS = 15_000;
  const PINTEREST_API_POLL_INTERVAL_MS = 150;
  const scriptLoads = new Map<string, Promise<void>>();

  function loadScriptOnce(src: string): Promise<void> {
    const existing = scriptLoads.get(src);
    if (existing) return existing;

    const load = new Promise<void>((resolve, reject) => {
      const present = Array.from(
        document.querySelectorAll<HTMLScriptElement>(
          "script[data-external-embed-script]",
        ),
      ).find((script) => script.dataset.externalEmbedScript === src);
      if (present?.dataset.loaded === "true") {
        resolve();
        return;
      }

      const script = present ?? document.createElement("script");
      script.async = true;
      script.src = src;
      script.dataset.externalEmbedScript = src;
      const waiter = createExternalLoadWaiter(
        script,
        SCRIPT_LOAD_TIMEOUT_MS,
        {
          setTimeout: (callback, delay) => window.setTimeout(callback, delay),
          clearTimeout: (handle) => window.clearTimeout(handle as number),
        },
      );
      waiter.promise.then(
        () => {
          script.dataset.loaded = "true";
          resolve();
        },
        (error: unknown) => {
          script.remove();
          reject(error instanceof Error ? error : new Error("script load failed"));
        },
      );

      if (!present) document.head.append(script);
    });

    const trackedLoad = load.catch((error: unknown) => {
      scriptLoads.delete(src);
      throw error;
    });
    scriptLoads.set(src, trackedLoad);
    return trackedLoad;
  }

  function appendSourceLink(
    target: HTMLElement,
    config: EmbedConfig,
  ): HTMLAnchorElement {
    const link = document.createElement("a");
    link.href = config.canonicalUrl;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.textContent = "元の投稿を開く";
    target.append(link);
    return link;
  }

  async function renderWidget(
    target: HTMLElement,
    config: EmbedConfig,
    attempt: number,
    currentAttempt: () => number,
    setActiveCancel: (
      cancel: (() => void) | undefined,
      expected?: () => void,
    ) => void,
  ): Promise<void> {
    if (!config.scriptSrc) throw new Error("widget script is missing");

    if (config.provider === "x") {
      const quote = document.createElement("blockquote");
      quote.className = "twitter-tweet";
      quote.dataset.dnt = "true";
      const hostEmbed = target.closest("[data-external-embed]") as HTMLElement | null;
      if (hostEmbed?.dataset.compact === "true") {
        quote.dataset.conversation = "none";
      }
      appendSourceLink(quote, config);
      target.append(quote);
      if (!(window as XWindow).twttr?.widgets?.load) {
        await loadScriptOnce(config.scriptSrc);
      }
      if (attempt !== currentAttempt() || !quote.isConnected) {
        throw new Error("external widget render cancelled");
      }
      const widgets = (window as XWindow).twttr?.widgets;
      if (!widgets?.load) throw new Error("X widget API is unavailable");
      await assertProviderCallResult(widgets.load(quote));

      await waitForProviderDom(
        target,
        "x",
        attempt,
        currentAttempt,
        setActiveCancel,
      );
      return;
    }

    const link = appendSourceLink(target, config);
    link.dataset.pinDo = "embedPin";
    if (!(window as PinterestWindow).PinUtils?.build) {
      await loadScriptOnce(config.scriptSrc);
    }
    if (attempt !== currentAttempt() || !target.isConnected) {
      throw new Error("external widget render cancelled");
    }

    // Share one deadline between the PinUtils.build wait and the card render
    // wait so the total wait after script load stays within
    // WIDGET_RENDER_TIMEOUT_MS instead of stacking two 15s timeouts.
    const deadline = Date.now() + WIDGET_RENDER_TIMEOUT_MS;
    const remaining = () => Math.max(0, deadline - Date.now());
    const pinterestScope: PinterestRenderScope = {
      isConnected: () => attempt === currentAttempt() && target.isConnected,
      apiReady: () => Boolean((window as PinterestWindow).PinUtils?.build),
      callBuild: () => (window as PinterestWindow).PinUtils?.build?.(),
      hasRenderedDom: () => hasConnectedProviderDom("pinterest", target),
      observeDom(onChange) {
        const mutationObserver = new MutationObserver(onChange);
        mutationObserver.observe(target, { childList: true, subtree: true });
        return () => mutationObserver.disconnect();
      },
    };
    await renderPinterestWidget(
      pinterestScope,
      PINTEREST_API_POLL_INTERVAL_MS,
      remaining,
      {
        setTimeout: (callback, delay) => window.setTimeout(callback, delay),
        clearTimeout: (handle) => window.clearTimeout(handle as number),
      },
      setActiveCancel,
    );
    return;
  }

  async function waitForProviderDom(
    target: HTMLElement,
    provider: "x" | "pinterest",
    attempt: number,
    currentAttempt: () => number,
    setActiveCancel: (
      cancel: (() => void) | undefined,
      expected?: () => void,
    ) => void,
  ): Promise<void> {
    const observer: ConditionObserver = {
      observe(onChange) {
        const mutationObserver = new MutationObserver(onChange);
        mutationObserver.observe(target, { childList: true, subtree: true });
        observer.disconnect = () => mutationObserver.disconnect();
      },
      disconnect() {},
    };
    const waiter = createExternalConditionWaiter(
      () =>
        attempt === currentAttempt() &&
        hasConnectedProviderDom(provider, target),
      observer,
      WIDGET_RENDER_TIMEOUT_MS,
      {
        setTimeout: (callback, delay) => window.setTimeout(callback, delay),
        clearTimeout: (handle) => window.clearTimeout(handle as number),
      },
    );
    setActiveCancel(waiter.cancel);
    try {
      await waiter.promise;
    } finally {
      setActiveCancel(undefined, waiter.cancel);
    }
  }

  function createTargetAdapter(
    target: HTMLElement,
    title: string,
  ): EmbedTargetAdapter {
    let activeCancel: (() => void) | undefined;
    let attempt = 0;

    const adapter: EmbedTargetAdapter = {
      clear() {
        activeCancel?.();
        activeCancel = undefined;
        attempt += 1;
        target.replaceChildren();
      },

      async renderIframe(
        embedConfig: ExternalEmbedConfig,
        embedTitle: string,
      ): Promise<void> {
        if (!embedConfig.embedUrl) throw new Error("iframe URL is missing");

        const currentAttempt = ++attempt;
        const iframe = document.createElement("iframe");
        iframe.src = embedConfig.embedUrl;
        iframe.title = embedTitle || title;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.allow =
          embedConfig.provider === "youtube"
            ? "autoplay; encrypted-media; picture-in-picture"
            : "encrypted-media";
        iframe.allowFullscreen = true;

        const waiter = createExternalLoadWaiter(
          iframe,
          IFRAME_LOAD_TIMEOUT_MS,
          {
            setTimeout: (callback, delay) => window.setTimeout(callback, delay),
            clearTimeout: (handle) => window.clearTimeout(handle as number),
          },
        );
        activeCancel = waiter.cancel;
        target.append(iframe);
        const loadPromise = waiter.promise.finally(() => {
          if (activeCancel === waiter.cancel) activeCancel = undefined;
        });
        await loadPromise;
        if (currentAttempt !== attempt || !iframe.isConnected) {
          throw new Error("external iframe render cancelled");
        }
      },

      renderWidget(embedConfig: ExternalEmbedConfig): Promise<void> {
        const currentAttempt = ++attempt;
        return renderWidget(
          target,
          embedConfig,
          currentAttempt,
          () => attempt,
          (cancel, expected) => {
            if (!expected || activeCancel === expected) activeCancel = cancel;
          },
        );
      },
    };

    return adapter;
  }

  // ---- 同意バナー / 撤回UI（ページに各1枚だけ注入する） --------------------
  // バナーは非阻断型（モーダルにしない）。表示時に tabindex="-1" を付けて
  // フォーカスを移動し、キーボード/スクリーンリーダー利用者に選択肢を
  // 確実に届ける。フォーカストラップは設けない（閲覧を妨げないため）。

  function ensureEmbedConsentStyles(): void {
    if (document.querySelector("style[data-embed-consent-style]")) return;
    const style = document.createElement("style");
    style.dataset.embedConsentStyle = "true";
    style.textContent = `.embed-consent-banner{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:.75rem 1rem;margin-bottom:1rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper);font-size:.88rem}.embed-consent-banner p{margin:0}.embed-consent-banner__text{flex:1 1 20rem;color:var(--ink)}.embed-consent-banner__actions{display:flex;gap:.5rem;flex-shrink:0}.embed-consent-banner button{border:0;border-radius:var(--radius-sm);padding:.5rem .85rem;font:inherit;font-weight:800;cursor:pointer}[data-embed-consent-accept]{background:var(--ink);color:#fff}[data-embed-consent-reject]{background:transparent;border:1px solid var(--line)!important;color:var(--ink)}.embed-consent-withdraw{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;padding:.5rem .85rem;margin-bottom:1rem;border:1px dashed var(--line);border-radius:var(--radius-sm);background:transparent;color:var(--muted);font-size:.8rem}.embed-consent-withdraw p{margin:0}.embed-consent-withdraw button{border:1px solid var(--line);border-radius:var(--radius-sm);padding:.35rem .7rem;font:inherit;font-weight:700;background:transparent;color:inherit;cursor:pointer}`;
    document.head.append(style);
  }

  function showWithdrawControl(): HTMLElement | undefined {
    if (document.querySelector("[data-embed-consent-withdraw]")) return undefined;
    const firstEmbed = document.querySelector("[data-external-embed]");
    if (!firstEmbed?.parentNode) return undefined;
    const consent = getCachedConsent();
    if (!consent) return undefined;
    ensureEmbedConsentStyles();

    const bar = document.createElement("div");
    bar.className = "embed-consent-withdraw";
    bar.dataset.embedConsentWithdraw = "";

    const label = document.createElement("p");
    label.textContent =
      consent === "granted"
        ? "このブラウザでは外部コンテンツの表示を許可しています。"
        : "このブラウザでは外部コンテンツを表示しない設定になっています。";

    const changeButton = document.createElement("button");
    changeButton.type = "button";
    changeButton.dataset.embedConsentChange = "";
    // 撤回（withdraw）: 同意キーの削除と埋め込みプレースホルダーへの復帰。
    // 各 autoload 埋め込みは onConsentChange(undefined) で idle 状態へ戻り、
    // 以降の第三者リクエストは再同意まで発生しない。
    changeButton.textContent = "設定を変更する";
    changeButton.addEventListener("click", () => {
      clearConsent();
      bar.remove();
      showConsentBanner();
    });

    bar.append(label, changeButton);
    firstEmbed.parentNode.insertBefore(bar, firstEmbed);
    return bar;
  }

  function showConsentBanner(): HTMLElement | undefined {
    if (document.querySelector("[data-embed-consent-banner]")) return undefined;
    const firstEmbed = document.querySelector("[data-external-embed]");
    if (!firstEmbed?.parentNode) return undefined;
    document.querySelector("[data-embed-consent-withdraw]")?.remove();
    ensureEmbedConsentStyles();

    const text = document.createElement("div");
    text.className = "embed-consent-banner__text";
    const title = document.createElement("p");
    const strong = document.createElement("strong");
    strong.textContent = "外部コンテンツの表示";
    title.append(strong);
    const body = document.createElement("p");
    body.textContent =
      "この記事にはX・YouTubeなどの外部投稿が含まれています。表示すると、IPアドレスや閲覧環境などの情報が外部サービスに送信される場合があります。";
    text.append(title, body);

    const actions = document.createElement("div");
    actions.className = "embed-consent-banner__actions";
    const accept = document.createElement("button");
    accept.type = "button";
    accept.setAttribute("data-embed-consent-accept", "");
    accept.textContent = "すべて表示";
    const reject = document.createElement("button");
    reject.type = "button";
    reject.setAttribute("data-embed-consent-reject", "");
    reject.textContent = "表示しない";
    actions.append(accept, reject);

    const banner = document.createElement("div");
    banner.className = "embed-consent-banner";
    banner.dataset.embedConsentBanner = "";
    banner.setAttribute("role", "region");
    banner.setAttribute("aria-label", "外部コンテンツの表示について");
    banner.tabIndex = -1;
    banner.append(text, actions);

    accept.addEventListener("click", () => {
      setConsent("granted");
      banner.remove();
      const withdrawBar = showWithdrawControl();
      // 選択ボタンが消えるため、撤回UIの操作へフォーカスを維持する。
      withdrawBar?.querySelector("button")?.focus({ preventScroll: true });
    });
    reject.addEventListener("click", () => {
      setConsent("denied");
      banner.remove();
      const withdrawBar = showWithdrawControl();
      withdrawBar?.querySelector("button")?.focus({ preventScroll: true });
    });

    firstEmbed.parentNode.insertBefore(banner, firstEmbed);
    // 表示時にバナー自身へフォーカスを移動する。region 名と本文が
    // スクリーンリーダーで読み上げられ、Tab ですぐにボタンへ届く。
    banner.focus();
    return banner;
  }


  for (const root of document.querySelectorAll<HTMLElement>("[data-external-embed]")) {
    if (root.dataset.initialized === "true") continue;
    root.dataset.initialized = "true";

    const button = root.querySelector<HTMLButtonElement>("[data-external-embed-load]");
    const target = root.querySelector<HTMLElement>("[data-external-embed-target]");
    const status = root.querySelector<HTMLElement>("[data-external-embed-status]");
    const rawConfig = root.dataset.config;
    if (!button || !target || !status || !rawConfig) continue;

    const config = JSON.parse(rawConfig) as EmbedConfig;
    const targetAdapter = createTargetAdapter(
      target,
      button.textContent ?? "外部コンテンツ",
    );
    const runtime = createExternalEmbedRuntime(
      config as ExternalEmbedConfig,
      button.textContent ?? "外部コンテンツ",
      targetAdapter,
    );
    let actionPromise: Promise<void> | undefined;
    let disposed = false;
    const dispose = () => {
      if (disposed) return;
      disposed = true;
      lifecycleObserver.disconnect();
      button.removeEventListener("click", onClick);
      runtime.dispose();
    };
    const lifecycleObserver = new MutationObserver(() => {
      if (!root.isConnected) dispose();
    });
    lifecycleObserver.observe(root.parentElement ?? document, {
      childList: true,
      subtree: true,
    });
    // 同意の撤回（clearConsent → undefined）でプレースホルダーへ復帰したことを
    // マーキングする世代カウンタ。進行中の load が後から reject しても、
    // エラー扱いのUI（フォーカス移動・エラーメッセージ）を上書きさせない。
    let resetGeneration = 0;
    const resetToPlaceholder = () => {
      resetGeneration += 1;
      targetAdapter.clear();
      target.hidden = true;
      root.dataset.embedState = "idle";
      const actions = root.querySelector(".external-embed__actions");
      if (!button.isConnected && actions) {
        actions.prepend(button);
      }
      button.disabled = false;
      button.hidden = false;
      status.textContent = "";
    };
    const onClick = () => {
      if (disposed) return;
      if (actionPromise) return;
      const generationAtStart = resetGeneration;

      actionPromise = (async () => {
        button.disabled = true;
        target.hidden = false;
        const loadPromise = runtime.load();
        root.dataset.embedState = runtime.state;
        status.textContent = "外部コンテンツを読み込んでいます。";

        try {
          await loadPromise;
          if (
            disposed ||
            !root.isConnected ||
            generationAtStart !== resetGeneration
          ) {
            return;
          }
          root.dataset.embedState = runtime.state;
          status.textContent = "外部コンテンツを表示しました。";
          target.focus({ preventScroll: true });
          if (root.dataset.autoload === "true") {
            // autoload: 撤回時に手動読み込みUIへ戻せるよう、ボタンはDOMに残し
            // 非表示にする（loaded 状態ではCSSでアクション列ごと隠れる）。
            button.hidden = true;
          } else {
            button.remove();
          }
        } catch {
          if (
            disposed ||
            !root.isConnected ||
            generationAtStart !== resetGeneration
          ) {
            return;
          }
          targetAdapter.clear();
          target.hidden = true;
          root.dataset.embedState = runtime.state;
          button.disabled = false;
          status.textContent =
            "埋め込みを読み込めませんでした。元の投稿へのリンクから確認してください。";
          button.focus({ preventScroll: true });
        }
      })().finally(() => {
        actionPromise = undefined;
      });
    };
    button.addEventListener("click", onClick);

    if (root.dataset.autoload === "true") {
      // autoload: 同意済みなら自動で読み込む。未同意なら同意バナーを表示。
      const handleConsentChange = (consent: EmbedConsent | undefined) => {
        if (consent === "granted" && root.dataset.embedState === "idle") {
          onClick();
        } else if (
          consent === undefined &&
          root.dataset.embedState !== "idle"
        ) {
          // 撤回: localStorage の同意キーを削除し、埋め込みを
          // 手動読み込みのプレースホルダーへ戻す。
          resetToPlaceholder();
        }
      };
      onConsentChange(handleConsentChange);

      const consent = getCachedConsent();
      if (consent === "granted") {
        // 同意済み: 即座に読み込む。
        onClick();
      } else if (consent === undefined) {
        // 未同意: 同意バナーを1枚だけ注入し、ユーザーの選択を待つ。
        showConsentBanner();
      } else {
        // granted / denied 済み: 撤回（設定変更）UIを1枚だけ出す。
        showWithdrawControl();
      }
    }
  }
</script>

<style>
  .external-embed {
    margin-block: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .external-embed__intro {
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .external-embed__label {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .external-embed__tone {
    display: inline-block;
    margin: 0 0 0.6rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .external-embed__tone[data-external-embed-tone="good"] {
    background: color-mix(in srgb, #2e7d32 12%, transparent);
    color: #2e7d32;
  }

  .external-embed__tone[data-external-embed-tone="bad"] {
    background: color-mix(in srgb, #b26a00 12%, transparent);
    color: #9a5b00;
  }

  .external-embed__tone[data-external-embed-tone="mixed"] {
    background: color-mix(in srgb, var(--muted) 14%, transparent);
    color: var(--ink);
  }

  .external-embed h3 {
    margin: 0 0 0.75rem;
  }

  .external-embed__privacy,
  .external-embed__status {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .external-embed__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .external-embed button {
    border: 0;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .external-embed button:disabled {
    cursor: progress;
    opacity: 0.65;
  }

  .external-embed__target {
    min-height: var(--external-embed-min-height);
    padding: 1rem;
    border-top: 1px solid var(--line);
    background: #fff;

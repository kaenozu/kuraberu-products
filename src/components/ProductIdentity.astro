---
import VerificationStatus from './VerificationStatus.astro';
import {
  normalizeVerificationStatus,
  type CandidateTone,
  type VerificationStatus as VerificationStatusValue,
} from '../lib/comparison';

interface Props {
  product: string;
  line: string;
  tone: CandidateTone;
  audience: string;
  note: string;
  status?: VerificationStatusValue | string;
  compact?: boolean;
  candidate?: 'A' | 'B';
}

const {
  product,
  line,
  tone,
  audience,
  note,
  status,
  compact = false,
  candidate = 'B',
} = Astro.props;
const normalizedStatus = normalizeVerificationStatus(status);
const candidateLabel = candidate;
---
<article class={`product-identity product-${tone} ${compact ? 'product-identity-compact' : ''}`}>
  <div class="product-swatch" aria-hidden="true"><span>{candidateLabel}</span></div>
  <div class="product-identity-body">
    <p class="product-kicker">候補 {candidateLabel} · {product}</p>
    <h3>{line}</h3>
    <p class="product-audience">{audience}</p>
    {!compact && <p class="product-note">{note}</p>}
    <VerificationStatus status={normalizedStatus} />
  </div>
</article>

---
import { publicArticleMetadata } from '../content/articles';
import { comparisonSubjects } from '../lib/article-subjects';
import { selectRelatedArticles } from '../lib/related-articles';

interface Props {
  currentPath: string;
  currentCategory: string;
}

const { currentPath, currentCategory } = Astro.props;

// 関連記事は同カテゴリの先頭 n 件ではなく、関連性スコア
// （用途・タグ・検索意図・カテゴリの一致度）で選ぶ。
// 上限は config/article-layout.mjs の relatedSelection が唯一の情報源。
const { related, others } = selectRelatedArticles(
  publicArticleMetadata,
  currentPath,
  currentCategory,
);
---
{
  related.length > 0 && (
    <section class="related-articles section wrap" aria-labelledby="related-heading">
      <h2 id="related-heading">関連する比較記事</h2>
      <div class="article-list">
        {related.map((article) => {
          const subjects = comparisonSubjects(article);
          return (
            <article class="card article-list-card">
              <span class="tag">{article.category}</span>
              <h3><a href={article.path}>{article.headline}</a></h3>
              {subjects && <p class="card-subjects">{subjects.join(' / ')}</p>}
              <p class="card-audiences">向き: {article.audiences.join('・')}</p>
            </article>
          );
        })}
      </div>
    </section>
  )
}
{
  others.length > 0 && (
    <section class="related-articles section wrap" aria-labelledby="others-heading">
      <h2 id="others-heading">ほかの比較記事</h2>
      <ul class="related-links">
        {others.map((article) => (
          <li><a href={article.path}>{article.headline}</a></li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related-articles {
    margin-block: 3rem;
  }
  .related-articles h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  /* 関連カードはサムネイルを持たないため、.article-list-card の 132px サムネイル
     列（grid-template-columns: 132px 1fr）を解除して本文を 1 カラムに広げる。 */
  .related-articles .article-list-card {
    grid-template-columns: 1fr;
    max-width: none;
  }
  .related-links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .related-links a {
    color: var(--link, #1a5a7a);
    text-decoration: none;
  }
  .related-links a:hover {
    text-decoration: underline;
  }
</style>

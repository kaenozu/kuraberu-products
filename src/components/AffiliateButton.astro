---
import {isAllowedRakutenUrl, isAffiliateRakutenUrl, toAffiliateRakutenUrl} from '../../config/runtime-env.mjs';
import {ARTICLE_LAYOUT} from '../../config/article-layout.mjs';
import {resolvePurchaseHref} from '../lib/rakuten';
import {productQueries, type ProductId} from '../lib/purchase-queries';
const {href,label,productId,placement,imagePath,subLabel,searchQuery,requiredTerms} = Astro.props;

const directHref = typeof href === 'string' && isAllowedRakutenUrl(href) ? href : undefined;
const genericQuery = typeof searchQuery === 'string' && searchQuery.trim()
  ? {
      keyword: searchQuery,
      requiredTerms: Array.isArray(requiredTerms) && requiredTerms.length > 0
        ? requiredTerms
        : searchQuery.split(/\s+/).filter(Boolean),
    }
  : undefined;
const query = productQueries[productId as ProductId] ?? genericQuery;
const fallbackHref = toAffiliateRakutenUrl(directHref);
const resolved = query
  ? await resolvePurchaseHref({
      keyword: query.keyword,
      requiredTerms: query.requiredTerms,
      selection: 'selection' in query ? query.selection : undefined,
      fallbackUrl: directHref,
    })
  : { href: fallbackHref ?? '', isAffiliate: isAffiliateRakutenUrl(fallbackHref) };
const resolvedHref = resolved.href;
const valid = isAllowedRakutenUrl(resolvedHref);
const isAffiliateHref = resolved.isAffiliate;
const ctaRel = isAffiliateHref
  ? 'sponsored nofollow noopener noreferrer'
  : 'nofollow noopener noreferrer';
const ctaLabel = isAffiliateHref ? label : '楽天市場で検索';
const ctaSubLabel = isAffiliateHref
  ? (subLabel ?? '商品ページを確認する')
  : '検索結果を確認する';
---
{valid ? (
  <a
    class="cta cta-card"
    href={resolvedHref}
    target="_blank"
    rel={ctaRel}
    data-product-id={productId}
    data-placement={placement}
    data-cta-event={ARTICLE_LAYOUT.ctaEvent}
  >
    {imagePath && <img class="cta-card-image" src={imagePath} alt="" width="96" height="96" loading="lazy" />}
    <span class="cta-card-body">
      <span class="cta-card-label">{ctaLabel}</span>
      <span class="cta-card-sub">{ctaSubLabel} →{isAffiliateHref && <span class="ad-note">（広告）</span>}</span>
    </span>
  </a>
) : (
  <span class="notice">公式サイトまたは販売ページで商品を確認してください。</span>
)}

---
import {isAllowedRakutenUrl} from '../../config/runtime-env.mjs';
import {fetchRakutenProducts, selectRakutenProduct, type RakutenSelectionOptions} from '../lib/rakuten';
const {href,label,merchant,productId,placement} = Astro.props;

type ProductId = 'pampers-premium-newborn' | 'pampers-sarasara-newborn';
type ProductQuery = {
  keyword: string;
  requiredTerms: readonly string[];
  selection: RakutenSelectionOptions;
};

const productQueries: Record<ProductId, ProductQuery> = {
  'pampers-premium-newborn': {
    keyword: 'パンパース 肌へのいちばん 新生児',
    requiredTerms: ['パンパース', '肌へのいちばん', '新生児'],
    selection: {
      excludedTerms: ['90枚', '2パック', 'セット', '旧モデル'],
      exactIdentifiers: ['4987176203229'],
    },
  },
  'pampers-sarasara-newborn': {
    keyword: 'パンパース さらさらケア 新生児',
    requiredTerms: ['パンパース', 'さらさらケア', '新生児'],
    selection: {
      excludedTerms: ['パンツ', '2パック', 'セット', '旧モデル'],
      exactIdentifiers: ['1710000040'],
    },
  },
} as const;

const directHref = typeof href === 'string' && isAllowedRakutenUrl(href) ? href : undefined;
const query = productQueries[productId as ProductId];
const generated = !directHref && query
  ? selectRakutenProduct(await fetchRakutenProducts(query.keyword), query.requiredTerms, query.selection)?.affiliateUrl
  : undefined;
const resolvedHref = directHref ?? generated;
const valid = isAllowedRakutenUrl(resolvedHref);
---
{valid ? <a class="cta" href={resolvedHref} target="_blank" rel="sponsored nofollow noopener noreferrer" data-product-id={productId} data-placement={placement}>{label}（広告）</a> : <span class="notice">{merchant}の購入リンクは準備中です。公式サイトまたは販売ページで商品を確認してください。</span>}

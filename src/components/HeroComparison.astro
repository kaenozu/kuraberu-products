---
import { Image } from "astro:assets";
import { resolveImage } from "../lib/image-resolver";

interface HeroProduct {
  /** ブランド名（例: サーモス） */
  brand: string;
  /** 型番など（例: JNL-S500） */
  line: string;
  /** 短いキャッチコピー（例: 軽さ・食洗機なら） */
  tagline: string;
  /** 商品画像パス */
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  /** 公式ページ */
  officialHref: string;
}

interface Props {
  left: HeroProduct;
  right?: HeroProduct;
  eyebrow?: string;
  /** 結論ブロックとして使う場合の見出し（例: 結局どっち？）。省略時は従来のカード表示のみ。 */
  heading?: string;
  /** 見出しの id（ページ内ジャンプのアンカー。例: decision-guide） */
  anchorId?: string;
  /** 左カードに表示する「こんな人におすすめ」チェックリスト（省略時は「こちら」ピル表示） */
  leftPoints?: string[];
  /** 右カードに表示する「こんな人におすすめ」チェックリスト */
  rightPoints?: string[];
}

const {
  left,
  right,
  eyebrow = '30秒でわかる',
  heading,
  anchorId,
  leftPoints,
  rightPoints,
} = Astro.props;

const resolvedLeftImage = resolveImage(left.image);
const resolvedRightImage = right ? resolveImage(right.image) : undefined;
---

<section class="hero-compare" aria-label={eyebrow}>
  {heading ? (
    <div class="subsection-heading">
      <p class="section-label">{eyebrow}</p>
      <h2 id={anchorId}>{heading}</h2>
    </div>
  ) : (
    <p class="section-label">{eyebrow}</p>
  )}
  <div class={`hero-compare-grid${right ? '' : ' is-single'}`}>
    {/* チェックリストは「こんな人に」の1行（tagline）と重複する要素を除いて表示する
        （全記事で tagline === guidePoints[0] のため、二重表示を防ぐ）。 */}
    {(() => {
      const renderCard = (product: HeroProduct, points?: string[], resolvedImg?: any) => {
        const visiblePoints = (points ?? []).filter(
          (point) => point !== product.tagline,
        );
        return (
          <article class="hero-product">
            <a class="hero-product-img" href={product.officialHref} target="_blank" rel="noopener noreferrer" aria-label={`${product.brand} ${product.line} の公式商品ページを見る`}>
              {resolvedImg ? (
                <Image src={resolvedImg} alt={product.imageAlt} width={product.imageWidth ?? 500} height={product.imageHeight ?? 500} loading="eager" />
              ) : (
                <img src={product.image} alt={product.imageAlt} width={product.imageWidth ?? 500} height={product.imageHeight ?? 500} loading="eager" />
              )}
            </a>
            <h3 class="hero-product-name"><span>{product.brand}</span> {product.line}</h3>
            {points ? (
              <>
                <p class="hero-product-tagline">{product.tagline}</p>
                {visiblePoints.length > 0 && (
                  <ul class="hero-product-points">
                    {visiblePoints.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
              </>
            ) : (
              <p class="hero-product-tagline">{product.tagline}<b>こちら</b></p>
            )}
            <div class="hero-product-actions">
              <a class="hero-official" href={product.officialHref} target="_blank" rel="noopener noreferrer">公式</a>
            </div>
          </article>
        );
      };
      return (
        <>
          {renderCard(left, leftPoints, resolvedLeftImage)}
          {right && renderCard(right, rightPoints, resolvedRightImage)}
        </>
      );
    })()}
  </div>
</section>

<style>
  .hero-compare {
    margin-block: 0.75rem 2rem;
  }
  .hero-compare-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .hero-compare-grid.is-single {
    grid-template-columns: minmax(0, 1fr);
  }
  .hero-compare-grid.is-single .hero-product {
    max-width: 520px;
    width: 100%;
    margin-inline: auto;
  }
  .hero-product {
    border: 1px solid var(--line);
    border-top: 5px solid var(--product-color, var(--ink));
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--paper) 0%, rgba(255,255,255,0.8) 100%);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: box-shadow 0.2s ease;
  }
  .hero-product:hover {
    box-shadow: var(--card-shadow-md, 0 4px 16px rgba(26, 47, 35, 0.08));
  }
  .hero-product:first-child {
    --product-color: var(--product-left);
  }
  .hero-product:last-child {
    --product-color: var(--product-right);
  }
  .hero-product-img {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: linear-gradient(135deg, #f4f2ec, #f9f7f3);
    padding: 0.75rem;
  }
  .hero-product-img img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
  .hero-product-name {
    margin: 0.25rem 0 0;
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .hero-product-name span {
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--muted);
    margin-right: 0.15rem;
  }
  .hero-product-tagline {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--product-highlight);
    line-height: 1.5;
  }
  .hero-product-points {
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }
  .hero-product-points li {
    position: relative;
    padding-left: 1.55rem;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .hero-product-points li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.12rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--product-color);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
    display: grid;
    place-items: center;
  }
  .hero-product-tagline b {
    background: var(--product-highlight);
    color: #fff;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.08rem 0.5rem;
    border-radius: 999px;
    margin-left: 0.3rem;
    white-space: nowrap;
  }
  .hero-product-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .hero-buy {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    white-space: nowrap;
  }
  .hero-buy:hover {
    filter: brightness(1.05);
  }
  .hero-official {
    font-size: 0.8rem;
    color: var(--muted);
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .hero-compare-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }
    .hero-product {
      padding: 0.7rem;
    }
    .hero-product-tagline {
      font-size: 0.85rem;
    }
    .hero-buy {
      font-size: 0.78rem;
      padding: 0.4rem 0.6rem;
    }
  }
</style>

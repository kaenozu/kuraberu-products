---
import {
  normalizeVerificationStatus,
  type VerificationStatus,
} from '../lib/comparison';

interface Props {
  status?: VerificationStatus | string;
}

const normalizedStatus = normalizeVerificationStatus(Astro.props.status);
const states = {
  official: {icon: '✓', label: 'メーカー公式記載'},
  retailer: {icon: '↗', label: '販売ページ記載'},
  insufficient: {icon: '…', label: '口コミ情報不足'},
  unverified: {icon: '?', label: '未確認'},
} as const;
const state = states[normalizedStatus];
---
<span class={`status status-${normalizedStatus}`} aria-label={`確認状態: ${state.label}`}><b aria-hidden="true">{state.icon}</b>{state.label}</span>

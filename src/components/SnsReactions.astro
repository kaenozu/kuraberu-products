---
interface SnsReaction {
  /** 投稿者ハンドル（例: @pipichan_lovely） */
  handle: string;
  /** 投稿者表示名 */
  name: string;
  /** 投稿の抜粋テキスト（原文のまま・末尾は…で省略可） */
  text: string;
  /** 元投稿のURL */
  url: string;
  /** トーンラベル */
  tone: "good" | "bad" | "mixed";
}

interface Props {
  /** サイト名（例: X） */
  siteName: string;
  reactions: SnsReaction[];
}

const { siteName, reactions } = Astro.props;
const toneLabels: Record<SnsReaction["tone"], string> = {
  good: "良かったという声",
  bad: "気になったという声",
  mixed: "検討中・両方の声",
};
---

<div class="sns-reactions" data-sns-reactions>
  {reactions.map((reaction) => (
    <a
      class="sns-reaction"
      href={reaction.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${reaction.name}（${reaction.handle}）の${siteName}投稿を開く`}
    >
      <p class="sns-reaction__tone" data-tone={reaction.tone}>
        {toneLabels[reaction.tone]}
      </p>
      <p class="sns-reaction__text">{reaction.text}</p>
      <p class="sns-reaction__meta">
        {reaction.name} <span>{reaction.handle} · {siteName}</span>
      </p>
    </a>
  ))}
</div>

<style>
  .sns-reactions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1.25rem;
  }

  .sns-reaction {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .sns-reaction:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
  }

  .sns-reaction__tone {
    align-self: flex-start;
    margin: 0;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .sns-reaction__tone[data-tone="good"] {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .sns-reaction__tone[data-tone="mixed"] {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--ink);
    opacity: 0.8;
  }

  .sns-reaction__tone[data-tone="bad"] {
    background: color-mix(in srgb, #c0392b 10%, transparent);
    color: #c0392b;
  }

  .sns-reaction__text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sns-reaction__meta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink);
    opacity: 0.65;
  }

  .sns-reaction__meta span {
    display: block;
    font-size: 0.72rem;
  }

  @media (max-width: 640px) {
    .sns-reactions {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// PurchaseCard.astro
// 全記事の標準購入カード（Article Layout v3: docs/article-layout-v3-2026-08.md）
// 配置: 記事末尾（article-end）。比較記事の結論直後は NextStepBlock が担当。
// 要素: 商品画像 / 商品名 / 「こんな人向け」の1文 / 販売先確認CTA / 価格・在庫の注意書き
// 配置・枚数の機械的契約は config/article-layout.mjs が唯一の定義。
import { Picture } from 'astro:assets';
import AffiliateButton from './AffiliateButton.astro';
import {ARTICLE_LAYOUT} from '../../config/article-layout.mjs';
import {resolveImage} from '../lib/image-resolver';

interface Props {
  name: string;
  audience: string;
  href?: string;
  productId?: string;
  imagePath?: string;
  placement?: string;
  note?: string;
  searchQuery?: string;
  requiredTerms?: readonly string[];
  imageUrl?: string;
  /**
   * 購入リンクの検証状態。fail-closed 契約: verified のときだけ CTA を表示する。
   * 未指定（undefined）は検証状態不明として扱い、unverified 同等の
   * 「購入先の確認中です」メッセージを出す（CTA は非表示）。
   */
  purchaseLinkStatus: "verified" | "unverified" | "unavailable";
}

const {
  name,
  audience,
  href,
  productId,
  imagePath,
  placement = ARTICLE_LAYOUT.defaultPlacement,
  note,
  searchQuery,
  requiredTerms,
  imageUrl,
  purchaseLinkStatus,
} = Astro.props;

// fail-closed: 明示的に verified のときだけ CTA を出す。undefined は「確認中」扱い。
const isVerified = purchaseLinkStatus === "verified";
const amazonAssociateTag = import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG?.trim();
const amazonSearchUrl = amazonAssociateTag
  ? `https://www.amazon.co.jp/s?k=${encodeURIComponent(name)}&tag=${encodeURIComponent(amazonAssociateTag)}`
  : undefined;
const resolvedImage = resolveImage(imagePath);
---

<article class="purchase-card">
  <div class="purchase-card__main">
    {(imagePath || imageUrl) && (
      resolvedImage ? (
        <Picture class="purchase-card__image" src={resolvedImage} alt="" width={96} height={96} loading="lazy" formats={["avif", "webp"]} />
      ) : (
        <img class="purchase-card__image" src={imagePath ?? imageUrl} alt="" width="96" height="96" loading="lazy" referrerpolicy="no-referrer" />
      )
    )}
    <div class="purchase-card__body">
      <h3 class="purchase-card__name">{name}</h3>
      <p class="purchase-card__audience">{audience}</p>
    </div>
  </div>
  {isVerified ? (
    <>
      <AffiliateButton
        href={href}
        productId={productId}
        label="楽天市場で型番を確認"
        subLabel="商品ページを確認する"
        imagePath={undefined}
        placement={placement}
        searchQuery={searchQuery}
        requiredTerms={requiredTerms}
      />
      {amazonSearchUrl && (
        <a
          class="cta cta-card amazon-purchase-link"
          href={amazonSearchUrl}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          data-amazon-cta="purchase"
        >
          Amazonで商品を確認 → <span class="ad-note">（広告）</span>
        </a>
      )}
    </>
  ) : (
    <p class="purchase-card__pending">
      購入先の確認中です。公開後に販売先リンクが表示されます。
    </p>
  )}
  {note && <p class="purchase-card__note">{note}</p>}
</article>

<style>
  .purchase-card__pending {
    color: var(--muted);
    font-size: 0.88rem;
    padding: 0.5rem 0;
  }
</style>

---
// 記事内の診断誘導CTA（比較記事の結論直後に配置する）
// href は診断カテゴリページ（/tools/product-finder/<slug>/）か、
// 診断カテゴリが存在しない記事では一覧（/tools/product-finder/）を渡す。
interface Props {
  /** 診断カテゴリページURL */
  href?: string;
  /** 誘導の見出し（省略時は標準文言） */
  heading?: string;
}

const {
  href = '/tools/product-finder/',
  heading = 'まだ迷っているなら',
} = Astro.props;
---

<section class="diagnosis-cta" aria-label="商品選択診断への誘導">
  <h2 class="diagnosis-cta__heading">{heading}</h2>
  <p class="diagnosis-cta__lead">
    あなたの使い方ならどちらが合う？30秒で診断
  </p>
  <a class="diagnosis-cta__button" href={href}>
    診断をはじめる
  </a>
  <p class="diagnosis-cta__note">
    判定はメーカー公式情報に基づきます。回答はブラウザ内だけで処理され、サーバーへ送信されません。
  </p>
</section>

<style>
  .diagnosis-cta {
    margin: 1.5rem 0 2.5rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--sage);
    padding: 1.25rem 1.5rem;
    display: grid;
    gap: 0.5rem;
  }
  .diagnosis-cta__heading {
    margin: 0;
    font-size: 1.15rem;
  }
  .diagnosis-cta__lead {
    margin: 0;
    font-weight: 700;
  }
  .diagnosis-cta__button {
    justify-self: start;
    min-height: 48px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    padding: 0.65rem 1.1rem;
    font-weight: 800;
    text-decoration: none;
  }
  .diagnosis-cta__button:hover {
    opacity: 0.9;
  }
  .diagnosis-cta__note {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

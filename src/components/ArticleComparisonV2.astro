---
import HeroComparison from './HeroComparison.astro';
import VisualKeyDifferences, { type KeyDiffRow } from './VisualKeyDifferences.astro';
import DecisionGuide from './DecisionGuide.astro';
import TrustLine from './TrustLine.astro';
import NextStepBlock from './NextStepBlock.astro';

interface Side {
  brand: string;
  line: string;
  tagline: string;
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  officialHref: string;
  guidePoints: string[];
  /** 購入（アフィリエイト）URL — NextStepBlock の「次にすること」ボタン用 */
  purchaseHref?: string;
  /** クリック計測用の商品ID（任意） */
  productId?: string;
}

interface Props {
  left: Side;
  right: Side;
  rows: KeyDiffRow[];
  checkedAt?: string;
  /** 診断カテゴリページURL（省略時は診断一覧） */
  diagnosisHref?: string;
}

const { left, right, rows, checkedAt, diagnosisHref } = Astro.props;
---
<section class="article-comparison-v2" aria-label="商品の比較">
  <HeroComparison eyebrow="30秒でわかる" left={left} right={right} />
  <VisualKeyDifferences
    leftLabel={`${left.brand} ${left.line}`}
    rightLabel={`${right.brand} ${right.line}`}
    items={rows}
  />
  <DecisionGuide
    left={{ brand: left.brand, line: left.line, points: left.guidePoints }}
    right={{ brand: right.brand, line: right.line, points: right.guidePoints }}
  />
  <NextStepBlock
    left={{ label: `${left.brand} ${left.line}`, href: left.purchaseHref, productId: left.productId }}
    right={{ label: `${right.brand} ${right.line}`, href: right.purchaseHref, productId: right.productId }}
    diagnosisHref={diagnosisHref}
  />
  <TrustLine checkedAt={checkedAt} />
</section>

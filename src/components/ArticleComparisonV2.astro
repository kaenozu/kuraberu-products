---
import HeroComparison from './HeroComparison.astro';
import VisualKeyDifferences, { type KeyDiffRow } from './VisualKeyDifferences.astro';
import TrustLine from './TrustLine.astro';
import NextStepBlock from './NextStepBlock.astro';

interface Side {
  brand: string;
  line: string;
  tagline: string;
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  officialHref: string;
  guidePoints: string[];
  /** 購入（アフィリエイト）URL — NextStepBlock の「次にすること」ボタン用 */
  purchaseHref?: string;
  /** クリック計測用の商品ID（任意） */
  productId?: string;
}

interface Props {
  left: Side;
  right: Side;
  rows: KeyDiffRow[];
  checkedAt?: string;
  /** 診断カテゴリページURL（省略時は診断一覧） */
  diagnosisHref?: string;
  /** 「この一覧以外は両商品とも同じ」の注記（VisualKeyDifferences の commonNote へ渡す） */
  commonNote?: string;
  /** 購入リンクの検証状態。unverified 以上の CTA を非表示にする。 */
  purchaseLinkStatus?: "verified" | "unverified" | "unavailable";
}

const { left, right, rows, checkedAt, diagnosisHref, commonNote, purchaseLinkStatus } = Astro.props;
---
{/*
  記事比較の標準骨格（Article Layout v3、2026-08-18 更新）:
  1. 結局どっち？（30秒でわかる + こんな人におすすめ = HeroComparison + DecisionGuide を統合）
  2. 主な違い（VisualKeyDifferences — 記事の主役）
  3. 次にすること（NextStepBlock: A/B 購入 + 30秒診断）
  4. 信頼表示（TrustLine）
  ※ #decision-guide アンカーは統合ブロックが引き継ぎ、ページ内ジャンプを維持する。
*/}
<section class="article-comparison-v2" aria-label="商品の比較">
  <HeroComparison
    eyebrow="30秒でわかる"
    heading="結局どっち？"
    anchorId="decision-guide"
    left={left}
    right={right}
    leftPoints={left.guidePoints}
    rightPoints={right.guidePoints}
  />
  <VisualKeyDifferences
    leftLabel={`${left.brand} ${left.line}`}
    rightLabel={`${right.brand} ${right.line}`}
    items={rows}
    commonNote={commonNote}
  />
  <NextStepBlock
    left={{ label: `${left.brand} ${left.line}`, href: left.purchaseHref, productId: left.productId }}
    right={{ label: `${right.brand} ${right.line}`, href: right.purchaseHref, productId: right.productId }}
    diagnosisHref={diagnosisHref}
    purchaseLinkStatus={purchaseLinkStatus}
  />
  <TrustLine checkedAt={checkedAt} />
</section>

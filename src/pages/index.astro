---
import BaseLayout from '../layouts/BaseLayout.astro';
import {articleMetadata} from '../content/articles';

const latest = [...articleMetadata]
  .sort((a, b) => (a.modifiedAt < b.modifiedAt ? 1 : a.modifiedAt > b.modifiedAt ? -1 : 0))
  .slice(0, 6);
---

<BaseLayout
  title="くらべる商品メモ｜商品比較"
  description="暮らしの商品を、公式情報と確認状況を分けて比べるサイトです。確認できない数値や体験談は掲載しません。"
>
  <section class="wrap section section-intro">
    <p class="eyebrow">くらべる商品メモ</p>
    <h1>暮らしの商品を、くらべる。</h1>
    <p class="lead">公式情報と確認状況を分けて、商品の選択に役立つ情報を整理しています。</p>
  </section>

  <section class="section wrap article-index">
    <div class="article-list">
      {latest.length > 0 ? latest.map((article) => (
        <article class="card article-list-card">
          <span class="tag">{article.category}</span>
          <h2><a href={article.path}>{article.headline}</a></h2>
          <p>{article.summary}</p>
          <ul class="article-tags" aria-label="記事タグ">
            {article.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <p class="meta">更新日 <time datetime={article.modifiedAt}>{article.modifiedAt}</time></p>
          <div class="card-actions">
            <a class="cta" href={article.path}>記事を読む →</a>
          </div>
        </article>
      )) : (
        <p>比較記事は準備中です。</p>
      )}
    </div>
    <p class="meta">ほかにも記事は <a href="/articles/">比較記事一覧</a> から探せます。</p>
  </section>

  <section class="section section-rule"><div class="wrap editor-note"><p class="section-label">このサイトの見方</p><h2>判断材料を、盛らない。</h2><p>公式仕様、販売ページ、口コミ原文を分け、確認できない数字や体験談は「未確認」として残します。</p><a class="text-link" href="/about/">運営方針を見る →</a></div></section>
</BaseLayout>
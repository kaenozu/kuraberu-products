---
import BaseLayout from '../layouts/BaseLayout.astro';
import {articleMetadata} from '../content/articles';

const latest = [...articleMetadata]
  .sort((a, b) => (a.modifiedAt < b.modifiedAt ? 1 : a.modifiedAt > b.modifiedAt ? -1 : 0))
  .slice(0, 6);
---

<BaseLayout
  title="くらべる商品メモ｜商品比較"
  description="商品やサービスを、公式情報と確認状況を分けて比べるサイトです。確認できない数値や体験談は掲載しません。"
>
  <section class="wrap section section-intro">
    <p class="eyebrow">くらべる商品メモ</p>
    <h1>くらべて、選ぶ。</h1>
    <p class="lead">公式情報と確認状況を分けて、商品の選択に役立つ情報を整理しています。</p>
  </section>

  <section class="section wrap article-index">
    <div class="article-list">
      {latest.length > 0 ? latest.map((article) => (
        <article class={`card article-list-card${article.imagePath ? ' has-image' : ''}`}>
          {article.imagePath && (
            <img class="card-thumb" src={article.imagePath} alt={article.headline} width="132" height="132" loading="lazy" />
          )}
          <div class="card-body">
            <span class="card-tag-row">
              <span class="tag">{article.category}</span>
            </span>
            <h2><a href={article.path}>{article.headline}</a></h2>
            <p class="card-desc">{article.summary}</p>
            <p class="meta">更新日 <time datetime={article.modifiedAt}>{article.modifiedAt}</time></p>
          </div>
        </article>
      )) : (
        <p>比較記事は準備中です。</p>
      )}
    </div>
    <p class="meta">ほかにも記事は <a href="/articles/">比較記事一覧</a> から探せます。</p>
  </section>

  <section class="section wrap article-index">
    <div class="subsection-heading">
      <p class="section-label">商品選択診断</p>
      <h2>迷ったら、30秒で診断</h2>
    </div>
    <p class="lead">「どちらも良さそうで決められない」とき、あなたの使い方に合う商品を診断します。判定はメーカー公式情報に基づくスコアリング方式です。</p>
    <div class="article-list">
      <article class="card article-list-card">
        <div class="card-body">
          <span class="card-tag-row">
            <span class="tag">授乳用品</span>
          </span>
          <h2><a href="/tools/product-finder/baby-bottle/">母乳実感 160ml/240ml・素材 選び方診断</a></h2>
          <p class="card-desc">ピジョン母乳実感（160ml/240ml × 耐熱ガラス/PPSU）から、あなたの使い方に合う1本を診断します。</p>
        </div>
      </article>
    </div>
    <p class="meta"><a href="/tools/product-finder/">商品選択診断の一覧を見る →</a></p>
  </section>

  <section class="section section-rule"><div class="wrap editor-note"><p class="section-label">このサイトの見方</p><h2>判断材料を、盛らない。</h2><p>メーカー公式の商品ページ・公式Q&Aで確認できる情報だけを分けて整理し、確認できない数字や体験談は掲載しません。</p><a class="text-link" href="/about/">運営方針を見る →</a></div></section>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { publicArticleMetadata } from '../content/articles';
import {ARTICLE_LAYOUT} from '../../config/article-layout.mjs';
import {diagnosisCategories} from '../data/diagnoses';

const latest = [...publicArticleMetadata]
  .sort((a, b) => (a.modifiedAt < b.modifiedAt ? 1 : a.modifiedAt > b.modifiedAt ? -1 : 0))
  .slice(0, 6);

// 「よく比較される商品」：config/article-layout.mjs の topPage.featuredPaths が
// 唯一の情報源（3〜6件）。パスは publicArticleMetadata に必ず存在する（ゲートが検証）。
const featured = ARTICLE_LAYOUT.topPage.featuredPaths
  .map((path) => publicArticleMetadata.find((article) => article.path === path))
  .filter((article) => article !== undefined);

// カテゴリ入口：記事数が topPage.categoryMinArticles 以上のカテゴリを表示。
// 件数が多い順 → 名前順。リンク先は /articles/category/…（カテゴリページの
// クライアント側フィルタが URL パラメータを読んで絞り込む）。
const categoryCounts = new Map<string, number>();
for (const article of publicArticleMetadata) {
  categoryCounts.set(article.category, (categoryCounts.get(article.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()]
  .filter(([, count]) => count >= ARTICLE_LAYOUT.topPage.categoryMinArticles)
  .sort(([aName, aCount], [bName, bCount]) =>
    bCount - aCount || (aName < bName ? -1 : aName > bName ? 1 : 0),
  );

const categoryEmoji: Record<string, string> = {
  '育児用品': '👶', 'キッチン家電': '🍳', '美容・健康': '✨',
  '生活家電': '🏠', 'PC周辺機器': '💻', 'キッチン用品': '🍽️',
  'オーディオ': '🎧', 'スマート機器': '📱', 'テレビ・映像': '📺',
  '生活雑貨': '🧺', '日用品': '🧴', 'チャイルドシート': '🚗',
  '衣類ケア': '👕', '美容家電': '💇', 'デスク用品': '📝',
  'バッグ': '👜', '旅行用品': '✈️', '寝具': '🛏️',
  '収納用品': '📦', 'キッチン・ごみ箱収納': '🗑️',
};
---

<BaseLayout
  title="くらべる商品メモ｜商品比較"
  description="商品やサービスを、公式情報と確認状況を分けて比べるサイトです。確認できない数値や体験談は掲載しません。"
>
  <section class="wrap section section-intro hero-section">
    <p class="eyebrow">くらべる商品メモ</p>
    <h1 class="hero-heading">くらべて、<br class="hero-br" />選ぶ。</h1>
    <p class="lead">似ていて迷う2商品を、違いと「<strong>どっち向き？</strong>」で比較します。<br />メーカー公式情報を中心に確認しています。</p>
    <form class="top-search" role="search" aria-label="比較記事を検索" data-top-search action="/articles/" method="get">
      <input type="search" name="q" maxlength="100" autocomplete="off" placeholder="商品名・用途・悩みで検索（例: 電気ケトル、軽い）" aria-label="商品名・用途・悩みで検索" />
      <button type="submit" class="secondary-button">検索</button>
    </form>
    <p class="meta diagnosis-hero-cta">
      迷ったら
      <a class="diagnosis-hero-cta__button" href="/tools/product-finder/">30秒で診断する →</a>
    </p>
  </section>

  <section class="wrap section section-diagnosis" data-top-diagnosis>
    <div class="subsection-heading">
      <p class="section-label">商品選択診断</p>
      <h2>迷ったら、30秒で診断</h2>
    </div>
    <p class="lead">「どちらも良さそうで決められない」とき、あなたの使い方に合う商品を診断します。判定はメーカー公式情報に基づくスコアリング方式です。</p>
    <div class="diagnosis-grid">
      {diagnosisCategories.map((category) => (
        <a class="diagnosis-card" href={`/tools/product-finder/${category.slug}/`}>
          <span class="tag">{category.config.categoryLabel}</span>
          <span class="diagnosis-card__title">{category.config.title}</span>
          <span class="diagnosis-card__desc">{category.config.description}</span>
          <span class="diagnosis-card__cta">診断する →</span>
        </a>
      ))}
    </div>
    <p class="diagnosis-actions">
      <a class="primary-button" href="/tools/product-finder/">30秒で診断する →</a>
      <a class="secondary-button" href="/tools/product-finder/">商品選択診断の一覧を見る</a>
    </p>
  </section>

  <section class="wrap section" data-top-categories>
    <div class="subsection-heading">
      <p class="section-label">カテゴリから探す</p>
      <h2>カテゴリで探す</h2>
    </div>
    <p class="lead">比較したいジャンルから記事を探せます。</p>
    <ul class="category-list">
      {categories.map(([category, count]) => (
        <li>
          <a class="card-link" href={`/articles/category/${encodeURIComponent(category)}/`}>
            <span class="category-list__name">{categoryEmoji[category] || "📦"} {category}</span>
            <span class="category-list__count">{count}件</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="meta">全カテゴリは <a href="/articles/">比較記事一覧</a> から探せます。</p>
  </section>

  <section class="wrap section" data-top-featured>
    <div class="subsection-heading">
      <p class="section-label">よく比較される商品</p>
      <h2>よく比較される商品</h2>
    </div>
    <p class="lead">よく選ばれている比較を、公式情報の確認状況と合わせてまとめています。</p>
    <div class="article-list">
      {featured.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
  <p class="meta wrap"><a href="/articles/">もっと見る →</a></p>

  <section class="section wrap article-index" data-top-latest>
    <div class="subsection-heading">
      <p class="section-label">最近の比較</p>
      <h2>最近追加・更新した比較</h2>
    </div>
    <p class="lead">新しく追加・更新した比較からチェックできます。</p>
    <div class="article-list">
      {latest.length > 0 ? latest.map((article) => (
        <ArticleCard article={article} />
      )) : (
        <p>比較記事は準備中です。</p>
      )}
    </div>
    <p class="meta"><a href="/articles/">もっと見る →</a></p>
  </section>

  <section class="section section-rule"><div class="wrap editor-note"><p class="section-label">このサイトの見方</p><h2>判断材料を、盛らない。</h2><p>メーカー公式の商品ページ・公式Q&Aで確認できる情報だけを分けて整理し、確認できない数字や体験談は掲載しません。</p><a class="text-link" href="/about/">運営方針を見る →</a></div></section>
</BaseLayout>

<style is:global>
  /* ヒーローセクション */
  .hero-section {
    background: var(--hero-gradient);
    margin-inline: -100vw;
    padding-inline: 100vw;
    position: relative;
    overflow: hidden;
  }
  .hero-section::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(176, 76, 59, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-heading {
    font-size: clamp(3rem, 8vw, 5.5rem) !important;
    line-height: 1.05 !important;
    letter-spacing: -0.06em !important;
    margin-bottom: 1rem !important;
  }
  .hero-heading strong {
    color: var(--accent);
  }
  .hero-br {
    display: none;
  }
  @media (min-width: 560px) {
    .hero-br { display: block; }
  }

  /* ヒーロー直下の診断CTA（迷ったら…） */
  .diagnosis-hero-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .diagnosis-hero-cta__button {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-weight: 800;
    font-size: 0.88rem;
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .diagnosis-hero-cta__button:hover {
    filter: brightness(1.05);
  }

  /* 商品選択診断セクション（ヒーロー直後・カテゴリより前に配置） */
  .section-diagnosis {
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgba(176, 76, 59, 0.15);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #f3f6f4, #fbfcfb);
    box-shadow: 0 2px 16px rgba(176, 76, 59, 0.05);
  }
  .section-diagnosis .lead {
    margin-bottom: 1rem;
  }
  .diagnosis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.8rem;
  }
  .diagnosis-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .diagnosis-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 16px rgba(176, 76, 59, 0.1);
    transform: translateY(-2px);
  }
  .diagnosis-card__title {
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.4;
  }
  .diagnosis-card__desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .diagnosis-card__cta {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--accent);
  }
  .diagnosis-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin: 1.1rem 0 0;
  }
  .diagnosis-actions .primary-button,
  .diagnosis-actions .secondary-button {
    display: inline-block;
    text-decoration: none;
  }
  @media (max-width: 480px) {
    .diagnosis-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
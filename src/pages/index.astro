---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { publicArticleMetadata } from '../content/articles';
import {ARTICLE_LAYOUT} from '../../config/article-layout.mjs';

// 「注目の比較」：config/article-layout.mjs の topPage.featuredPaths が
// 唯一の情報源。実績データではなく編集部の手動選定なので、人気とは表現しない。
const featured = ARTICLE_LAYOUT.topPage.featuredPaths
  .map((path) => publicArticleMetadata.find((article) => article.path === path))
  .filter((article) => article !== undefined);

// 新着比較：公開日が新しい記事を自動表示する。手動選定の注目記事とは
// 役割を分け、新規記事を追加するだけでトップから辿れるようにする。
const latest = [...publicArticleMetadata]
  .sort(
    (a, b) =>
      b.publishedAt.localeCompare(a.publishedAt) ||
      b.modifiedAt.localeCompare(a.modifiedAt) ||
      a.path.localeCompare(b.path),
  )
  .slice(0, 6);

// カテゴリ入口：記事数が topPage.categoryMinArticles 以上のカテゴリを表示。
// 件数が多い順 → 名前順。リンク先は /articles/category/…（カテゴリページの
// クライアント側フィルタが URL パラメータを読んで絞り込む）。
const categoryCounts = new Map<string, number>();
for (const article of publicArticleMetadata) {
  categoryCounts.set(article.category, (categoryCounts.get(article.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()]
  .filter(([, count]) => count >= ARTICLE_LAYOUT.topPage.categoryMinArticles)
  .sort(([aName, aCount], [bName, bCount]) =>
    bCount - aCount || (aName < bName ? -1 : aName > bName ? 1 : 0),
  )
  .slice(0, 6);


---

<BaseLayout
  title="くらべる商品メモ｜商品比較"
  description="商品やサービスを、公式情報と確認状況を分けて比べるサイトです。確認できない数値や体験談は掲載しません。"
>
  <section class="wrap section section-intro hero-section">
    <p class="eyebrow">くらべる商品メモ</p>
    <h1 class="hero-heading">くらべて、<br class="hero-br" />選ぶ。</h1>
    <p class="lead">似ていて迷う2商品を、違いと「<strong>どっち向き？</strong>」で比較します。<br />メーカー公式情報を中心に確認しています。</p>
    <form class="top-search" role="search" aria-label="比較記事を検索" data-top-search action="/articles/" method="get">
      <input type="search" name="q" maxlength="100" autocomplete="off" placeholder="商品名・用途・悩みで検索（例: 電気ケトル、軽い）" aria-label="商品名・用途・悩みで検索" />
      <button type="submit" class="secondary-button">検索</button>
    </form>
  </section>

  <section class="wrap section" data-top-featured>
    <div class="subsection-heading">
      <p class="section-label">ピックアップ</p>
      <h2>注目の比較</h2>
    </div>
    <p class="lead">編集部が選んだ比較を、公式情報の確認状況と合わせて紹介します。</p>
    <div class="article-list top-article-list">
      {featured.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
  <p class="meta wrap"><a href="/articles/">もっと見る →</a></p>

  <section class="wrap section" data-top-latest>
    <div class="subsection-heading">
      <p class="section-label">新着比較</p>
      <h2>最近追加した記事</h2>
    </div>
    <p class="lead">新しく追加した比較記事を、公開日の新しい順に紹介します。</p>
    <div class="article-list top-article-list">
      {latest.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>

  <section class="wrap section" data-top-categories>
    <div class="subsection-heading">
      <p class="section-label">カテゴリ</p>
      <h2>カテゴリから探す</h2>
    </div>
    <p class="lead">比較したいジャンルから記事を探せます。</p>
    <ul class="category-list">
      {categories.map(([category, count]) => (
        <li>
          <a class="card-link" href={`/articles/category/${encodeURIComponent(category)}/`}>
            <span class="category-list__name">{category}</span>
            <span class="category-list__count">{count}件</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="meta">全カテゴリは <a href="/articles/">比較記事一覧</a> から探せます。</p>
  </section>

  <section class="wrap section section-diagnosis" data-top-diagnosis>
    <div class="subsection-heading">
      <p class="section-label">商品診断</p>
      <h2>迷っているなら、30秒で診断</h2>
    </div>
    <p class="lead">使い方に合う商品が分からない人向け。メーカー公式情報に基づいて、選び方を整理します。</p>
    <p class="diagnosis-actions"><a class="primary-button" href="/tools/product-finder/">商品選択診断を始める →</a></p>
  </section>

  <section class="section section-rule"><div class="wrap editor-note"><p class="section-label">このサイトの見方</p><h2>判断材料を、盛らない。</h2><p>メーカー公式の商品ページ・公式Q&Aで確認できる情報だけを分けて整理し、確認できない数字や体験談は掲載しません。</p><a class="text-link" href="/about/">運営方針を見る →</a></div></section>
</BaseLayout>

<style is:global>
  .hero-heading {
    max-width: 14ch;
    margin-bottom: 1rem;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .hero-br { display: none; }
  @media (min-width: 560px) { .hero-br { display: block; } }

  .section-diagnosis {
    border-block: 1px solid var(--line);
    background: var(--section-alt);
  }

  .diagnosis-actions { margin: 1rem 0 0; }
  .diagnosis-actions .primary-button {
    display: inline-block;
    text-decoration: none;
  }

  .top-article-list {
    gap: 0.75rem;
  }

  /* セクション見出しを、左寄せのカード列（max-width: 900px）に揃える。 */
  [data-top-featured] .subsection-heading,
  [data-top-categories] .subsection-heading,
  [data-top-diagnosis] .subsection-heading {
    max-width: 900px;
  }

  [data-top-featured] .subsection-heading h2,
  [data-top-categories] .subsection-heading h2,
  [data-top-diagnosis] .subsection-heading h2 {
    margin-bottom: 0.75rem;
  }

  .top-article-list .article-list-card {
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 0.85rem;
    padding: 0.65rem;
  }

  .top-article-list .article-list-card .card-thumb,
  .top-article-list .article-list-card .card-tile {
    width: 88px;
    height: 88px;
  }

  .top-article-list .article-list-card h2 {
    margin: 0.15rem 0 0.35rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.35;
  }

  .top-article-list .article-list-card .card-tag-row {
    display: none;
  }

  .top-article-list .article-list-card .card-subjects {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .top-article-list .article-list-card .card-audiences {
    display: none;
  }

  @media (max-width: 480px) {
    .top-article-list .article-list-card {
      grid-template-columns: 72px minmax(0, 1fr);
    }
    .top-article-list .article-list-card .card-thumb,
    .top-article-list .article-list-card .card-tile {
      width: 72px;
      height: 72px;
    }
  }
</style>
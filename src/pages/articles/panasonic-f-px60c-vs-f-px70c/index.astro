---
import { articlePurchaseLinks } from '../../../lib/products'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import RelatedArticles from '../../../components/RelatedArticles.astro'
import PurchaseCard from '../../../components/PurchaseCard.astro'
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro'
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro'
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro'
import {panasonicAirCleanerArticle as articleMetadata} from '../../../content/articles'
import type {KeyDiffRow} from '../../../components/VisualKeyDifferences.astro'

const leftOfficial = 'https://panasonic.jp/airrich/products/F-PX60C.html'
const leftSpec = 'https://panasonic.jp/airrich/products/F-PX60C/spec.html'
const rightOfficial = 'https://panasonic.jp/airrich/products/F-PX70C.html'
const rightSpec = 'https://panasonic.jp/airrich/products/F-PX70C/spec.html'
const leftImage = '/products/panasonic-f-px60c.png'
const rightImage = '/products/panasonic-f-px70c.png'
const leftAudience = '卓上・床置きの両方で使い、幅34cmの置き場所を確保できる人向け'
const rightAudience = '設置幅を抑えながら、31畳までの適用床面積を重視する人向け'
const faqEntries = [
  {question: 'F-PX60CとF-PX70Cの大きな違いは？', answer: '公式仕様では、適用床面積の目安・8畳の清浄時間・外形寸法・風量・集じんフィルター交換時期などが異なります。'},
  {question: '設置幅が小さいのはどちら？', answer: 'F-PX70Cの外形寸法は高さ552×幅125×奥行380mm、F-PX60Cは高さ550×幅340×奥行208mmです。幅だけでなく、奥行きも設置場所に合わせて確認してください。'},
  {question: '8畳の清浄時間はどちらが短い？', answer: '公式仕様ではF-PX60Cが約11分、F-PX70Cが約10分です。'},
  {question: '楽天市場の価格は比較できる？', answer: '価格・在庫・ポイント・送料は変動するため、型番検索ページで購入時点の表示を確認してください。'},
]
const keyDiffRows: KeyDiffRow[] = [
  {label: '適用床面積の目安（旧基準）', left: '27畳（45㎡）', right: '31畳（51㎡）', highlight: 'right'},
  {label: '8畳の清浄時間', left: '約11分', right: '約10分', highlight: 'right', highlightNote: '約1分短い'},
  {label: '外形寸法（高さ×幅×奥行）', left: '550×340×208mm', right: '552×125×380mm', highlight: 'right', highlightNote: '幅が小さい'},
  {label: '本体重量', left: '5.9kg', right: '5.1kg', highlight: 'right', highlightNote: '0.8kg軽い'},
  {label: '集じんフィルター交換', left: '約10年', right: '約3.5年', highlight: 'left'},
]
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 生活家電 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">パナソニックのF-PX60CとF-PX70Cを、公式ページで確認できる適用床面積・清浄時間・設置寸法・重量・運転音・消費電力で比較します。価格は販売先でご確認ください。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ"><a href="#key-differences">違い</a><a href="#decision-guide">どっち向き？</a><a href="#faq">FAQ</a></nav>
    <ArticleComparisonV2
      left={{brand: 'パナソニック', line: 'F-PX60C', tagline: '奥行きを抑えるなら', image: leftImage, imageAlt: 'パナソニック 空気清浄機 F-PX60C', officialHref: leftOfficial, guidePoints: [leftAudience], purchaseHref: articlePurchaseLinks['panasonic-f-px60c-vs-f-px70c:left'].purchaseUrl}}
      right={{brand: 'パナソニック', line: 'F-PX70C', tagline: '幅を抑えて広く使うなら', image: rightImage, imageAlt: 'パナソニック 空気清浄機 F-PX70C', officialHref: rightOfficial, guidePoints: [rightAudience], purchaseHref: articlePurchaseLinks['panasonic-f-px60c-vs-f-px70c:right'].purchaseUrl}}
      rows={keyDiffRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
    />
    <p>奥行きを抑えたいならF-PX60C、設置幅を抑えつつ適用床面積や清浄時間を重視するならF-PX70Cが候補です。寸法は高さ・幅・奥行の向きが異なるため、設置場所の実寸と照らして選びます。</p>

    <details class="fold-section" id="specs" open><summary>詳細仕様（公式ページで確認した項目）</summary><details class="source-toggle"><summary>根拠・確認先を表示</summary></details><div class="table-scroll"><table class="comparison"><thead><tr><th scope="col">比較項目</th><th scope="col">F-PX60C</th><th scope="col">F-PX70C</th><th scope="col">根拠</th></tr></thead><tbody>
      <tr><th scope="row">適用床面積の目安（旧基準）</th><td>27畳（45㎡）</td><td>31畳（51㎡）</td><td><a href={leftSpec} target="_blank" rel="noopener noreferrer">F-PX60C仕様</a> / <a href={rightSpec} target="_blank" rel="noopener noreferrer">F-PX70C仕様</a></td></tr>
      <tr><th scope="row">外形寸法（高さ×幅×奥行）</th><td>550×340×208mm</td><td>552×125×380mm</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">質量</th><td>5.9kg</td><td>5.1kg</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">8畳の清浄時間</th><td>約11分</td><td>約10分</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">風量（強・中・静音）</th><td>6.0・2.7・0.9㎥/分</td><td>7.0・2.6・1.3㎥/分</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">運転音（強・中・静音）</th><td>52・35・18dB</td><td>55・33・20dB</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">消費電力（強・中・静音）</th><td>45.0・10.0・5.0W</td><td>57.0・7.5・4.0W</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">集じんフィルター交換</th><td>約10年</td><td>約3.5年</td><td>各公式仕様ページ</td></tr>
    </tbody></table></div><p class="meta">価格・在庫・仕様は変更される可能性があります。購入時点の公式ページと販売ページを確認してください。</p></details>
    <h2 id="official">公式情報</h2><p>比較の根拠は、パナソニック公式の商品ページと仕様ページで確認した情報です。公式情報確認済み：{articleMetadata.productInfoCheckedAt}。</p>
    <div class="source-links"><a class="card-link" href={leftOfficial} target="_blank" rel="noopener noreferrer">F-PX60C 公式商品ページ →</a><a class="card-link" href={rightOfficial} target="_blank" rel="noopener noreferrer">F-PX70C 公式商品ページ →</a></div>
    <ArticleSocialProof query="パナソニック F-PX60C F-PX70C" checkedAt="2026-08-18" hasPosts={false} />
    <h2 id="faq">よくある質問</h2><div class="faq-list">{faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}</div>
    <h2>購入時の注意</h2><p>設置場所の幅・奥行・高さ、適用床面積、清浄時間、フィルター交換時期を購入前に確認してください。価格・在庫・ポイント・送料は販売先で変わります。</p>

    <div class="purchase-cards">
      <PurchaseCard name="パナソニック F-PX60C" audience={leftAudience} href={articlePurchaseLinks['panasonic-f-px60c-vs-f-px70c:left'].purchaseUrl} imagePath={leftImage} placement="article-end" note="価格・在庫は販売先でご確認ください。" />
      <PurchaseCard name="パナソニック F-PX70C" audience={rightAudience} href={articlePurchaseLinks['panasonic-f-px60c-vs-f-px70c:right'].purchaseUrl} imagePath={rightImage} placement="article-end" note="価格・在庫は販売先でご確認ください。" />
    </div>
    <h2>更新履歴</h2><ol class="change-log">{articleMetadata.changeLog.map((entry) => <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>)}</ol>
    <h2>情報源一覧</h2><ul class="source-list"><li><a href={leftOfficial} target="_blank" rel="noopener noreferrer">パナソニック F-PX60C 公式商品ページ</a> / <a href={leftSpec} target="_blank" rel="noopener noreferrer">仕様</a>（2026-08-18確認）</li><li><a href={rightOfficial} target="_blank" rel="noopener noreferrer">パナソニック F-PX70C 公式商品ページ</a> / <a href={rightSpec} target="_blank" rel="noopener noreferrer">仕様</a>（2026-08-18確認）</li></ul>
    <h2>調査方法・免責事項</h2><p>この比較は、パナソニック公式の商品ページと仕様ページで確認できる情報を根拠にしています。SNSの感想は比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

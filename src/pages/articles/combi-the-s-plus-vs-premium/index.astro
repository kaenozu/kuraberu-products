---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import {combiTheSArticle as articleMetadata} from '../../../content/articles';
import type {KeyDiffRow} from '../../../components/VisualKeyDifferences.astro';

const plusOfficial = 'https://www.combi.co.jp/store/carseat/thesplus/g/g120066/';
const premiumOfficial = 'https://www.combi.co.jp/store/carseat/thespremium/g/g118991/';
const plusSearch = 'https://a.r10.to/hgk4Rg';
const premiumSearch = 'https://a.r10.to/hPmZEE';

const plus = {
  brand: 'コンビ',
  line: 'THE S plus',
  image: '/products/the-s-plus.jpg',
  imageAlt: 'コンビ THE S plus チャイルドシート',
  audience: '4才頃までの基本ユースを重視し、価格を抑えたい人の候補',
  official: plusOfficial,
};
const premium = {
  brand: 'コンビ',
  line: 'THE S premium',
  image: '/products/the-s-premium.jpg',
  imageAlt: 'コンビ THE S premium チャイルドシート',
  audience: 'ジュニアモードまで1台で長く使いたい人の候補',
  official: premiumOfficial,
};

const faqEntries = [
  {
    question: 'THE S plus と THE S premium の違いは？',
    answer: '公式ページで確認できる大きな違いは、使用できる身長範囲です。THE S plus は身長40〜105cmまで、THE S premium は身長40〜125cmまで。premiumはジュニアモードを備え、7才頃までの使用を案内しています。重量と価格も異なります。',
  },
  {
    question: '長く使えるのはどっち？',
    answer: 'コンビ公式の案内では、THE S plusは新生児〜4才頃・身長40〜105cmまで、THE S premiumは新生児〜7才頃・身長40〜125cmまでです。長く使える期間を優先するなら、premiumが候補になります。実際の使用可否は子どもの身長・体重と取扱説明書を確認してください。',
  },
  {
    question: '回転や取り付け方法に違いはある？',
    answer: '今回確認した公式商品ページでは、どちらもISOFIX固定とサポートレッグを使い、360度回転するタイプとして案内されています。車種への適合や取り付け位置は、購入前に公式の車種適合表で確認してください。',
  },
  {
    question: '価格はいくら？',
    answer: '公式ページの表示価格は、THE S plusが88,000円、THE S premiumが95,700円です。販売店の価格・在庫・ポイント・送料は変動するため、購入時点の販売ページで確認してください。',
  },
];

const keyDiffRows: KeyDiffRow[] = [
  {label: '使用期間の目安', left: '新生児〜4才頃・身長40〜105cm', right: '新生児〜7才頃・身長40〜125cm', highlight: 'right', highlightNote: '長く使える', bar: {left: 105, right: 125}},
  {label: 'ジュニアモード', left: '公式ページで案内なし', right: '前向き・身長100〜125cm', highlight: 'right', highlightNote: 'ジュニアまで対応'},
  {label: '本体重量', left: '13.8kg', right: '14.1kg', highlight: 'left', highlightNote: '約300g軽い', bar: {left: 13.8, right: 14.1}},
  {label: '公式表示価格', left: '88,000円', right: '95,700円', highlight: 'left', highlightNote: '7,700円安い', bar: {left: 88000, right: 95700}},
  {label: '回転・固定', left: '360°回転・ISOFIX＋サポートレッグ', right: '360°回転・ISOFIX＋サポートレッグ'},
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / チャイルドシート · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">コンビのTHE S plusとTHE S premiumは、どちらも新生児から使える回転式チャイルドシートです。公式ページで確認できる使用身長、ジュニアモード、重量、価格、固定方法を分けて整理します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">どっち向き？</a>

      <a href="#faq">FAQ</a>
    </nav>
    <ArticleComparisonV2
      left={{brand: plus.brand, line: plus.line, tagline: '4才頃まで・価格を抑えるなら', image: plus.image, imageAlt: plus.imageAlt, officialHref: plus.official, guidePoints: [plus.audience]}}
      right={{brand: premium.brand, line: premium.line, tagline: '7才頃まで・長く使うなら', image: premium.image, imageAlt: premium.imageAlt, officialHref: premium.official, guidePoints: [premium.audience]}}
      rows={keyDiffRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
    />
    <p>どちらも新生児から使えるTHE Sシリーズですが、premiumは身長125cmまでのジュニアモードを備えています。plusは身長105cmまでで、重量と価格はplusの方が小さくなっています。</p>
    <div class="purchase-cards">
      <PurchaseCard name="コンビ THE S plus" audience={plus.audience} href={plusSearch} imagePath={plus.image} placement="after-decision" note="価格・在庫は販売先でご確認ください。" />
      <PurchaseCard name="コンビ THE S premium" audience={premium.audience} href={premiumSearch} imagePath={premium.image} placement="after-decision" note="価格・在庫は販売先でご確認ください。" />
    </div>
    <details class="fold-section" id="specs">
      <summary>詳細仕様（公式ページで確認した項目）</summary>
      <div class="table-scroll">
        <table class="comparison">
          <thead><tr><th scope="col">比較項目</th><th scope="col">THE S plus</th><th scope="col">THE S premium</th><th scope="col">根拠</th></tr></thead>
          <tbody>
            <tr><th scope="row">対象身長</th><td>40〜105cm</td><td>40〜125cm</td><td><a href={plusOfficial} target="_blank" rel="noopener noreferrer">plus公式</a> / <a href={premiumOfficial} target="_blank" rel="noopener noreferrer">premium公式</a></td></tr>
            <tr><th scope="row">参考年齢</th><td>新生児〜4才頃</td><td>新生児〜7才頃</td><td>各公式商品ページ</td></tr>
            <tr><th scope="row">本体重量</th><td>13.8kg</td><td>14.1kg</td><td>各公式商品ページ</td></tr>
            <tr><th scope="row">回転・固定</th><td>360°回転・ISOFIX＋サポートレッグ</td><td>360°回転・ISOFIX＋サポートレッグ</td><td>各公式商品ページ</td></tr>
            <tr><th scope="row">公式表示価格</th><td>88,000円</td><td>95,700円</td><td>各公式商品ページ</td></tr>
          </tbody>
        </table>
      </div>
      <p class="meta">価格・在庫・適合車種は変更される可能性があります。購入時点の公式ページと販売ページを確認してください。</p>
    </details>
    <h2 id="official">公式情報</h2>
    <p>THE S plusは、コンビ公式ストア限定モデルとして、新生児から4才頃・身長40〜105cmまでの使用を案内しています。THE S premiumは、新生児から7才頃・身長40〜125cmまでのロングユースモデルで、ジュニアモードを含む3モードを案内しています。どちらもISOFIX固定とサポートレッグ、360°回転を公式ページで確認できます。</p>
    <div class="source-links">
      <a class="card-link" href={plusOfficial} target="_blank" rel="noopener noreferrer">THE S plus 公式商品ページ →</a>
      <a class="card-link" href={premiumOfficial} target="_blank" rel="noopener noreferrer">THE S premium 公式商品ページ →</a>
    </div>
    <ArticleSocialProof query="コンビ THE S plus THE S premium チャイルドシート" checkedAt="2026-08-12" hasPosts={false} />
    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}
    </div>
    <h2>購入時の注意</h2>
    <p>チャイルドシートは、車種適合、取り付け位置、子どもの身長・体重、前向きへ切り替える条件を必ず公式の取扱説明書と適合表で確認してください。価格や在庫は販売先で変わります。</p>
    <h2>更新履歴</h2>
    <ol class="change-log">{articleMetadata.changeLog.map((entry) => <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>)}</ol>
    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={plusOfficial} target="_blank" rel="noopener noreferrer">コンビ THE S plus 公式商品ページ</a>（2026-08-12確認）</li>
      <li><a href={premiumOfficial} target="_blank" rel="noopener noreferrer">コンビ THE S premium 公式商品ページ</a>（2026-08-12確認）</li>
      <li><a href="https://www.combi.co.jp/products/childseat/" target="_blank" rel="noopener noreferrer">コンビ チャイルドシート一覧</a>（2026-08-12確認）</li>
    </ul>
    <h2>調査方法・免責事項</h2>
    <p>この比較は、コンビ公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

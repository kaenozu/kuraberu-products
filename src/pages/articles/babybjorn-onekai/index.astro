---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {babybjornOnekaiArticle as articleMetadata} from '../../../content/articles';
import {isContentStale} from '../../../lib/content-freshness';
import type {ComparisonCandidate, DifferenceRow} from '../../../lib/comparison';

const chartOfficial = 'https://www.rakuten.ne.jp/gold/babybjorn/comparison-chart-babycarriers';
const onekaiProductUrl = 'https://a.r10.to/hYhUfN';
const moveProductUrl = 'https://a.r10.to/h41WNP';
const onekaiRakutenUrl = onekaiProductUrl;;
const moveRakutenUrl = moveProductUrl;;

const faqEntries = [
  {
    "question": "ONE KAIとMOVE、どっちを選べばいい？",
    "answer": "ベビービョルン公式の比較表によると、ONE KAI は新生児から約36ヶ月まで使える4WAY（対面ハイ・ロー、前向き、おんぶ）のモデルで、赤ちゃんの身体に沿った3D構造と幅広ウエストベルトを備えています。MOVE は新生児から約15ヶ月までが対象の2WAYモデルで、フルメッシュ素材で通気性を重視しています。長く使えて多彩な抱き方をしたいなら ONE KAI、通気性の良さと軽やかさを重視するなら MOVE という違いがあります。実際の着け心地や赤ちゃんの好みは、公式情報だけでは判断できません。"
  },
  {
    "question": "ONE KAIは新生児から使える？",
    "answer": "公式の比較表では、ONE KAI の対象月齢は0カ月〜約36ヶ月、対象体重は3.5〜15kgと案内されています。ベビービョルン公式は「全ての抱っこひもが新生児から抱っこ可能」としています。"
  },
  {
    "question": "MOVEはどこまで使える？",
    "answer": "公式の比較表では、MOVE の対象月齢は0カ月〜約15ヶ月、対象体重は3.2〜12kg、対象ヒップサイズは約〜120cmと案内されています。MINI（約12ヶ月）より長く使えるちょうどよいモデルと位置づけられています。"
  },
  {
    "question": "ONE KAIとMOVEの価格はいくら？",
    "answer": "ベビービョルン公式楽天市場店の表示価格（2026-08-10確認）は、ONE KAI が27,500円、MOVE が22,000円です。在庫やキャンペーンにより変動するため、購入時点の販売ページで確認してください。"
  },
  {
    "question": "ONE KAIとMOVEの違いで一番大きいのは？",
    "answer": "公式の比較表では、使える期間（約36ヶ月 vs 約15ヶ月）と抱っこの種類（4WAY vs 2WAY）が大きな違いです。ONE KAI は幅広ウエストベルト付き（おんぶ時にもスマート）で4通りの抱っこができます。MOVE はショルダーパッド・ウェストベルトの項目が「ー」のスッキリ設計で、フルメッシュ素材です。"
  },
  {
    "question": "ONE KAIとMOVEの保証期間は？",
    "answer": "ベビービョルン公式は保証期間について「2年（正規保証1年＋ユーザー登録1年）」と案内しています。"
  }
];

const onekaiCandidate: ComparisonCandidate = {
  product: 'ベビービョルン ベビーキャリア ONE KAI',
  line: 'ONE KAI',
  tone: 'premium',
  audience: '新生児から長く使えて4WAYで多彩な抱き方をしたい人の候補',
  note: '新生児〜約36ヶ月・4WAY・3D構造・幅広ウエストベルト',
  status: 'official',
};

const moveCandidate: ComparisonCandidate = {
  product: 'ベビービョルン ベビーキャリア MOVE',
  line: 'MOVE',
  tone: 'standard',
  audience: '通気性を重視して長めに使いたい人の候補',
  note: '新生児〜約15ヶ月・2WAY・フルメッシュ素材',
  status: 'official',
};


const contentAsOf = new Date().toISOString().slice(0, 10);
const productInfoStale = isContentStale(articleMetadata.productInfoCheckedAt, contentAsOf);

const differenceRows: DifferenceRow[] = [
  {
    "label": "対象月齢・対象体重",
    "left": "0カ月〜約36ヶ月。体重3.5〜15kg、ヒップ約〜160cm。",
    "right": "0カ月〜約15ヶ月。体重3.2〜12kg、ヒップ約〜120cm。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "抱っこの種類",
    "left": "4通り：対面抱っこ（ハイポジション）・対面抱っこ（ローポジション）・前向き抱っこ・おんぶ。",
    "right": "2通り。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "ショルダーとウエストのサポート",
    "left": "パッド入りショルダーベルト（スッキリ見え・肩にぴったりフィット）＋幅広ウエストベルト（おんぶ時にもスマート）。",
    "right": "ショルダーパッド・ウェストベルトの項目は公式比較表で「ー」。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "素材",
    "left": "メッシュ・コットン。",
    "right": "メッシュ（フルメッシュ素材で通気性抜群）。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "製品重量",
    "left": "約1000g。",
    "right": "約860g。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "ヘッドサポート",
    "left": "○",
    "right": "○",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "保証期間",
    "left": "2年（正規保証1年＋ユーザー登録1年）。",
    "right": "2年（正規保証1年＋ユーザー登録1年）。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "公式ショップ価格（2026-08-10確認）",
    "left": "27,500円。",
    "right": "22,000円。",
    "leftStatus": "official",
    "rightStatus": "official"
  }
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 育児用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">ベビーキャリア ONE KAI とベビーキャリア MOVE は、どちらもベビービョルンの抱っこひもですが、使える期間、抱っこの種類、サポート、素材に違いがあります。この記事では、ベビービョルン公式の比較表・製品ページで2026年8月10日時点に確認できた情報だけを使って比較します。公式ページに記載されていることは「確認できること」として整理し、使用感や実際の着け心地など、公式情報だけでは判断できないことは推測しません。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">どっち向き？</a>

      <a href="#faq">FAQ</a>
    </nav>
    <div class="purchase-cards">
      <PurchaseCard
        name="ベビーキャリア ONE KAI"
        audience="新生児から約36ヶ月まで長く使えて、4通りの抱っこ（おんぶ含む）と幅広ウエストベルトを優先する人向け"
        href={onekaiRakutenUrl}
        productId="babybjorn-onekai"
        imagePath="/products/babybjorn-onekai.jpg"
        placement="after-decision"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="ベビーキャリア MOVE"
        audience="フルメッシュ素材の通気性と軽量設計（約860g）を優先する人向け"
        href={moveRakutenUrl}
        productId="babybjorn-move"
        imagePath="/products/babybjorn-move.jpg"
        placement="after-decision"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>
    <div class="verification-summary" aria-label="記事情報の確認状況">
      <p>商品情報確認日: <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time></p>
      {productInfoStale && <p class="notice">商品情報の確認から時間が経過しています。購入前に公式ページで最新仕様を確認してください。</p>}
    </div>
    <p class="notice">広告表示：この記事には広告リンクを含みます。価格・在庫は販売先で、仕様は公式ページで確認してください。</p>

    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2
      left={{ brand: onekaiCandidate.product, line: onekaiCandidate.line, tagline: onekaiCandidate.audience, image: '/products/babybjorn-onekai.jpg', imageAlt: `${onekaiCandidate.product} ${onekaiCandidate.line}`, officialHref: onekaiProductUrl, guidePoints: [onekaiCandidate.audience] }}
      right={{ brand: moveCandidate.product, line: moveCandidate.line, tagline: moveCandidate.audience, image: '/products/babybjorn-move.jpg', imageAlt: `${moveCandidate.product} ${moveCandidate.line}`, officialHref: moveProductUrl, guidePoints: [moveCandidate.audience] }}
      rows={differenceRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
    />



    <h2 id="official">公式情報</h2>
    <p>ここでは、ベビービョルン公式の比較表・製品ページで確認できた内容を整理します。使用感・実際の着け心地・赤ちゃんの反応など、公式情報だけでは確認できないことは書いていません。</p>
    <h3>ベビーキャリア ONE KAI で公式に確認できること</h3>
    <ul class="official-list">
      <li>対象月齢0カ月〜約36ヶ月、対象体重3.5〜15kg、対象ヒップサイズ約〜160cm（公式比較表）。</li>
      <li>4通りの抱っこが可能：対面抱っこ（ハイポジション）・対面抱っこ（ローポジション）・前向き抱っこ・おんぶ。</li>
      <li>赤ちゃんの身体に沿った3D構造でぴったり抱っこが可能。</li>
      <li>パッド入りショルダーベルト（スッキリ見え・肩にぴったりフィット）と幅広ウエストベルト（おんぶ時にもスマート）を備える。</li>
      <li>ヘッドサポートあり。素材はメッシュ・コットン。製品重量は約1000g。</li>
      <li>ベビービョルン公式は「全ての抱っこひもが新生児から抱っこ可能」と案内。</li>
      <li>保証期間は2年（正規保証1年＋ユーザー登録1年）。</li>
    </ul>
    <h3>ベビーキャリア MOVE で公式に確認できること</h3>
    <ul class="official-list">
      <li>対象月齢0カ月〜約15ヶ月、対象体重3.2〜12kg、対象ヒップサイズ約〜120cm（公式比較表）。</li>
      <li>2通りの抱っこが可能。</li>
      <li>フルメッシュ素材で通気性抜群と案内。MINI よりも長く使うことができる「ちょうどよい抱っこひも」と位置づけられている。</li>
      <li>ショルダーパッド・ウェストベルトの項目は公式比較表で「ー」（スッキリ設計）。</li>
      <li>ヘッドサポートあり。素材はメッシュ。製品重量は約860g。</li>
      <li>保証期間は2年（正規保証1年＋ユーザー登録1年）。</li>
    </ul>

    <ArticleSocialProof
      query="ベビービョルン ONE KAI MOVE"
      checkedAt="2026-08-12"
      hasPosts={false}
    />

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>この記事で記載した価格は、2026年8月10日時点で確認したベビービョルン公式楽天市場店の表示価格です。楽天市場など他のショップでは、販売価格、ポイント還元、送料、セット内容などが変わる場合があります。購入時は、商品名、カラー、付属品を販売ページで確認してください。また、抱っこひもの安全性と正しい使用方法は必ず公式の使用説明書で確認してください。</p>

    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog.slice().sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
      ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={chartOfficial} target="_blank" rel="noopener noreferrer">ベビーキャリア比較表（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={onekaiProductUrl} target="_blank" rel="noopener noreferrer">ベビーキャリア ONE KAI（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={moveProductUrl} target="_blank" rel="noopener noreferrer">ベビーキャリア MOVE（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
    </ul>
    <h2>調査方法・免責</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式の比較表で確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

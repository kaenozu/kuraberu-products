---
import { articlePurchaseLinks } from '../../../lib/products';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2Section from '../../../components/ArticleComparisonV2Section.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {babybjornOnekaiArticle as articleMetadata} from '../../../content/articles';
import {comparisonV2Articles} from '../../../content/articles/comparison-v2';

const comparison = comparisonV2Articles['babybjorn-onekai'];
const chartOfficial = 'https://www.rakuten.ne.jp/gold/babybjorn/comparison-chart-babycarriers';

const left = comparison.left;
const right = comparison.right;
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 育児用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">ベビービョルンの抱っこひも「ベビーキャリア ONE KAI」と「ベビーキャリア MOVE」を、公式の比較表・製品ページで確認できる内容で比較します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">結局どっち？</a>

      <a href="#faq">FAQ</a>
    </nav>

    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2Section articleId="babybjorn-onekai" />


    <details class="fold-section" id="official">
      <summary>公式情報（確認できた項目）</summary>
      <p>ここでは、ベビービョルン公式の比較表・製品ページで確認できた内容を整理します。使用感・実際の着け心地・赤ちゃんの反応など、公式情報だけでは確認できないことは書いていません。</p>
    <h3>ベビーキャリア ONE KAI で公式に確認できること</h3>
    <ul class="official-list">
      <li>対象月齢0カ月〜約36ヶ月、対象体重3.5〜15kg、対象ヒップサイズ約〜160cm（公式比較表）。</li>
      <li>4通りの抱っこが可能：対面抱っこ（ハイポジション）・対面抱っこ（ローポジション）・前向き抱っこ・おんぶ。</li>
      <li>赤ちゃんの身体に沿った3D構造でぴったり抱っこが可能。</li>
      <li>パッド入りショルダーベルト（スッキリ見え・肩にぴったりフィット）と幅広ウエストベルト（おんぶ時にもスマート）を備える。</li>
      <li>ヘッドサポートあり。素材はメッシュ・コットン。製品重量は約1000g。</li>
      <li>ベビービョルン公式は「全ての抱っこひもが新生児から抱っこ可能」と案内。</li>
      <li>保証期間は2年（正規保証1年＋ユーザー登録1年）。</li>
    </ul>
    <h3>ベビーキャリア MOVE で公式に確認できること</h3>
    <ul class="official-list">
      <li>対象月齢0カ月〜約15ヶ月、対象体重3.2〜12kg、対象ヒップサイズ約〜120cm（公式比較表）。</li>
      <li>2通りの抱っこが可能。</li>
      <li>フルメッシュ素材で通気性抜群と案内。MINI よりも長く使うことができる「ちょうどよい抱っこひも」と位置づけられている。</li>
      <li>ショルダーパッド・ウェストベルトの項目は公式比較表で「ー」（スッキリ設計）。</li>
      <li>ヘッドサポートあり。素材はメッシュ。製品重量は約860g。</li>
      <li>保証期間は2年（正規保証1年＋ユーザー登録1年）。</li>
    </ul>

    </details>
    <ArticleSocialProof
      query="ベビービョルン ONE KAI MOVE"
      checkedAt="2026-08-12"
      hasPosts={false}
    />

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {comparison.faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>この記事で記載した価格は、2026年8月10日時点で確認したベビービョルン公式楽天市場店の表示価格です。楽天市場など他のショップでは、販売価格、ポイント還元、送料、セット内容などが変わる場合があります。購入時は、商品名、カラー、付属品を販売ページで確認してください。また、抱っこひもの安全性と正しい使用方法は必ず公式の使用説明書で確認してください。</p>

    <div class="purchase-cards">
      <PurchaseCard
        name="ベビーキャリア ONE KAI"
        audience="新生児から約36ヶ月まで長く使えて、4通りの抱っこ（おんぶ含む）と幅広ウエストベルトを優先する人向け"
        href={articlePurchaseLinks['babybjorn-onekai:left'].purchaseUrl}
        productId="babybjorn-onekai"
        imagePath="/products/babybjorn-onekai.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="ベビーキャリア MOVE"
        audience="フルメッシュ素材の通気性と軽量設計（約860g）を優先する人向け"
        href={articlePurchaseLinks['babybjorn-onekai:right'].purchaseUrl}
        productId="babybjorn-move"
        imagePath="/products/babybjorn-move.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>
    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog.slice().sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
      ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={chartOfficial} target="_blank" rel="noopener noreferrer">ベビーキャリア比較表（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={left.officialHref} target="_blank" rel="noopener noreferrer">ベビーキャリア ONE KAI（ベビービョルン公式）</a>（2026-08-10確認）</li>
      <li><a href={right.officialHref} target="_blank" rel="noopener noreferrer">ベビーキャリア MOVE（ベビービョルン公式）</a>（2026-08-10確認）</li>
    </ul>
    <h2>調査方法・免責</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式の比較表で確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

---
import ArticleListPage from '../../../components/ArticleListPage.astro';
import { publicArticleMetadata } from '../../../content/articles';
import { ARTICLE_LIST_PAGE_SIZE, sortByModifiedAtDesc } from '../../../lib/article-list';

const categories = [...new Set(publicArticleMetadata.map((article) => article.category))].sort();
const tags = [...new Set(publicArticleMetadata.flatMap((article) => article.tags))].sort();
const sorted = sortByModifiedAtDesc(publicArticleMetadata);
const pageSize = ARTICLE_LIST_PAGE_SIZE;

export function getStaticPaths() {
  const pageSize = ARTICLE_LIST_PAGE_SIZE;
  const sortedArticles = sortByModifiedAtDesc(publicArticleMetadata);
  const totalPages = Math.ceil(sortedArticles.length / pageSize);
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: {page: String(currentPage)},
      props: {
        articles: sortedArticles.slice(index * pageSize + pageSize, index * pageSize + pageSize * 2),
        currentPage,
      },
    };
  });
}

const {articles, currentPage} = Astro.props;
const totalPagesForDisplay = Math.ceil(sorted.length / pageSize);
---
<ArticleListPage
  title={`比較記事一覧 ${currentPage}ページ目｜くらべる商品メモ`}
  description="メーカー公式の情報で商品を比べる記事一覧"
  heading="比較記事一覧"
  lead="確認できる公式情報と販売ページを起点に、商品を選ぶときの判断材料を整理しています。"
  articles={articles}
  totalCount={publicArticleMetadata.length}
  countNote={`（${currentPage}ページ目）`}
  categoryOptions={categories}
  tagOptions={tags}
  discoverySource={sorted}
  pagination={{ mode: 'paged', currentPage, totalPages: totalPagesForDisplay }}
/>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AffiliateButton from '../../../components/AffiliateButton.astro';
import ThirtySecondComparison from '../../../components/ThirtySecondComparison.astro';
import DifferenceList from '../../../components/DifferenceList.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import PriorityConclusion from '../../../components/PriorityConclusion.astro';
import {babybjornArticle as articleMetadata} from '../../../content/articles';
import {babybjornCandidateLabels, babybjornPriorityOptions, babybjornStandardConclusion} from '../../../content/babybjorn-priorities';
import {isContentStale} from '../../../lib/content-freshness';
import type {ComparisonCandidate, ComparisonRow, DifferenceRow} from '../../../lib/comparison';

const harmonyOfficial = 'https://www.rakuten.ne.jp/gold/babybjorn/comparison-chart-babycarriers';
const harmonyProductUrl = 'https://item.rakuten.co.jp/babybjorn/baby-carrier-harmony/';
const miniProductUrl = 'https://item.rakuten.co.jp/babybjorn/baby-carrier-mini-3d/';
const harmonyRakutenUrl = import.meta.env.PUBLIC_RAKUTEN_BABYBJORN_HARMONY_URL;
const miniRakutenUrl = import.meta.env.PUBLIC_RAKUTEN_BABYBJORN_MINI_URL;
const harmonySearch = 'https://search.rakuten.co.jp/search/mall/%E3%83%99%E3%83%93%E3%83%BC%E3%82%AD%E3%83%A3%E3%83%AA%E3%82%A2%20HARMONY%20%E3%83%99%E3%83%93%E3%83%BC%E3%83%93%E3%83%A7%E3%83%AB%E3%83%B3/';
const miniSearch = 'https://search.rakuten.co.jp/search/mall/%E3%83%99%E3%83%93%E3%83%BC%E3%82%AD%E3%83%A3%E3%83%AA%E3%82%A2%20MINI%20%E3%83%99%E3%83%93%E3%83%BC%E3%83%93%E3%83%A7%E3%83%AB%E3%83%B3/';

const faqEntries = [
  {
    "question": "HARMONYとMINI、どっちを選べばいい？",
    "answer": "ベビービョルン公式の比較表によると、HARMONY は新生児から約36ヶ月まで使える4WAY（対面ハイ・ロー、前向き、おんぶ）のモデルで、幅広なパッド入りショルダーベルトとランバーサポート付きウェストベルトを備えています。MINI は新生児から約12ヶ月までが対象で、ショルダーベルトと本体が別々のシンプル設計でウェストベルトがありません。長く使える機能性を重視するなら HARMONY、新生児期の手軽さと価格を重視するなら MINI という違いがあります。実際の着け心地や赤ちゃんの好みは、公式情報だけでは判断できません。"
  },
  {
    "question": "HARMONYは新生児から使える？",
    "answer": "公式の比較表では、HARMONY の対象月齢は0カ月〜約36ヶ月、対象体重は3.2〜15kgと案内されています。ベビービョルン公式は「全ての抱っこひもが新生児から抱っこ可能」としています。"
  },
  {
    "question": "MINIはどこまで使える？",
    "answer": "公式の比較表では、MINI の対象月齢は0カ月〜約12ヶ月、対象体重は3.2〜11kg、対象ヒップサイズは約〜120cmと案内されています。新生児・乳児期中心のモデルです。"
  },
  {
    "question": "HARMONYとMINIの価格はいくら？",
    "answer": "ベビービョルン公式楽天市場店の表示価格（2026-08-10確認）は、HARMONY が27,280円〜、MINI が9,680円〜です。在庫やキャンペーンにより変動するため、購入時点の販売ページで確認してください。"
  },
  {
    "question": "MINIにウェストベルトはある？",
    "answer": "ありません。MINI はショルダーベルトと本体が別々のシンプル設計で、公式の比較表でもウェストベルトの項目は「ー」となっています。HARMONY はエルゴノミックランバーサポート付きの幅広ウェストベルトを備え、腰に荷重を分散して肩の負担を軽減すると案内されています。"
  },
  {
    "question": "HARMONYとMINIの保証期間は？",
    "answer": "ベビービョルン公式は保証期間について「2年（正規保証1年＋ユーザー登録1年）」と案内しています。"
  }
];

const harmonyCandidate: ComparisonCandidate = {
  product: 'ベビービョルン ベビーキャリア HARMONY',
  line: 'HARMONY',
  tone: 'premium',
  audience: '新生児から長く使えて多彩な抱き方をしたい人の候補',
  note: '新生児〜約36ヶ月・4WAY・幅広クッション付き',
  status: 'official',
};

const miniCandidate: ComparisonCandidate = {
  product: 'ベビービョルン ベビーキャリア MINI',
  line: 'MINI',
  tone: 'standard',
  audience: '新生児期の手軽さと価格を優先したい人の候補',
  note: '新生児〜約12ヶ月・2WAY・シンプル軽量設計',
  status: 'official',
};

const summaryRows: ComparisonRow[] = [
  {
    "label": "対象月齢・対象体重",
    "left": "公式比較表で0カ月〜約36ヶ月、体重3.2〜15kg、ヒップ約〜160cm。",
    "right": "公式比較表で0カ月〜約12ヶ月、体重3.2〜11kg、ヒップ約〜120cm。"
  },
  {
    "label": "抱っこの種類とサポート",
    "left": "4通り（対面ハイ・対面ロー・前向き・おんぶ）。幅広パッド入りショルダーベルト＋エルゴノミックランバーサポート付き幅広ウエストベルトで肩と腰をサポート。",
    "right": "2通り。ショルダーベルトと本体が別々のシンプル設計で、立ったままでも抱き入れられる。ウエストベルトなし（公式比較表で「ー」）。"
  },
  {
    "label": "製品重量と公式ショップ価格（2026-08-10確認）",
    "left": "約892g。27,280円〜。",
    "right": "約500g。9,680円〜。"
  }
];

const contentAsOf = new Date().toISOString().slice(0, 10);
const productInfoStale = isContentStale(articleMetadata.productInfoCheckedAt, contentAsOf);
const purchaseLinkLabel = articleMetadata.purchaseLinksCheckedAt
  ? `最終確認 ${articleMetadata.purchaseLinksCheckedAt}`
  : '最終確認日は未記録';

const differenceRows: DifferenceRow[] = [
  {
    "label": "対象月齢・対象体重",
    "left": "0カ月〜約36ヶ月。体重3.2〜15kg、ヒップ約〜160cm。",
    "right": "0カ月〜約12ヶ月。体重3.2〜11kg、ヒップ約〜120cm。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "抱っこの種類",
    "left": "4通り：対面抱っこ（ハイポジション）・対面抱っこ（ローポジション）・前向き抱っこ・おんぶ。",
    "right": "2通り。対面と前向きを中心としたシンプル設計。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "肩と腰のサポート",
    "left": "幅広なパッド入りショルダーベルト＋エルゴノミックランバーサポート付き幅広ウエストベルト。腰に荷重を分散し肩の負担を軽減。",
    "right": "パッド入りショルダーベルト。ウエストベルトなし。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "製品重量",
    "left": "約892g。",
    "right": "約500g。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "素材",
    "left": "メッシュ・3Dジャージー。",
    "right": "コットン・メッシュ。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "保証期間",
    "left": "2年（正規保証1年＋ユーザー登録1年）。",
    "right": "2年（正規保証1年＋ユーザー登録1年）。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "公式ショップ価格（2026-08-10確認）",
    "left": "27,280円〜。",
    "right": "9,680円〜。",
    "leftStatus": "official",
    "rightStatus": "official"
  }
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 育児用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">ベビーキャリア HARMONY とベビーキャリア MINI は、どちらもベビービョルンの抱っこひもですが、使える期間、抱っこの種類、肩と腰のサポート、価格に大きな違いがあります。この記事では、ベビービョルン公式の比較表・製品ページで2026年8月10日時点に確認できた情報だけを使って比較します。公式ページに記載されていることは「確認できること」として整理し、使用感や実際の着け心地など、公式情報だけでは判断できないことは推測しません。</p>
    <nav class="toc" aria-label="目次">
      <h2>この記事の内容</h2>
      <ol>
        <li><a href="#comparison-details">2つの商品を比べる</a></li>
        <li><a href="#official">公式情報</a></li>
        <li><a href="#faq">よくある質問</a></li>
        <li><a href="#purchase">購入前に確認するページ</a></li>
      </ol>
    </nav>
    <div class="product-compare" aria-label="比較する2つの商品">
      <article class="product-card">
        <img src="/products/babybjorn-harmony.jpg" alt="ベビービョルン ベビーキャリア HARMONY" width="700" height="700" loading="eager" />
        <div class="product-card-body">
          <p class="product-card-line">ベビービョルン / HARMONY</p>
          <h2 class="product-card-name">ベビーキャリア HARMONY</h2>
          <p class="product-card-desc">新生児〜約36ヶ月。4通りの抱っこができる最上級モデル。幅広クッションで肩と腰をサポート。</p>
          <a class="product-card-link" href={harmonyProductUrl} target="_blank" rel="noopener noreferrer">公式ページで確認 →</a>
        </div>
      </article>
      <article class="product-card">
        <img src="/products/babybjorn-mini.jpg" alt="ベビービョルン ベビーキャリア MINI" width="700" height="700" loading="eager" />
        <div class="product-card-body">
          <span class="product-card-line">ベビービョルン / MINI</span>
          <h2 class="product-card-name">ベビーキャリア MINI</h2>
          <p class="product-card-desc">新生児〜約12ヶ月。ショルダーベルトと本体が別々で、立ったままでも抱き入れられるシンプル設計。</p>
          <a class="product-card-link" href={miniProductUrl} target="_blank" rel="noopener noreferrer">公式ページで確認 →</a>
        </div>
      </article>
    </div>
    <div class="verification-summary" aria-label="記事情報の確認状況">
      <p>商品情報確認日: <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time></p>
      <p>購入リンク: {purchaseLinkLabel}</p>
      {productInfoStale && <p class="notice">商品情報の確認から時間が経過しています。購入前に公式ページで最新仕様を確認してください。</p>}
    </div>
    <p class="notice">広告表示：この記事には広告リンクを含みます。価格・在庫は販売先で、仕様は公式ページで確認してください。</p>

    <ThirtySecondComparison
      idPrefix="babybjorn-summary"
      heading="まず、違いはこの3つ"
      conclusion="公式情報から整理すると、新生児から約36ヶ月まで4通りの抱っこ（おんぶ含む）で長く使える機能性を重視するなら HARMONY、新生児期〜乳児期の手軽さと価格を重視するなら MINI という違いがあります。HARMONY は幅広パッド入りショルダーベルトとランバーサポート付きウェストベルトで肩と腰をサポートし、公式ショップ価格27,280円〜（2026-08-10確認）。MINI はショルダーベルトと本体が別々で立ったまま抱き入れられ、ウエストベルトなしの軽量設計（約500g）、公式ショップ価格9,680円〜（同）。なお、どちらの着け心地が良いか、赤ちゃんが嫌がりにくいかといった使用感は、今回確認した公式情報だけでは比較できません。"
      left={harmonyCandidate}
      right={miniCandidate}
      rows={summaryRows}
      detailHref="#comparison-details"
    />

    <PriorityConclusion options={babybjornPriorityOptions} labels={babybjornCandidateLabels} standard={babybjornStandardConclusion} />


    <div id="comparison-details">
      <DifferenceList
        idPrefix="babybjorn-differences"
        leftLabel="HARMONY"
        rightLabel="MINI"
        items={differenceRows}
      />
    </div>

    <h2 id="official">公式情報</h2>
    <p>ここでは、ベビービョルン公式の比較表・製品ページで確認できた内容を整理します。使用感・実際の着け心地・赤ちゃんの反応など、公式情報だけでは確認できないことは書いていません。</p>
    <h3>ベビーキャリア HARMONY で公式に確認できること</h3>
    <ul class="official-list">
      <li>対象月齢0カ月〜約36ヶ月、対象体重3.2〜15kg、対象ヒップサイズ約〜160cm（公式比較表）。</li>
      <li>4通りの抱っこが可能：対面抱っこ（ハイポジション）・対面抱っこ（ローポジション）・前向き抱っこ・おんぶ。</li>
      <li>幅広なパッド入りショルダーベルトと、エルゴノミックランバーサポート付きの幅広ウエストベルトを備え、腰に荷重を分散して肩の負担を軽減。</li>
      <li>ヘッドサポートあり（裏地に柔らかい3Dジャージーを使用）。</li>
      <li>素材はメッシュと3Dジャージー。製品重量は約892g。</li>
      <li>ベビービョルン公式は「全ての抱っこひもが新生児から抱っこ可能」と案内。</li>
      <li>保護者向けの注意として、バックルは片手で簡単に着脱できる設計。保証期間は2年（正規保証1年＋ユーザー登録1年）。</li>
    </ul>
    <h3>ベビーキャリア MINI で公式に確認できること</h3>
    <ul class="official-list">
      <li>対象月齢0カ月〜約12ヶ月、対象体重3.2〜11kg、対象ヒップサイズ約〜120cm（公式比較表）。</li>
      <li>2通りの抱っこが可能（対面中心のシンプル設計）。</li>
      <li>ショルダーベルトと本体ピースが別々で、立ったままでも抱き入れることができ、新生児期・乳児期の何度もする抱っこにスムーズ。</li>
      <li>パッド入りショルダーベルト。ウエストベルトなし（公式比較表で「ー」）。</li>
      <li>ヘッドサポートあり。素材はコットンとメッシュ。製品重量は約500g。</li>
      <li>公式の紹介文では「シンプル設計でファースト抱っこひもにぴったり」と案内。</li>
      <li>保証期間は2年（正規保証1年＋ユーザー登録1年）。</li>
    </ul>

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2 id="purchase">購入前に確認するページ</h2>
    <div class="source-links">
      <a class="card-link" href={harmonySearch} target="_blank" rel="noopener noreferrer">HARMONY の販売ページを検索 →</a>
      <a class="card-link" href={miniSearch} target="_blank" rel="noopener noreferrer">MINI の販売ページを検索 →</a>
    </div>

    <h2>購入時の注意</h2>
    <p>この記事で記載した価格は、2026年8月10日時点で確認したベビービョルン公式楽天市場店の表示価格です。楽天市場など他のショップでは、販売価格、ポイント還元、送料、セット内容などが変わる場合があります。購入時は、商品名、カラー、付属品を販売ページで確認してください。また、抱っこひもの安全性と正しい使用方法は必ず公式の使用説明書で確認してください。</p>

    <div class="grid two">
      <AffiliateButton href={harmonyRakutenUrl} productId="babybjorn-harmony" imagePath="/products/babybjorn-harmony.jpg" label="ベビーキャリア HARMONYを楽天で見る" merchant="楽天" placement="article-end" />
      <AffiliateButton href={miniRakutenUrl} productId="babybjorn-mini" imagePath="/products/babybjorn-mini.jpg" label="ベビーキャリア MINIを楽天で見る" merchant="楽天" placement="article-end" />
    </div>

    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog.slice().sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
      ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={harmonyOfficial} target="_blank" rel="noopener noreferrer">ベビーキャリア比較表（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={harmonyProductUrl} target="_blank" rel="noopener noreferrer">ベビーキャリア HARMONY（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={miniProductUrl} target="_blank" rel="noopener noreferrer">ベビーキャリア MINI（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
    </ul>
    <h2>調査方法・免責</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式の比較表で確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
</BaseLayout>
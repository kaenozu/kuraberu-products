---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {pottyArticle as articleMetadata} from '../../../content/articles';
import {isContentStale} from '../../../lib/content-freshness';
import type {ComparisonCandidate, DifferenceRow} from '../../../lib/comparison';

const smartPottyProductUrl = 'https://item.rakuten.co.jp/babybjorn/smart-potty/';
const pottyChairProductUrl = 'https://item.rakuten.co.jp/babybjorn/potty-chair/';
const smartPottyRakutenUrl = import.meta.env.PUBLIC_RAKUTEN_BABYBJORN_SMART_POTTY_URL;
const pottyChairRakutenUrl = import.meta.env.PUBLIC_RAKUTEN_BABYBJORN_POTTY_CHAIR_URL;
const smartPottySearch = 'https://search.rakuten.co.jp/search/mall/%E3%83%99%E3%83%93%E3%83%BC%E3%83%93%E3%83%A7%E3%83%AB%E3%83%B3%20%E3%82%B9%E3%83%9E%E3%83%BC%E3%83%88%E3%83%9D%E3%83%83%E3%83%86%E3%82%A3/';
const pottyChairSearch = 'https://search.rakuten.co.jp/search/mall/%E3%83%99%E3%83%93%E3%83%BC%E3%83%93%E3%83%A7%E3%83%AB%E3%83%B3%20%E3%83%9D%E3%83%83%E3%83%86%E3%82%A3%E3%83%81%E3%82%A7%E3%82%A2/';

const faqEntries = [
  {
    "question": "スマートポッティとポッティチェア、どっちを選べばいい？",
    "answer": "ベビービョルン公式の案内によると、スマートポッティは「スペースの限られたバスルームに必要なデザインと機能をコンパクトにまとめた」収納式のポッティです。ポッティチェアは「お子さまが長い時間オマルに座る場合、イス型オマルが最適」と案内されています。使わない時にコンパクトに収納したい場合はスマートポッティ、長く座らせたい場合はポッティチェアが候補です。実際の使いやすさは、公式情報だけでは判断できません。"
  },
  {
    "question": "スマートポッティのサイズと重さは？",
    "answer": "ベビービョルン公式楽天市場店の案内によると、スマートポッティは幅約25.5×奥行き約32×高さ約17.5cm、製品重量は約520g、素材はポリプロピレンです。小さめサイズで足裏がしっかり床につく設計とされています。"
  },
  {
    "question": "ポッティチェアは何歳から使える？",
    "answer": "ベビービョルン公式の案内では、ポッティチェアはイス型オマルで、柔らかいフォルムの人間工学デザインとされています。対象年齢は公式の商品ページで確認してください。公式楽天市場店では、幅約32×奥行き約33×高さ約33cm・約870g・中桶付きと案内されています。"
  },
  {
    "question": "スマートポッティとポッティチェアの価格はいくら？",
    "answer": "2026-08-10時点の確認では、ベビービョルン公式楽天市場店でスマートポッティが3,080円、ポッティチェアが4,180円でした。在庫やキャンペーンにより変動するため、購入時点の販売ページで確認してください。"
  },
  {
    "question": "トイレトレーニングシート（補助便座）との違いは？",
    "answer": "ベビービョルン公式楽天市場店の案内によると、トイレトレーニングシートは2〜6才くらいまで使える便座直付けの補助便座（幅約29×奥行き約35×高さ約10cm・約400g・壁掛け用フック付き・ダイヤル調節機能）です。スマートポッティ・ポッティチェアは自立するおまるで、シートは大人用便座に取り付けて使うタイプと、使い方が異なります。"
  }
];

const smartPottyCandidate: ComparisonCandidate = {
  product: 'ベビービョルン スマートポッティ',
  line: 'スマートポッティ',
  tone: 'standard',
  audience: 'コンパクトに収納できるおまるを探す人の候補',
  note: '収納式・幅約25.5×32×17.5cm・約520g・ポリプロピレン',
  status: 'official',
};

const pottyChairCandidate: ComparisonCandidate = {
  product: 'ベビービョルン ポッティチェア',
  line: 'ポッティチェア',
  tone: 'premium',
  audience: '長い時間座れるイス型おまるを探す人の候補',
  note: 'イス型・中桶付き・幅約32×33×33cm・約870g',
  status: 'official',
};


const contentAsOf = new Date().toISOString().slice(0, 10);
const productInfoStale = isContentStale(articleMetadata.productInfoCheckedAt, contentAsOf);
const purchaseLinkLabel = articleMetadata.purchaseLinksCheckedAt
  ? `最終確認 ${articleMetadata.purchaseLinksCheckedAt}`
  : '最終確認日は未記録';

const differenceRows: DifferenceRow[] = [
  {
    "label": "形状",
    "left": "収納式のコンパクトなポッティ。公式の案内では「スペースの限られたバスルームに必要なデザインと機能をコンパクトにまとめた」と記載。",
    "right": "イス型オマル。公式の案内では「お子さまが長い時間オマルに座る場合、イス型オマルが最適」と記載。柔らかいフォルムの人間工学デザイン。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "サイズ",
    "left": "幅約25.5×奥行き約32×高さ約17.5cm。",
    "right": "幅約32×奥行き約33×高さ約33cm。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "重量・素材",
    "left": "約520g。素材はポリプロピレン。",
    "right": "約870g。素材はポリプロピレン。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "中桶",
    "left": "収納式の構造（中桶の有無は公式商品ページで確認）。",
    "right": "中桶付き。中桶を取り外してそのまま流せる。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "公式ショップ価格（2026-08-10確認）",
    "left": "3,080円。",
    "right": "4,180円。",
    "leftStatus": "official",
    "rightStatus": "official"
  }
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 育児用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">スマートポッティとポッティチェアは、どちらもベビービョルンのトイレトレーニング用おまるです。最大の違いは形状と収納方法です。スマートポッティはコンパクトな収納式、ポッティチェアは長く座れるイス型で中桶付きです。この記事では、ベビービョルン公式楽天市場店で2026年8月10日時点に確認できた情報だけを使って比較します。公式ページに記載されていることは「確認できること」として整理し、使いやすさや実際の反応など、公式情報だけでは判断できないことは推測しません。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">どっち向き？</a>
      <a href="#sns">SNSの声</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="purchase-cards">
      <PurchaseCard
        name="ベビービョルン スマートポッティ"
        audience="コンパクトに収納でき、狭いバスルームでも場所を取らないおまるを優先する人向け"
        href={smartPottyRakutenUrl}
        productId="babybjorn-smart-potty"
        imagePath="/products/babybjorn-smart-potty.jpg"
        placement="after-decision"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="ベビービョルン ポッティチェア"
        audience="長い時間座れるイス型で、中桶をそのまま流せる手軽さを優先する人向け"
        href={pottyChairRakutenUrl}
        productId="babybjorn-potty-chair"
        imagePath="/products/babybjorn-potty-chair.jpg"
        placement="after-decision"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>
    <div class="verification-summary" aria-label="記事情報の確認状況">
      <p>商品情報確認日: <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time></p>
      <p>購入リンク: {purchaseLinkLabel}</p>
      {productInfoStale && <p class="notice">商品情報の確認から時間が経過しています。購入前に公式ページで最新仕様を確認してください。</p>}
    </div>
    <p class="notice">広告表示：この記事には広告リンクを含みます。価格・在庫は販売先で、仕様は公式ページで確認してください。</p>

    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2
      left={{ brand: smartPottyCandidate.product, line: smartPottyCandidate.line, tagline: smartPottyCandidate.audience, image: '/products/babybjorn-smart-potty.jpg', imageAlt: `${smartPottyCandidate.product} ${smartPottyCandidate.line}`, buyHref: smartPottyRakutenUrl, officialHref: smartPottyProductUrl, guidePoints: [smartPottyCandidate.audience] }}
      right={{ brand: pottyChairCandidate.product, line: pottyChairCandidate.line, tagline: pottyChairCandidate.audience, image: '/products/babybjorn-potty-chair.jpg', imageAlt: `${pottyChairCandidate.product} ${pottyChairCandidate.line}`, buyHref: pottyChairRakutenUrl, officialHref: pottyChairProductUrl, guidePoints: [pottyChairCandidate.audience] }}
      rows={differenceRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
    />


    <h2 id="official">公式情報</h2>
    <p>ここでは、ベビービョルン公式楽天市場店の商品ページで確認できた内容を整理します。使いやすさ・実際の反応・お子さまの好みなど、公式情報だけでは確認できないことは書いていません。</p>
    <h3>スマートポッティ で公式に確認できること</h3>
    <ul class="official-list">
      <li>「スペースの限られたバスルームに必要なデザインと機能をコンパクトにまとめた」スマートポッティ（公式商品ページ）。</li>
      <li>ポッティは人間工学に基づいたソフトなフォルムでデザインされ、「お子様に最高レベルの快適さを提供します」と案内。</li>
      <li>滑らかな、丸みを帯びたデザイン。小さめサイズで足裏がしっかり床につく設計。</li>
      <li>製品サイズは幅約25.5×奥行き約32×高さ約17.5cm・製品重量は約520g・素材はポリプロピレン。</li>
      <li>2026-08-10時点の公式楽天市場店の表示価格は3,080円。</li>
    </ul>
    <h3>ポッティチェア で公式に確認できること</h3>
    <ul class="official-list">
      <li>「お子さまが長い時間オマルに座る場合、イス型オマルが最適です」と案内（公式商品ページ）。</li>
      <li>柔らかいフォルムの人間工学デザインは「最大限の快適さを提供します」と案内。</li>
      <li>製品サイズは幅約32×奥行き約33×高さ約33cm・製品重量は約870g・素材はポリプロピレン。</li>
      <li>中桶付き。中桶を取り外してそのまま流せる。</li>
      <li>2026-08-10時点の公式楽天市場店の表示価格は4,180円。</li>
    </ul>

    <ArticleSocialProof
      query="ベビービョルン スマートポッティ ポッティチェア"
      checkedAt="2026-08-12"
      hasPosts={false}
    />

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2 id="purchase">購入前に確認するページ</h2>
    <div class="source-links">
      <a class="card-link" href={smartPottySearch} target="_blank" rel="noopener noreferrer">スマートポッティの販売ページを検索 →</a>
      <a class="card-link" href={pottyChairSearch} target="_blank" rel="noopener noreferrer">ポッティチェアの販売ページを検索 →</a>
    </div>

    <h2>購入時の注意</h2>
    <p>この記事で記載した価格は、2026年8月10日時点で確認したベビービョルン公式楽天市場店の表示価格です。楽天市場など他のショップでは、販売価格、ポイント還元、送料、セット内容などが変わる場合があります。購入時は、商品名、カラー、付属品を販売ページで確認してください。また、おまる・補助便座の正しい使用方法は必ず公式の使用説明書で確認してください。</p>

    <div class="grid two">
      <PurchaseCard
        name="ベビービョルン スマートポッティ"
        audience="コンパクトに収納でき、狭いバスルームでも場所を取らないおまるを優先する人向け"
        href={smartPottyRakutenUrl}
        productId="babybjorn-smart-potty"
        imagePath="/products/babybjorn-smart-potty.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="ベビービョルン ポッティチェア"
        audience="長い時間座れるイス型で、中桶をそのまま流せる手軽さを優先する人向け"
        href={pottyChairRakutenUrl}
        productId="babybjorn-potty-chair"
        imagePath="/products/babybjorn-potty-chair.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>

    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog.slice().sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
      ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={smartPottyProductUrl} target="_blank" rel="noopener noreferrer">スマートポッティ（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={pottyChairProductUrl} target="_blank" rel="noopener noreferrer">ポッティチェア（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
    </ul>
    <h2>調査方法・免責</h2>
    <p>本記事は、2026-08-10時点でベビービョルン公式楽天市場店の商品ページに記載されていた情報をもとに作成しています。商品情報は確認日時点のものであり、その後の仕様変更・価格変動・販売終了の可能性があります。ご購入の際は必ずご自身で公式情報・販売ページをご確認ください。</p>
    <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
  </article>
</BaseLayout>

---
import { articlePurchaseLinks } from '../../../lib/products';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2Section from '../../../components/ArticleComparisonV2Section.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ExternalEmbed from '../../../components/ExternalEmbed.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {merriesNewbornArticle as articleMetadata} from '../../../content/articles';
import {comparisonV2Articles} from '../../../content/articles/comparison-v2';

const comparison = comparisonV2Articles['merries-newborn'];
const left = comparison.left;
const right = comparison.right;
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / おむつ · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">メリーズの新生児用テープ「ファーストプレミアム」と「ずっと肌さらエアスルー」を、花王公式で確認できる機能・サイズ展開で比較します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">結局どっち？</a>

      <a href="#faq">FAQ</a>
    </nav>
    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2Section articleId="merries-newborn" />


    <details class="fold-section" id="specs">
      <summary>詳細仕様（公式ページで確認した項目）</summary>
      <details class="source-toggle">
        <summary>根拠・確認先を表示</summary>
      </details>
      <div class="table-scroll">
    <table class="comparison">
      <thead><tr><th scope="col">比較項目</th><th scope="col">ファーストプレミアム</th><th scope="col">ずっと肌さらエアスルー</th><th scope="col">根拠・確認先</th></tr></thead>
      <tbody>
        <tr><th scope="row">公式上の位置づけ</th><td data-label="ファーストプレミアム">肌にやさしい肌ざわりのテープ</td><td data-label="ずっと肌さらエアスルー">おむつ内の環境（ムレ・おしっこ）のテープ</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
        <tr><th scope="row">新生児サイズ</th><td data-label="ファーストプレミアム">3,000g・5,000gの2択</td><td data-label="ずっと肌さらエアスルー">お誕生（5,000gまで）</td><td data-label="根拠・確認先"><a href={left.officialHref} target="_blank" rel="noopener noreferrer">ファーストプレミアム公式</a> / <a href={right.officialHref} target="_blank" rel="noopener noreferrer">エアスルー公式</a></td></tr>
        <tr><th scope="row">主な機能</th><td data-label="ファーストプレミアム">カシミヤタッチ・吸収部の抗菌・アルガンオイル配合</td><td data-label="ずっと肌さらエアスルー">シートに50億個以上の穴・おしっこロック・瞬間吸収</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
        <tr><th scope="row">価格・在庫</th><td data-label="ファーストプレミアム">販売ページで確認</td><td data-label="ずっと肌さらエアスルー">販売ページで確認</td><td data-label="根拠・確認先">楽天市場の検索結果</td></tr>
      </tbody>
    </table>
      </div>
      <p class="meta">商品仕様やサイズ展開は変更される可能性があります。購入時点の公式商品ページとパッケージを確認してください。</p>
    </details>

    <h2 id="official">公式情報</h2>
    <p>ファーストプレミアムの公式ページでは、カシミヤタッチの肌ざわり、吸収部の抗菌（JIS L 1902:2015 試験結果をもとにした表示）、アルガンオイル配合（肌に触れるシート部分）が案内されています。エアスルーの公式ページでは、シート表面に目に見えない穴が50億個以上ありおむつの外側に湿気を出す構造、縦横の溝による瞬間吸収、ゆるうんちの吸収シートが案内されています。</p>
    <div class="source-links">
      <a class="card-link" href={left.officialHref} target="_blank" rel="noopener noreferrer">ファーストプレミアム公式商品ページ →</a>
      <a class="card-link" href={right.officialHref} target="_blank" rel="noopener noreferrer">ずっと肌さらエアスルー公式商品ページ →</a>
    </div>

    <ArticleSocialProof
      query="メリーズ ファーストプレミアム エアスルー"
      checkedAt="2026-08-12"
      hasPosts={true} bestMatch="series"
    >
      <div class="sns-embeds">
      <ExternalEmbed provider="x" match="series" url="https://x.com/i/status/2029052962384052374" title="メリーズ ファーストプレミアムとエアスルーの使用経験に触れた投稿" purpose="両シリーズの使用数に触れた投稿。サイズや使用条件は記事対象と一致するか別途確認が必要です。" tone="mixed" autoload compact />
    </div>
    </ArticleSocialProof>

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {comparison.faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>価格・在庫・販売条件は販売先で変わります。このサイトでは価格や在庫を保証しません。</p>
    <p>新生児用でも体重や体型には個人差があります。漏れや肌トラブルが続く場合は使用を中止し、必要に応じて専門家へ相談してください。</p>

    <div class="purchase-cards">
      <PurchaseCard
        name="ファーストプレミアム"
        audience="肌ざわり・肌への配慮と、小さめ新生児へのフィットを優先する人向け"
        href={articlePurchaseLinks['merries-newborn:left'].purchaseUrl}
        productId="merries-fp-newborn"
        imagePath="/products/merries-fp-newborn.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="ずっと肌さらエアスルー"
        audience="ムレ対策・おしっこ吸収を優先する人向け"
        href={articlePurchaseLinks['merries-newborn:right'].purchaseUrl}
        productId="merries-airsle-newborn"
        imagePath="/products/merries-airsle-newborn.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>
    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog
        .slice()
        .sort((left, right) => right.date.localeCompare(left.date))
        .map((entry) => (
          <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
        ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={left.officialHref} target="_blank" rel="noopener noreferrer">花王：ファーストプレミアム テープ</a>（2026-08-08確認）</li>
      <li><a href={right.officialHref} target="_blank" rel="noopener noreferrer">花王：ずっと肌さらエアスルー テープ</a>（2026-08-08確認）</li>
      <li><a href={articlePurchaseLinks['merries-newborn:left'].purchaseUrl} target="_blank" rel="noopener noreferrer">楽天市場：ファーストプレミアム検索</a>（価格・在庫確認用）</li>
      <li><a href={articlePurchaseLinks['merries-newborn:right'].purchaseUrl} target="_blank" rel="noopener noreferrer">楽天市場：エアスルー検索</a>（価格・在庫確認用）</li>
    </ul>
    <h2>調査方法・免責事項</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式Q&Aで確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

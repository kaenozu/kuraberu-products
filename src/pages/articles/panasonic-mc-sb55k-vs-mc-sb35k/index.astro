---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {panasonicVacuumArticle as articleMetadata} from '../../../content/articles';

const plusOfficial = 'https://panasonic.jp/soji/products/MC-SB55K.html';

const standardOfficial = 'https://panasonic.jp/soji/products/MC-SB35K.html';

const plus = {brand: 'パナソニック', line: 'MC-SB55K', image: '/products/panasonic-mc-sb55k.png', imageAlt: 'パナソニック コードレススティック掃除機 MC-SB55K', audience: 'ゴミの量を検知するセンサーと充電スタンドを重視する人の候補', official: plusOfficial};

const standard = {brand: 'パナソニック', line: 'MC-SB35K', image: '/products/panasonic-mc-sb35k.png', imageAlt: 'パナソニック コードレススティック掃除機 MC-SB35K', audience: '軽さと基本機能を優先して選びたい人の候補', official: standardOfficial};

const faqEntries = [
  {question: 'パナソニック MC-SB55K と MC-SB35K の違いは？', answer: '公式ページで確認できる主な違いは、MC-SB55Kにスゴ取れセンサーと置くだけ充電スタンドが搭載されていることです。MC-SB35Kは軽量モデルとして案内されています。'},
  {question: '軽いのはどっち？', answer: '公式ページの表示では、MC-SB55Kは約1.2kg、MC-SB35Kは約1.1kgです。どちらも本体質量の注記があるため、測定条件は各公式ページで確認してください。'},
  {question: '充電スタンドがあるのはどっち？', answer: 'MC-SB55Kには、戻すだけで充電できる置くだけ充電スタンドが公式ページで案内されています。MC-SB35Kの公式ページでは、同じ充電スタンドの案内を確認できませんでした。'},
  {question: '価格は比較できる？', answer: '両モデルとも公式ページでは販売店に確認するオープン価格として扱われています。価格の優劣ではなく、センサー・充電スタンド・重量などの確認できる差で選ぶ記事です。'},
];

const keyDiffRows: KeyDiffRow[] = [
  {label: '本体質量の表示', left: '約1.2kg', right: '約1.1kg', highlight: 'right', highlightNote: '約100g軽い', bar: {left: 1.2, right: 1.1}, direction: 'lower-is-better'},
  {label: 'ゴミ検知センサー', left: 'スゴ取れセンサー', right: '公式ページで確認できず', highlight: 'left', highlightNote: '搭載',},
  {label: '充電スタンド', left: '置くだけ充電スタンド', right: '公式ページで確認できず', highlight: 'left', highlightNote: '搭載'},
  {label: 'ブラシ', left: 'からまないブラシPlus', right: 'からまないブラシPlus'},
  {label: '価格', left: 'オープン価格', right: 'オープン価格'},
];

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: plus.brand, line: plus.line, tagline: 'センサー・充電スタンドなら', image: plus.image, imageAlt: plus.imageAlt, officialHref: plus.official, guidePoints: [plus.audience], purchaseHref: articlePurchaseLinks['panasonic-mc-sb55k-vs-mc-sb35k:left'].purchaseUrl}}
  right={{brand: standard.brand, line: standard.line, tagline: '軽さ・基本機能なら', image: standard.image, imageAlt: standard.imageAlt, officialHref: standard.official, guidePoints: [standard.audience], purchaseHref: articlePurchaseLinks['panasonic-mc-sb55k-vs-mc-sb35k:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"パナソニックのMC-SB55KとMC-SB35Kは、どちらもコードレススティック掃除機です。公式ページで確認できる質量、ゴミ検知センサー、充電スタンド、ブラシの違いを分けて比較します。"}
  summaryParagraph={"MC-SB55Kは、スゴ取れセンサーと置くだけ充電スタンドを公式ページで確認できます。MC-SB35Kは約1.1kgの軽量モデルとして案内されています。価格は両方ともオープン価格なので、販売店で確認してください。"}
  officialDescription={"パナソニック公式ページでは、MC-SB55Kにスゴ取れセンサー、からまないブラシPlus、置くだけ充電スタンドが案内されています。MC-SB35Kは、からまないブラシPlusを搭載した軽量モデルとして案内されています。"}
  officialLinks={[
    { label: "MC-SB55K 公式商品ページ", href: plusOfficial },
    { label: "MC-SB35K 公式商品ページ", href: standardOfficial },
  ]}
  socialProofQuery={"パナソニック MC-SB55K MC-SB35K 掃除機"}
  faqEntries={faqEntries}
  leftPurchaseName={"パナソニック MC-SB55K"}
  leftPurchaseAudience={plus.audience}
  rightPurchaseName={"パナソニック MC-SB35K"}
  rightPurchaseAudience={standard.audience}
  sourceLinks={[
    { label:"パナソニック MC-SB55K 公式商品ページ", href:plusOfficial, checkedAt:"2026-08-13" },
    { label:"パナソニック MC-SB35K 公式商品ページ", href:standardOfficial, checkedAt:"2026-08-13" },
  ]}
  purchaseWarning={"コードレス掃除機は、質量の測定条件、連続運転時間、充電時間、付属品、収納方法を購入前に公式ページで確認してください。価格や在庫は販売先で変わります。"}
  disclaimer={"この比較は、パナソニック公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。"}
/>
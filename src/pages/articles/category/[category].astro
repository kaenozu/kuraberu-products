---
import ArticleCard from '../../../components/ArticleCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publicArticleMetadata } from '../../../content/articles';
import { normalizeDiscoveryText } from '../../../lib/article-discovery';
import { comparisonSubjects } from '../../../lib/article-subjects';

// カテゴリ一覧は公開記事（publicArticleMetadata）由来に限定する。
// 非公開記事だけが属するカテゴリで「0件ページ」が生成されるのを防ぐ。
const allCategories = [...new Set(publicArticleMetadata.map((article) => article.category))].sort();

export function getStaticPaths() {
  const categories = [...new Set(publicArticleMetadata.map((article) => article.category))].sort();
  return categories.map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const articles = [...publicArticleMetadata]
  .filter((article) => article.category === category)
  .sort((a, b) => (a.modifiedAt < b.modifiedAt ? 1 : a.modifiedAt > b.modifiedAt ? -1 : 0));

const discoveryIndex = publicArticleMetadata.map((article) => ({
  id: article.id,
  path: article.path,
  headline: article.headline,
  summary: article.summary,
  category: article.category,
  tags: article.tags,
  audiences: article.audiences,
  uses: article.uses,
  modifiedAt: article.modifiedAt,
  imagePath: article.imagePath,
  subjects: comparisonSubjects(article),
}));
---

<BaseLayout
  title={`${category}の比較記事｜くらべる商品メモ`}
  description={`メーカー公式の情報で${category}の商品を比べる記事一覧`}
>
  <section class="section wrap article-index" data-article-discovery>
    <p class="eyebrow">Comparison articles</p>
    <h1>{category}の比較記事</h1>
    <p class="lead">確認できる公式情報と販売ページを起点に、{category}の商品を選ぶときの判断材料を整理しています。</p>

    <div class="diagnosis-index-note">
      <p><strong>「どちらも良さそうで決められない」場合はこちら：</strong><a href="/tools/product-finder/">30秒で自分に合う商品を診断 →</a></p>
    </div>

    <form class="article-filters" role="search" aria-label="比較記事を検索" data-discovery-form>
      <label>
        <span>キーワード</span>
        <input type="search" name="q" maxlength="100" autocomplete="off" placeholder="商品名・用途・悩みで検索" data-discovery-query />
      </label>
      <label>
        <span>カテゴリ</span>
        <select name="category" data-discovery-category>
          <option value="">すべて</option>
          {allCategories.map((cat) => (
            <option value={cat} selected={cat === category}>{cat}</option>
          ))}
        </select>
      </label>
      <label>
        <span>タグ</span>
        <select name="tag" data-discovery-tag>
          <option value="">すべて</option>
        </select>
      </label>
      <button type="button" class="secondary-button" data-discovery-clear>条件をクリア</button>
    </form>
    <p class="meta" aria-live="polite" data-discovery-count>{articles.length}件の記事</p>

    <script is:inline type="application/json" data-discovery-index set:html={JSON.stringify(discoveryIndex)} />
    <div class="article-list" data-discovery-results>
      {articles.map((article) => (
        <ArticleCard
          article={article}
          data={{
            'data-article-card': '',
            'data-search': normalizeDiscoveryText([article.title, article.headline, article.summary, article.category, ...article.tags, ...article.audiences, ...article.uses, ...(comparisonSubjects(article) ?? [])].join(' ')),
            'data-category': article.category,
            'data-tags': JSON.stringify(article.tags),
          }}
        />
      ))}
    </div>
    <div class="card discovery-empty" hidden data-discovery-empty>
      <h2>条件に合う記事がありません</h2>
      <p>キーワードを短くするか、カテゴリ・タグをクリアしてください。</p>
      <button type="button" class="secondary-button" data-discovery-clear>条件をクリア</button>
    </div>
  </section>

  <script src="/scripts/article-discovery.js" defer is:inline />
</BaseLayout>

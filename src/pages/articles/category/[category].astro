---
import ArticleListPage from '../../../components/ArticleListPage.astro';
import { publicArticleMetadata, articleMetadata } from '../../../content/articles';

const allCategories = [...new Set(articleMetadata.map((article) => article.category))].sort();

export function getStaticPaths() {
  const categories = [...new Set(articleMetadata.map((article) => article.category))].sort();
  return categories.map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const articles = [...publicArticleMetadata]
  .filter((article) => article.category === category)
  .sort((a, b) => (a.modifiedAt < b.modifiedAt ? 1 : a.modifiedAt > b.modifiedAt ? -1 : 0));
---

<ArticleListPage
  title={`${category}の比較記事｜くらべる商品メモ`}
  description={`メーカー公式の情報で${category}の商品を比べる記事一覧`}
  heading={`${category}の比較記事`}
  lead={`確認できる公式情報と販売ページを起点に、${category}の商品を選ぶときの判断材料を整理しています。`}
  articles={articles}
  discoveryArticles={publicArticleMetadata}
  categories={allCategories}
  tags={[]}
  selectedCategory={category}
  count={articles.length}
  showDiagnosisNote={true}
/>

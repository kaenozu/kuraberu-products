---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import AffiliateButton from '../../../components/AffiliateButton.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ThirtySecondComparison from '../../../components/ThirtySecondComparison.astro';
import DifferenceList from '../../../components/DifferenceList.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import SnsReactions from '../../../components/SnsReactions.astro';
import {thermosTigerBottleArticle as articleMetadata} from '../../../content/articles';
import {isContentStale} from '../../../lib/content-freshness';
import type {
  ComparisonCandidate,
  ComparisonRow,
  DifferenceRow,
} from '../../../lib/comparison';

const thermosOfficial = 'https://www.thermos.jp/product/series/jnl-s00.html';
const tigerOfficial = 'https://www.tiger-corporation.com/ja/jpn/product/vacuum-insulated-products/mta-j/';
const thermosRakuten = 'https://item.rakuten.co.jp/rakuten24/405671/';
const tigerRakuten = 'https://item.rakuten.co.jp/irodorich/22410151/';
const thermosSearch = 'https://search.rakuten.co.jp/search/mall/%E3%82%B5%E3%83%BC%E3%83%A2%E3%82%B9%20JNL-S500';
const tigerSearch = 'https://search.rakuten.co.jp/search/mall/%E3%82%BF%E3%82%A4%E3%82%AC%E3%83%BC%20MTA-J050';

const faqEntries = [
  {
    question: 'サーモス JNL-S500 と タイガー MTA-J050 はどっち？',
    answer:
      '公式の仕様では、保冷効力（6時間）がタイガーMTA-J050は8℃以下、サーモスJNL-S500は10℃以下で、タイガーの方が冷たさを保ちます。本体重量はサーモスJNL-S500が約0.2kg、タイガーMTA-J050が約0.26kgで、サーモスの方が軽いです。飲み口はタイガーが口径4.8cm・ハンドル付き、サーモスは口径4.0cm・全パーツ食洗機対応です。どちらが合うかは、保冷を重視するか・軽さを重視するかで変わります。',
  },
  {
    question: '保冷力が強いのはどっち？',
    answer:
      '公式の保冷効力（6時間）は、タイガーMTA-J050が8℃以下、サーモスJNL-S500が10℃以下です。夏場に氷を長持ちさせたい場合はタイガーMTA-J050の方が数値上は有利です。',
  },
  {
    question: '軽いのはどっち？',
    answer:
      '公式の本体重量は、サーモスJNL-S500が約0.2kg、タイガーMTA-J050が約0.26kgです。本体寸法もサーモス（6.5×8.0×22.0cm）の方がタイガー（7.5×8.6×23.3cm）よりコンパクトです。持ち歩きの軽さを重視するならサーモスJNL-S500です。',
  },
  {
    question: 'お手入れのしやすさはどっち？',
    answer:
      'サーモスJNL-S500は全パーツ食洗機対応です。タイガーMTA-J050は、せんとパッキンが一体になった「らくらくキャップ」でパッキン着脱の手間がなく、外せる飲み口で洗えます。どちらも公式に「お手入れしやすい」と案内されていますが、洗い方は異なります。',
  },
  {
    question: 'タイガー MTA-J050 のハンドルは便利？',
    answer:
      '公式の案内では、MTA-J050はハンドル付きで、学校や職場、お出かけの際に指に自然にフィットするスラントハンドルとして紹介されています。片手でも開けやすいワンプッシュせんとあわせて、持ち運びの利便性を重視する人向けです。',
  },
  {
    question: 'スポーツドリンクを入れてもいい？',
    answer:
      'タイガーMTA-J050の内面は「スーパークリーンPlus」で、公式案内では汚れ・においがつきにくくサビにも強いため、塩分を含むスポーツドリンクを入れてもOKとされています（使用後はすぐに水ですすぐなどお手入れが必要）。サーモスJNL-S500のスポーツドリンク対応については、今回確認した公式ページには明記されていません。',
  },
] as const;

const contentAsOf = new Date().toISOString().slice(0, 10);
const productInfoStale = isContentStale(
  articleMetadata.productInfoCheckedAt,
  contentAsOf,
);
const purchaseLinkLabel = articleMetadata.purchaseLinksCheckedAt
  ? `最終確認 ${articleMetadata.purchaseLinksCheckedAt}`
  : '最終確認日は未記録';

const thermosCandidate: ComparisonCandidate = {
  product: 'サーモス',
  line: 'JNL-S500',
  tone: 'premium',
  audience: '軽さ・コンパクト重視、カラーが豊富な方がいい人',
  note: '公式ページで仕様を確認',
  status: 'official',
};

const tigerCandidate: ComparisonCandidate = {
  product: 'タイガー',
  line: 'MTA-J050',
  tone: 'standard',
  audience: '保冷重視、ハンドル付き・大きめの飲み口がいい人',
  note: '公式ページで仕様を確認',
  status: 'official',
};

const summaryRows: ComparisonRow[] = [
  {label: '保冷効力（6時間）', left: '10℃以下', right: '8℃以下'},
  {label: '本体重量', left: '約0.2kg', right: '約0.26kg'},
  {
    label: '飲み口・お手入れ',
    left: '口径4.0cm・全パーツ食洗機対応',
    right: '口径4.8cm・らくらくキャップ・ハンドル付き',
  },
];

const differenceRows: DifferenceRow[] = [
  {
    label: '保冷効力（6時間）',
    left: '10℃以下',
    right: '8℃以下',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: '本体重量',
    left: '約0.2kg',
    right: '約0.26kg',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: '本体寸法（幅×奥行×高さ）',
    left: '6.5×8.0×22.0cm',
    right: '7.5×8.6×23.3cm',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: '口径',
    left: '約4.0cm',
    right: '約4.8cm',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: 'カラー',
    left: '12色',
    right: '4色',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: '飲み口',
    left: 'ワンタッチオープン',
    right: 'ワンプッシュ',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: 'お手入れ',
    left: '全パーツ食洗機対応',
    right: 'らくらくキャップ（パッキン一体型）・外せる飲み口',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: 'ハンドル',
    left: 'なし',
    right: 'あり（スラントハンドル）',
    leftStatus: 'official',
    rightStatus: 'official',
  },
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 生活雑貨 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">0.5Lのワンタッチ式水筒は、サーモスの「JNL-S500」とタイガーの「MTA-J050」が定番の選択肢です。どちらも真空断熱のステンレスボトルですが、公式の仕様では保冷効力・重量・飲み口の構造に違いがあります。この記事では、両社の公式商品ページで確認できる情報だけをもとに、2つの水筒の違いを整理します。</p>
    <nav class="toc" aria-label="目次">
      <h2>この記事の内容</h2>
      <ol>
        <li><a href="#comparison-details">2つの商品を比べる</a></li>
        <li><a href="#checked">確認できる項目</a></li>
        <li><a href="#official">公式情報</a></li>
        <li><a href="#faq">よくある質問</a></li>
        <li><a href="#sns">SNS での感想</a></li>
        <li><a href="#purchase">購入前に確認するページ</a></li>
      </ol>
    </nav>
    <div class="product-compare" aria-label="比較する2つの商品">
      <article class="product-card">
        <img
          src="/products/thermos-jnl-s500.jpg"
          alt="サーモス 真空断熱ケータイマグ JNL-S500"
          width="500"
          height="500"
          loading="eager"
        />
        <div class="product-card-body">
          <span class="product-card-line">サーモス / 真空断熱ケータイマグ</span>
          <h2 class="product-card-name">JNL-S500</h2>
          <p class="product-card-desc">実容量0.5L・本体重量約0.2kg・全パーツ食洗機対応。</p>
          <a class="product-card-link" href={thermosOfficial} target="_blank" rel="noopener noreferrer">公式ページで確認 →</a>
        </div>
      </article>
      <article class="product-card">
        <img
          src="/products/tiger-mta-j050.jpg"
          alt="タイガー 真空断熱ボトル MTA-J050"
          width="1000"
          height="1000"
          loading="eager"
        />
        <div class="product-card-body">
          <span class="product-card-line">タイガー / 真空断熱ボトル</span>
          <h2 class="product-card-name">MTA-J050</h2>
          <p class="product-card-desc">実容量0.5L・保冷効力8℃以下・ハンドル付きワンプッシュ。</p>
          <a class="product-card-link" href={tigerOfficial} target="_blank" rel="noopener noreferrer">公式ページで確認 →</a>
        </div>
      </article>
    </div>
    <div class="verification-summary" aria-label="記事情報の確認状況">
      <p>商品情報確認日：{articleMetadata.productInfoCheckedAt ? <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time> : '未記録'}</p>
      <p>購入リンク：{purchaseLinkLabel}</p>
      {productInfoStale && <p class="notice">商品情報の確認から時間が経過しています。購入前に公式ページで最新仕様を確認してください。</p>}
    </div>
    <p class="notice">広告表示：この記事には広告リンクを含みます。価格・在庫は販売先で、仕様は公式ページで確認してください。</p>
    <ThirtySecondComparison
      idPrefix="thermos-tiger-summary"
      heading="まず、違いはこの3つ"
      conclusion="保冷を重視するなら、保冷効力（6時間）が8℃以下のタイガーMTA-J050が目安です。軽さ・コンパクト重視なら、本体重量約0.2kgで12色から選べるサーモスJNL-S500が目安です。飲み口は、タイガーが口径4.8cmのワンプッシュ＋ハンドル付き、サーモスは口径4.0cmのワンタッチ＋全パーツ食洗機対応と、構造が異なります。"
      left={thermosCandidate}
      right={tigerCandidate}
      rows={summaryRows}
      detailHref="#comparison-details"
      ctaHref="#purchase"
    />

    <h2>どちらにしますか？</h2>
    <p class="lead">購入先は、商品ごとのページで確認できます。価格・在庫は販売先で変わります。</p>
    <div class="purchase-cards">
      <PurchaseCard
        name="サーモス JNL-S500"
        audience="軽さ・コンパクト重視、カラーが豊富な方がいい人向け"
        href={thermosRakuten}
        imagePath="/products/thermos-jnl-s500.jpg"
        placement="after-conclusion"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="タイガー MTA-J050"
        audience="保冷重視、ハンドル付き・大きめの飲み口がいい人向け"
        href={tigerRakuten}
        imagePath="/products/tiger-mta-j050.jpg"
        placement="after-conclusion"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>

    <div id="comparison-details">
      <DifferenceList
        idPrefix="thermos-tiger-differences"
        leftLabel="JNL-S500"
        rightLabel="MTA-J050"
        items={differenceRows}
      />
    </div>

    <h2 id="checked">確認できる項目</h2>
    <div class="table-scroll">
    <table class="comparison">
      <thead><tr><th scope="col">比較項目</th><th scope="col">サーモス JNL-S500</th><th scope="col">タイガー MTA-J050</th><th scope="col">根拠・確認先</th></tr></thead>
      <tbody>
        <tr><th scope="row">容量</th><td>0.5L</td><td>0.5L</td><td><a href={thermosOfficial} target="_blank" rel="noopener noreferrer">サーモス公式</a> / <a href={tigerOfficial} target="_blank" rel="noopener noreferrer">タイガー公式</a></td></tr>
        <tr><th scope="row">保温効力（6時間）</th><td>68℃以上</td><td>68℃以上</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">保冷効力（6時間）</th><td>10℃以下</td><td>8℃以下</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">本体重量</th><td>約0.2kg</td><td>約0.26kg</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">本体寸法（幅×奥行×高さ）</th><td>6.5×8.0×22.0cm</td><td>7.5×8.6×23.3cm</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">口径</th><td>約4.0cm</td><td>約4.8cm</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">カラー</th><td>12色</td><td>4色</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">飲み口</th><td>ワンタッチオープン</td><td>ワンプッシュ</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">お手入れ</th><td>全パーツ食洗機対応</td><td>らくらくキャップ（パッキン一体型）</td><td>各公式商品ページ</td></tr>
        <tr><th scope="row">ハンドル</th><td>なし</td><td>あり（スラントハンドル）</td><td>各公式商品ページ</td></tr>
      </tbody>
    </table>
    </div>
    <p class="meta">商品仕様や価格は変更される可能性があります。購入時点の公式商品ページと販売ページを確認してください。</p>

    <h2 id="official">公式情報</h2>
    <p>サーモスJNL-S500とタイガーMTA-J050は、どちらも0.5Lの真空断熱ステンレスボトルで、保温効力（6時間）は68℃以上と同じです。差が出るのは保冷効力で、タイガーは8℃以下、サーモスは10℃以下と、タイガーの方が冷たさを保ちます。重量はサーモスの方が軽く（約0.2kg vs 約0.26kg）、サイズもコンパクトです。お手入れは、サーモスが全パーツ食洗機対応、タイガーはパッキン一体型のらくらくキャップで、アプローチが異なります。タイガーの内面はスーパークリーンPlusでスポーツドリンクも入れられます（サーモスのスポーツドリンク対応は今回確認したページには明記なし）。</p>
    <div class="source-links">
      <a class="card-link" href={thermosOfficial} target="_blank" rel="noopener noreferrer">サーモス 真空断熱ケータイマグ JNL-S500 公式ページ →</a>
      <a class="card-link" href={tigerOfficial} target="_blank" rel="noopener noreferrer">タイガー 真空断熱ボトル MTA-J050 公式ページ →</a>
    </div>

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2 id="sns">SNS での感想（参考情報）</h2>
    <p>実際に使っている人の投稿を、参考情報として紹介します。比較の根拠はメーカー公式情報のみで、SNS の感想は個人の見解です。カードをタップすると元の投稿を開けます。</p>
    <SnsReactions
      siteName="X"
      reactions={[
        {
          name: "ちんぴっぴ",
          handle: "@pipichan_lovely",
          text: "私も去年買って一番良かったもの、サーモスの水筒…！めちゃくちゃ気軽にいつでも冷たいあたたかい好きな飲み物飲めるの嬉しいすぎる…！",
          url: "https://x.com/pipichan_lovely/status/2084896382750761442",
          tone: "good",
        },
        {
          name: "赤い野人DEATH",
          handle: "@yajinrun800",
          text: "今さらながらサーモスの水筒を買って氷を入れるんだけど、全然氷が溶けなくていつまでもキンキンで麦茶が飲めるの！！サーモス、優秀すぎてビックリ！",
          url: "https://x.com/yajinrun800/status/2084277355510726712",
          tone: "good",
        },
        {
          name: "久。",
          handle: "@hisashi_935",
          text: "自分もサーモスの弁当箱や水筒使ってるので、サーモスには信用しかないです！凄く性能良いですよね。",
          url: "https://x.com/hisashi_935/status/2086083404450418709",
          tone: "good",
        },
        {
          name: "nagisa",
          handle: "@nagisa240605",
          text: "娘の保冷水筒、タイガーかサーモスかで迷ってなかなか買えずにいる、、タイガーの方がコンパクトで今の飲む量なら十分そうなんだけど、コップ飲みと直飲みでパーツ付け替えが必要で…",
          url: "https://x.com/nagisa240605/status/2087091920103415859",
          tone: "mixed",
        },
        {
          name: "小鉄",
          handle: "@gudarakudara",
          text: "10年使ったサーモス水筒の塗装が剥げてきたので、ペイントはがしで思い切って全部剥いだら、シルバーの小洒落た水筒が爆誕。交換パッキンも廃盤になって…",
          url: "https://x.com/gudarakudara/status/2087050731782340707",
          tone: "mixed",
        },
        {
          name: "軟体動物",
          handle: "@kuzumaimai",
          text: "サーモスの水筒、保冷性能が良すぎて、普通のご家庭で作った小ぶりの氷が水筒の中で再凍結して大きい氷になるという、バグとしか思えない現象が起こる。",
          url: "https://x.com/kuzumaimai/status/2084104501154488361",
          tone: "good",
        },
      ]}
    />

    <h2 id="purchase">購入前に確認するページ</h2>
    <p>価格・在庫・販売条件は販売先で変わります。このサイトでは価格や在庫を保証しません。購入リンクは{purchaseLinkLabel}です。</p>
    <div class="grid two">
      <AffiliateButton href={thermosRakuten} label="サーモス JNL-S500 を楽天市場で確認" subLabel="楽天市場で商品を見る" merchant="楽天" imagePath="/products/thermos-jnl-s500.jpg" placement="article-end" />
      <AffiliateButton href={tigerRakuten} label="タイガー MTA-J050 を楽天市場で確認" subLabel="楽天市場で商品を見る" merchant="楽天" imagePath="/products/tiger-mta-j050.jpg" placement="article-end" />
    </div>

    <h2>購入時の注意</h2>
    <p>水筒は使用前に取扱説明書を確認してください。保温・保冷効力は室温20℃±2℃で測定した公式の目安で、実際の使用環境や入れ方で変わります。</p>

    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog
        .slice()
        .sort((left, right) => right.date.localeCompare(left.date))
        .map((entry) => (
          <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
        ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={thermosOfficial} target="_blank" rel="noopener noreferrer">サーモス：真空断熱ケータイマグ JNL-S350･S500･S600･S750･S1000</a>（2026-08-12確認）</li>
      <li><a href={tigerOfficial} target="_blank" rel="noopener noreferrer">タイガー：真空断熱ボトル MTA-J050/J080</a>（2026-08-12確認）</li>
      <li><a href={thermosSearch} target="_blank" rel="noopener noreferrer">楽天市場：サーモス JNL-S500 検索</a>（価格・在庫確認用）</li>
      <li><a href={tigerSearch} target="_blank" rel="noopener noreferrer">楽天市場：タイガー MTA-J050 検索</a>（価格・在庫確認用）</li>
    </ul>
    <h2>調査方法・免責事項</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式Q&Aで確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

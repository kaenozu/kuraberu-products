---
import { articlePurchaseLinks, thermosJnlS500, tigerMtaJ050,} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {thermosTigerBottleArticle as articleMetadata} from '../../../content/articles';

const thermosOfficial = thermosJnlS500.officialUrl;

const tigerOfficial = tigerMtaJ050.officialUrl;

const thermosSearch = thermosJnlS500.rakutenSearchUrl;

const tigerSearch = tigerMtaJ050.rakutenSearchUrl;

const faqEntries = [
  {
    question: 'サーモス JNL-S500 と タイガー MTA-J050 はどっち？',
    answer: `公式の仕様では、保冷効力（6時間）がタイガーMTA-J050は${tigerMtaJ050.spec.coldEfficiency}、サーモスJNL-S500は${thermosJnlS500.spec.coldEfficiency}で、タイガーの方が冷たさを保ちます。本体重量はサーモスJNL-S500が${thermosJnlS500.spec.weight}、タイガーMTA-J050が${tigerMtaJ050.spec.weight}で、サーモスの方が軽いです。飲み口はタイガーが口径${tigerMtaJ050.spec.mouthDiameter}・ハンドル付き、サーモスは口径${thermosJnlS500.spec.mouthDiameter}・全パーツ食洗機対応です。どちらが合うかは、保冷を重視するか・軽さを重視するかで変わります。`,
  },
  {
    question: '保冷力が強いのはどっち？',
    answer: `公式の保冷効力（6時間）は、タイガーMTA-J050が${tigerMtaJ050.spec.coldEfficiency}、サーモスJNL-S500が${thermosJnlS500.spec.coldEfficiency}です。夏場に氷を長持ちさせたい場合はタイガーMTA-J050の方が数値上は有利です。`,
  },
  {
    question: '軽いのはどっち？',
    answer: `公式の本体重量は、サーモスJNL-S500が${thermosJnlS500.spec.weight}、タイガーMTA-J050が${tigerMtaJ050.spec.weight}です。本体寸法もサーモス（${thermosJnlS500.spec.dimensions}）の方がタイガー（${tigerMtaJ050.spec.dimensions}）よりコンパクトです。持ち歩きの軽さを重視するならサーモスJNL-S500です。`,
  },
  {
    question: 'お手入れのしやすさはどっち？',
    answer:
      'サーモスJNL-S500は全パーツ食洗機対応です。タイガーMTA-J050は、せんとパッキンが一体になった「らくらくキャップ」でパッキン着脱の手間がなく、外せる飲み口で洗えます。どちらも公式に「お手入れしやすい」と案内されていますが、洗い方は異なります。',
  },
  {
    question: 'タイガー MTA-J050 のハンドルは便利？',
    answer:
      '公式の案内では、MTA-J050はハンドル付きで、学校や職場、お出かけの際に指に自然にフィットするスラントハンドルとして紹介されています。片手でも開けやすいワンプッシュせんとあわせて、持ち運びの利便性を重視する人向けです。',
  },
  {
    question: 'スポーツドリンクを入れてもいい？',
    answer:
      'タイガーMTA-J050の内面は「スーパークリーンPlus」で、公式案内では汚れ・においがつきにくくサビにも強いため、塩分を含むスポーツドリンクを入れてもOKとされています（使用後はすぐに水ですすぐなどお手入れが必要）。サーモスJNL-S500のスポーツドリンク対応については、今回確認した公式ページには明記されていません。',
  },
] as const;

const keyDiffRows: KeyDiffRow[] = [
  {
    label: '軽さ（持ち歩きやすさ）',
    left: thermosJnlS500.spec.weight,
    right: tigerMtaJ050.spec.weight,
    highlight: 'left',
    highlightNote: '約60g軽い',
    bar: {left: 0.2, right: 0.26},
    direction: 'lower-is-better',
  },
  {
    label: '大きさ（本体寸法）',
    left: thermosJnlS500.spec.dimensions,
    right: tigerMtaJ050.spec.dimensions,
    highlight: 'left',
    highlightNote: 'ひと回り小さい',
  },
  {
    label: '保冷力（6時間後）',
    left: thermosJnlS500.spec.coldEfficiency,
    right: tigerMtaJ050.spec.coldEfficiency,
    highlight: 'right',
    highlightNote: '保冷力が高い',
    bar: {left: 10, right: 8},
    direction: 'lower-is-better',
  },
  {
    label: '飲み口の大きさ（口径）',
    left: thermosJnlS500.spec.mouthDiameter,
    right: tigerMtaJ050.spec.mouthDiameter,
    highlight: 'right',
    highlightNote: '大きめ',
    bar: {left: 4.0, right: 4.8},
  },
  {
    label: 'お手入れ',
    left: thermosJnlS500.spec.care,
    right: tigerMtaJ050.spec.care,
    highlight: 'left',
    highlightNote: '食洗機OK',
  },
  {
    label: 'ハンドル',
    left: thermosJnlS500.spec.handle,
    right: tigerMtaJ050.spec.handle,
    highlight: 'right',
    highlightNote: 'ハンドル付き',
  },
  {
    label: 'カラー',
    left: thermosJnlS500.spec.colors,
    right: tigerMtaJ050.spec.colors,
    highlight: 'left',
    highlightNote: '豊富',
    bar: {left: 12, right: 4},
  },
];

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: thermosJnlS500.brand,
        line: thermosJnlS500.model,
        tagline: '軽さ・食洗機なら',
        image: thermosJnlS500.imagePath,
        imageAlt: thermosJnlS500.fullName,
        officialHref: thermosJnlS500.officialUrl,
        guidePoints: [
          `軽さ・コンパクトを優先したい（${thermosJnlS500.spec.weight}）`,
          `カラーは豊富な方がいい（${thermosJnlS500.spec.colors}）`,
          '食洗機で丸洗いしたい（全パーツ対応）',
        ],
        purchaseHref: articlePurchaseLinks['thermos-tiger-bottle:left'].purchaseUrl,}}
  right={{brand: tigerMtaJ050.brand,
        line: tigerMtaJ050.model,
        tagline: '保冷・ハンドルなら',
        image: tigerMtaJ050.imagePath,
        imageAlt: tigerMtaJ050.fullName,
        officialHref: tigerMtaJ050.officialUrl,
        guidePoints: [
          `保冷力を最優先したい（6時間で${tigerMtaJ050.spec.coldEfficiency}）`,
          'ハンドル付きがいい（スラントハンドル）',
          `大きめの飲み口がいい（口径${tigerMtaJ050.spec.mouthDiameter}）`,
          'スポーツドリンクを入れたい（スーパークリーンPlus）',
        ],
        purchaseHref: articlePurchaseLinks['thermos-tiger-bottle:right'].purchaseUrl,}}
  keyDiffRows={keyDiffRows}
  lead={"{thermosJnlS500.spec.capacity}のワンタッチ式水筒として、JNL-S500とMTA-J050を比較します。公式仕様から、確認できる違いを整理します。"}
  faqEntries={faqEntries}
  leftPurchaseName={"サーモス JNL-S500"}
  leftPurchaseAudience={"軽さ・コンパクト・食洗機対応を優先する人向け"}
  rightPurchaseName={"タイガー MTA-J050"}
  rightPurchaseAudience={"保冷力・ハンドル・大きめの飲み口を優先する人向け"}
  sourceLinks={[
    { label:"サーモス：{thermosJnlS500.seriesName}", href:thermosOfficial, checkedAt:"2026-08-12" },
    { label:"タイガー：{tigerMtaJ050.seriesName}", href:tigerOfficial, checkedAt:"2026-08-12" },
    { label:"楽天市場：サーモス JNL-S500 検索", href:thermosSearch, checkedAt:"価格・在庫用" },
    { label:"楽天市場：タイガー MTA-J050 検索", href:tigerSearch, checkedAt:"価格・在庫用" },
  ]}
/>
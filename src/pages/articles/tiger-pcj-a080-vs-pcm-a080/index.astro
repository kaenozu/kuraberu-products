---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import RelatedArticles from '../../../components/RelatedArticles.astro'
import PurchaseCard from '../../../components/PurchaseCard.astro'
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro'
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro'
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro'
import {tigerKettlePcjVsPcmArticle as articleMetadata} from '../../../content/articles'
import type {KeyDiffRow} from '../../../components/VisualKeyDifferences.astro'

const pcjOfficial = 'https://www.tiger-corporation.com/ja/jpn/product/kettle-pot/pcj-a/'
const pcmOfficial = 'https://www.tiger-corporation.com/ja/jpn/product/kettle-pot/pcm-a/'
const pcjSearch = 'https://a.r10.to/h51Rfo'
const pcmSearch = 'https://a.r10.to/hklMDi'
const pcjImage = '/products/tiger-pcj-a080.jpg'
const pcmImage = '/products/tiger-pcm-a080.jpg'
const pcjAudience = '蒸気レス構造とカップ1杯約45秒の沸とう時間を優先する人向け'
const pcmAudience = '0.8Lの容量と丸みのある本体形状、安全設計を確認して選びたい人向け'
const faqEntries = [
  {question: 'PCJ-A080とPCM-A080の違いは？', answer: 'タイガー公式の仕様では、PCJ-A080は容量0.8L、カップ1杯約45秒、サイズ約14.8×22.3×19.8cm、質量約0.90kgです。PCM-A080は容量0.8L、カップ1杯約60秒、サイズ約16.1×21.3×18.5cm、質量約0.93kgです。'},
  {question: 'カップ1杯を早く沸かせるのはどちら？', answer: '公式仕様のカップ1杯（約140mL）の沸とう時間は、PCJ-A080が約45秒、PCM-A080が約60秒です。水温・室温23度での表記です。'},
  {question: 'どちらも安全設計ですか？', answer: '両方の公式ページに、通電自動オフ・転倒時のお湯漏れを抑える構造・カラだき防止などの安全設計が記載されています。PCJ-A080は蒸気レス構造も確認できます。'},
  {question: '楽天市場の価格は掲載していますか？', answer: '価格・在庫・送料・ポイントは販売先で変わるため、記事内の楽天市場リンクで購入時点の表示をご確認ください。'},
] as const
const keyDiffRows: KeyDiffRow[] = [
  {label: '容量', left: '0.8L', right: '0.8L', highlight: null},
  {label: 'カップ1杯の沸とう時間', left: '約45秒', right: '約60秒', highlight: 'left', highlightNote: '約15秒短い'},
  {label: 'サイズ（幅×奥行×高さ）', left: '約14.8×22.3×19.8cm', right: '約16.1×21.3×18.5cm', highlight: null},
  {label: '本体質量', left: '約0.90kg', right: '約0.93kg', highlight: 'left', highlightNote: '約30g軽い'},
  {label: '湯わかし時の消費電力', left: '1300W', right: '1300W', highlight: null},
]
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / {articleMetadata.category} · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">タイガーのPCJ-A080とPCM-A080を、メーカー公式ページで確認できる容量・沸とう時間・サイズ・質量・安全設計の範囲で比較します。</p>
    <p>どちらも容量0.8L・消費電力1300Wですが、カップ1杯の沸とう時間や本体寸法が異なります。価格・在庫は販売先でご確認ください。</p>
    <ArticleComparisonV2 left={{brand: 'タイガー 電気ケトル', line: 'PCJ-A080', tagline: '蒸気レス・速さなら', image: pcjImage, imageAlt: 'タイガー PCJ-A080', imageWidth: 498, imageHeight: 578, officialHref: pcjOfficial, guidePoints: [pcjAudience]}} right={{brand: 'タイガー 電気ケトル', line: 'PCM-A080', tagline: '形状・容量を確認するなら', image: pcmImage, imageAlt: 'タイガー PCM-A080', imageWidth: 498, imageHeight: 578, officialHref: pcmOfficial, guidePoints: [pcmAudience]}} rows={keyDiffRows} checkedAt={articleMetadata.productInfoCheckedAt} />
    <details class="fold-section" id="specs" open><summary>詳細仕様（公式ページで確認した項目）</summary><div class="table-scroll"><table class="comparison"><thead><tr><th scope="col">比較項目</th><th scope="col">PCJ-A080</th><th scope="col">PCM-A080</th><th scope="col">根拠</th></tr></thead><tbody><tr><th scope="row">容量</th><td>0.8L</td><td>0.8L</td><td>各公式ページ</td></tr><tr><th scope="row">湯わかし時の消費電力</th><td>1300W</td><td>1300W</td><td>各公式ページ</td></tr><tr><th scope="row">サイズ（幅×奥行×高さ）</th><td>約14.8×22.3×19.8cm</td><td>約16.1×21.3×18.5cm</td><td>各公式ページ</td></tr><tr><th scope="row">本体質量</th><td>約0.90kg</td><td>約0.93kg</td><td>各公式ページ</td></tr><tr><th scope="row">沸とう時間（カップ1杯）</th><td>約45秒</td><td>約60秒</td><td>各公式ページ</td></tr></tbody></table></div><p class="meta">価格・在庫・仕様は変更される可能性があります。購入時点の公式ページと販売ページを確認してください。</p></details>
    <h2 id="official">公式情報</h2><p>仕様の根拠は、タイガー魔法瓶公式の商品ページで2026年8月17日に確認しました。PCJ-A080には蒸気を外に出さない蒸気レス構造、PCM-A080には本体二重構造や転倒お湯漏れ防止構造が案内されています。</p><div class="source-links"><a class="card-link" href={pcjOfficial} target="_blank" rel="noopener noreferrer">PCJ-A080 公式商品ページ →</a><a class="card-link" href={pcmOfficial} target="_blank" rel="noopener noreferrer">PCM-A080 公式商品ページ →</a></div>
    <ArticleSocialProof query="タイガー PCJ-A080 PCM-A080" checkedAt="2026-08-17" hasPosts={false} />
    <h2 id="faq">よくある質問</h2><div class="faq-list">{faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}</div>
    <div class="purchase-cards"><PurchaseCard name="タイガー PCJ-A080" audience={pcjAudience} href={pcjSearch} imagePath={pcjImage} placement="article-end" note="価格・在庫は販売先でご確認ください。" /><PurchaseCard name="タイガー PCM-A080" audience={pcmAudience} href={pcmSearch} imagePath={pcmImage} placement="article-end" note="価格・在庫は販売先でご確認ください。" /></div>
    <h2>情報源一覧</h2><ul class="source-list"><li><a href={pcjOfficial} target="_blank" rel="noopener noreferrer">タイガー公式：PCJ-A080</a>（2026-08-17確認）</li><li><a href={pcmOfficial} target="_blank" rel="noopener noreferrer">タイガー公式：PCM-A080</a>（2026-08-17確認）</li></ul>
  </article><RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {tigerKettlePcjVsPcmArticle as articleMetadata} from '../../../content/articles';

const pcjOfficial = 'https://www.tiger-corporation.com/ja/jpn/product/kettle-pot/pcj-a/'

const pcmOfficial = 'https://www.tiger-corporation.com/ja/jpn/product/kettle-pot/pcm-a/'

const pcjImage = '/products/tiger-pcj-a080.jpg'

const pcmImage = '/products/tiger-pcm-a080.jpg'

const pcjAudience = '蒸気レス構造とカップ1杯約45秒の沸とう時間を優先する人向け'

const pcmAudience = '丸みのある本体形状と安全設計を確認して選びたい人向け'

const faqEntries = [
  {question: 'PCJ-A080とPCM-A080の違いは？', answer: 'タイガー公式の仕様では、PCJ-A080は容量0.8L、カップ1杯約45秒、サイズ約14.8×22.3×19.8cm、質量約0.90kgです。PCM-A080は容量0.8L、カップ1杯約60秒、サイズ約16.1×21.3×18.5cm、質量約0.93kgです。'},
  {question: 'カップ1杯を早く沸かせるのはどちら？', answer: '公式仕様のカップ1杯（約140mL）の沸とう時間は、PCJ-A080が約45秒、PCM-A080が約60秒です。水温・室温23度での表記です。'},
  {question: 'どちらも安全設計ですか？', answer: '両方の公式ページに、通電自動オフ・転倒時のお湯漏れを抑える構造・カラだき防止などの安全設計が記載されています。PCJ-A080は蒸気レス構造も確認できます。'},
  {question: '楽天市場の価格は掲載していますか？', answer: '価格・在庫・送料・ポイントは販売先で変わるため、記事内の楽天市場リンクで購入時点の表示をご確認ください。'},
] as const

const keyDiffRows: KeyDiffRow[] = [
  {label: '容量', left: '0.8L', right: '0.8L', highlight: null},
  {label: 'カップ1杯の沸とう時間', left: '約45秒', right: '約60秒', highlight: 'left', highlightNote: '約15秒短い'},
  {label: 'サイズ（幅×奥行×高さ）', left: '約14.8×22.3×19.8cm', right: '約16.1×21.3×18.5cm', highlight: null},
  {label: '本体質量', left: '約0.90kg', right: '約0.93kg', highlight: 'left', highlightNote: '約30g軽い'},
  {label: '湯わかし時の消費電力', left: '1300W', right: '1300W', highlight: null},
]

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: 'タイガー 電気ケトル', line: 'PCJ-A080', tagline: '蒸気レス・速さなら', image: pcjImage, imageAlt: 'タイガー PCJ-A080', imageWidth: 498, imageHeight: 578, officialHref: pcjOfficial, guidePoints: [pcjAudience], purchaseHref: articlePurchaseLinks['tiger-pcj-a080-vs-pcm-a080:left'].purchaseUrl}}
  right={{brand: 'タイガー 電気ケトル', line: 'PCM-A080', tagline: '形状を確認するなら', image: pcmImage, imageAlt: 'タイガー PCM-A080', imageWidth: 498, imageHeight: 578, officialHref: pcmOfficial, guidePoints: [pcmAudience], purchaseHref: articlePurchaseLinks['tiger-pcj-a080-vs-pcm-a080:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"タイガーのPCJ-A080とPCM-A080を、メーカー公式ページで確認できる容量・沸とう時間・サイズ・質量・安全設計の範囲で比較します。"}
  officialDescription={"仕様の根拠は、タイガー魔法瓶公式の商品ページで2026年8月17日に確認しました。PCJ-A080には蒸気を外に出さない蒸気レス構造、PCM-A080には本体二重構造や転倒お湯漏れ防止構造が案内されています。"}
  officialLinks={[
    { label: "PCJ-A080 公式商品ページ", href: pcjOfficial },
    { label: "PCM-A080 公式商品ページ", href: pcmOfficial },
  ]}
  socialProofQuery={"タイガー PCJ-A080 PCM-A080"}
  faqEntries={faqEntries}
  leftPurchaseName={"タイガー PCJ-A080"}
  leftPurchaseAudience={pcjAudience}
  rightPurchaseName={"タイガー PCM-A080"}
  rightPurchaseAudience={pcmAudience}
  sourceLinks={[
    { label:"タイガー公式：PCJ-A080", href:pcjOfficial, checkedAt:"2026-08-17" },
    { label:"タイガー公式：PCM-A080", href:pcmOfficial, checkedAt:"2026-08-17" },
  ]}
/>
---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import RelatedArticles from '../../../components/RelatedArticles.astro'
import PurchaseCard from '../../../components/PurchaseCard.astro'
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro'
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro'
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro'
import {sharpKcS50VsFuS50Article as articleMetadata} from '../../../content/articles'
import type {KeyDiffRow} from '../../../components/VisualKeyDifferences.astro'

const leftOfficial = 'https://jp.sharp/kuusei/products/kcs50/'
const leftSpec = 'https://jp.sharp/kuusei/products/kcs50/spec/'
const rightOfficial = 'https://jp.sharp/kuusei/products/fus50/'
const rightSpec = 'https://jp.sharp/kuusei/products/fus50/spec/'
const leftSearch = 'https://a.r10.to/hgZ0mc'
const rightSearch = 'https://a.r10.to/hPyHPd'
const leftImage = '/products/sharp-kc-s50.jpg'
const rightImage = '/products/sharp-fu-s50.jpg'
const leftAudience = '加湿機能も使いたく、空気清浄と加湿を1台でまとめたい人向け'
const rightAudience = '加湿機能は不要で、より小型・軽量の本体とニオイセンサーを重視する人向け'
const faqEntries = [
  {question: 'KC-S50とFU-S50の大きな違いは？', answer: 'KC-S50は加湿機能を搭載し、最大加湿量は500mL/hです。FU-S50は加湿なしで、ニオイセンサーを搭載しています。'},
  {question: '空気清浄の適用畳数は違う？', answer: '空気清浄の適用畳数は、どちらも～23畳です。プラズマクラスター適用畳数はKC-S50が約13畳、FU-S50が約14畳です。'},
  {question: '本体が軽くて小さいのはどちら？', answer: 'FU-S50は外形383×209×540mm、約4.9kgです。KC-S50は399×230×613mm、約7.5kgなので、FU-S50の方が小さく軽量です。'},
  {question: '楽天市場の価格は比較できる？', answer: '価格・在庫・ポイント・送料は変動するため、型番検索ページで購入時点の表示を確認してください。'},
]
const keyDiffRows: KeyDiffRow[] = [
  {label: '加湿', left: 'あり', right: 'なし', highlight: 'left'},
  {label: '最大加湿量', left: '500mL/h', right: '—', highlight: 'left'},
  {label: '外形寸法', left: '399×230×613mm', right: '383×209×540mm', highlight: 'right'},
  {label: '本体重量', left: '約7.5kg', right: '約4.9kg', highlight: 'right', highlightNote: '約2.6kg軽い'},
  {label: 'ニオイセンサー', left: '—', right: 'あり', highlight: 'right'},
]
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 生活家電 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">シャープのKC-S50とFU-S50を、公式ページで確認できる加湿機能・最大加湿量・サイズ・重量・適用畳数・運転音・センサーで比較します。価格は販売先でご確認ください。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ"><a href="#key-differences">違い</a><a href="#decision-guide">どっち向き？</a><a href="#faq">FAQ</a></nav>
    <ArticleComparisonV2
      left={{brand: 'シャープ', line: 'KC-S50', tagline: '加湿も使うなら', image: leftImage, imageAlt: 'シャープ 加湿空気清浄機 KC-S50', officialHref: leftOfficial, guidePoints: [leftAudience]}}
      right={{brand: 'シャープ', line: 'FU-S50', tagline: '小型・軽量なら', image: rightImage, imageAlt: 'シャープ 空気清浄機 FU-S50', officialHref: rightOfficial, guidePoints: [rightAudience]}}
      rows={keyDiffRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
    />
    <p>加湿を1台で済ませたいならKC-S50、加湿が不要で本体の小ささ・軽さやニオイセンサーを重視するならFU-S50が候補です。空気清浄の適用畳数はどちらも～23畳です。</p>
    <div class="purchase-cards">
      <PurchaseCard name="シャープ KC-S50" audience={leftAudience} href={leftSearch} imagePath={leftImage} note="価格・在庫は販売先でご確認ください。" />
      <PurchaseCard name="シャープ FU-S50" audience={rightAudience} href={rightSearch} imagePath={rightImage} note="価格・在庫は販売先でご確認ください。" />
    </div>
    <details class="fold-section" id="specs" open><summary>詳細仕様（公式ページで確認した項目）</summary><div class="table-scroll"><table class="comparison"><thead><tr><th scope="col">比較項目</th><th scope="col">KC-S50</th><th scope="col">FU-S50</th><th scope="col">根拠</th></tr></thead><tbody>
      <tr><th scope="row">加湿・最大加湿量</th><td>あり・500mL/h</td><td>なし・—</td><td><a href={leftSpec} target="_blank" rel="noopener noreferrer">KC-S50仕様</a> / <a href={rightSpec} target="_blank" rel="noopener noreferrer">FU-S50仕様</a></td></tr>
      <tr><th scope="row">外形寸法</th><td>399×230×613mm</td><td>383×209×540mm</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">本体重量</th><td>約7.5kg</td><td>約4.9kg</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">プラズマクラスター適用畳数</th><td>約13畳</td><td>約14畳</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">空気清浄適用畳数</th><td>～23畳</td><td>～23畳</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">運転音（強・中・静音）</th><td>52・38・20dB</td><td>52・40・21dB</td><td>各公式仕様ページ</td></tr>
      <tr><th scope="row">ニオイセンサー</th><td>—</td><td>あり</td><td>各公式仕様ページ</td></tr>
    </tbody></table></div><p class="meta">価格・在庫・仕様は変更される可能性があります。購入時点の公式ページと販売ページを確認してください。</p></details>
    <h2 id="official">公式情報</h2><p>比較の根拠は、シャープ公式商品ページと各仕様ページで確認した情報です。KC-S50は加湿空気清浄機、FU-S50は空気清浄機として掲載されています。公式情報確認済み：{articleMetadata.productInfoCheckedAt}。</p>
    <div class="source-links"><a class="card-link" href={leftOfficial} target="_blank" rel="noopener noreferrer">KC-S50 公式商品ページ →</a><a class="card-link" href={rightOfficial} target="_blank" rel="noopener noreferrer">FU-S50 公式商品ページ →</a></div>
    <ArticleSocialProof query="シャープ KC-S50 FU-S50" checkedAt="2026-08-13" hasPosts={false} />
    <h2 id="faq">よくある質問</h2><div class="faq-list">{faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}</div>
    <h2>購入時の注意</h2><p>加湿の要否、本体サイズ・重量、運転音、センサーなど、設置場所と必要な機能を購入前に確認してください。価格・在庫・ポイント・送料は販売先で変わります。</p>
    <h2>更新履歴</h2><ol class="change-log">{articleMetadata.changeLog.map((entry) => <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>)}</ol>
    <h2>情報源一覧</h2><ul class="source-list"><li><a href={leftOfficial} target="_blank" rel="noopener noreferrer">シャープ KC-S50 公式商品ページ</a> / <a href={leftSpec} target="_blank" rel="noopener noreferrer">仕様</a>（2026-08-13確認）</li><li><a href={rightOfficial} target="_blank" rel="noopener noreferrer">シャープ FU-S50 公式商品ページ</a> / <a href={rightSpec} target="_blank" rel="noopener noreferrer">仕様</a>（2026-08-13確認）</li></ul>
    <h2>調査方法・免責事項</h2><p>この比較は、シャープ公式の商品ページと仕様ページで確認できる情報を根拠にしています。SNSの感想は比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

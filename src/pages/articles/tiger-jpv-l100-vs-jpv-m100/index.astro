---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {tigerRiceArticle as articleMetadata} from '../../../content/articles';

const lOfficial = 'https://www.tiger-corporation.com/ja/jpn/product/rice-cooker/jpv-l/';

const mOfficial = 'https://www.tiger-corporation.com/ja/jpn/product/rice-cooker/jpv-m/';

const lModel = {brand: 'タイガー', line: 'JPV-L100', image: '/products/tiger-jpv-l100.jpg', imageAlt: 'タイガー 圧力IHジャー炊飯器 JPV-L100', audience: '上位モデルの機能を優先する人の候補', official: lOfficial};

const mModel = {brand: 'タイガー', line: 'JPV-M100', image: '/products/tiger-jpv-m100.jpg', imageAlt: 'タイガー 圧力IHジャー炊飯器 JPV-M100', audience: '価格を抑えたエントリーモデルを選びたい人の候補', official: mOfficial};

const faqEntries = [
  {question: 'タイガー JPV-L100 と JPV-M100 の違いは？', answer: 'タイガー公式ページでは、どちらも5.5合の圧力IHジャー炊飯器です。JPV-L100は上位モデル、JPV-M100はエントリーモデルとして案内されています。公式オンライン価格はL100が57,800円から、M100が49,800円からです。'},
  {question: '炊飯容量やサイズ、重さは違う？', answer: '今回確認した5.5合モデルでは、容量はどちらも0.5〜5.5合、サイズは幅25.7×奥行38×高さ21.4cm、質量は約5.4kgです。'},
  {question: '価格が安いのはどっち？', answer: '公式オンラインページの表示価格では、JPV-M100が49,800円から、JPV-L100が57,800円からです。販売店の価格・在庫・ポイント・送料は購入時点で確認してください。'},
  {question: 'どちらを選べばよい？', answer: '公式ページ上の位置づけと価格を優先するなら、価格を抑えたJPV-M100が候補です。上位モデルの機能を優先するならJPV-L100を確認してください。'},
];

const keyDiffRows: KeyDiffRow[] = [
  {label: 'モデルの位置づけ', left: '上位モデル', right: 'エントリーモデル', highlight: 'left', highlightNote: '機能を優先'},
  {label: '炊飯方式・容量', left: '圧力IH・0.5〜5.5合', right: '圧力IH・0.5〜5.5合'},
  {label: '公式オンライン価格', left: '57,800円〜', right: '49,800円〜', highlight: 'right', highlightNote: '8,000円安い', bar: {left: 57800, right: 49800}, direction: 'lower-is-better'},
  {label: 'サイズ', left: '25.7×38×21.4cm', right: '25.7×38×21.4cm'},
  {label: '質量', left: '約5.4kg', right: '約5.4kg'},
];

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: lModel.brand, line: lModel.line, tagline: '上位モデルを選ぶなら', image: lModel.image, imageAlt: lModel.imageAlt, officialHref: lOfficial, guidePoints: [lModel.audience], purchaseHref: articlePurchaseLinks['tiger-jpv-l100-vs-jpv-m100:left'].purchaseUrl}}
  right={{brand: mModel.brand, line: mModel.line, tagline: '価格を抑えるなら', image: mModel.image, imageAlt: mModel.imageAlt, officialHref: mOfficial, guidePoints: [mModel.audience], purchaseHref: articlePurchaseLinks['tiger-jpv-l100-vs-jpv-m100:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"タイガーのJPV-L100とJPV-M100は、どちらも5.5合の圧力IHジャー炊飯器です。公式ページで確認できるモデルの位置づけ、価格、容量、サイズ、質量を分けて比較します。"}
  summaryParagraph={"JPV-L100は上位モデル、JPV-M100はエントリーモデルです。5.5合モデルの容量・サイズ・質量は同じで、公式オンライン価格はJPV-M100の方が低く表示されています。機能の詳細は各公式ページで確認してください。"}
  officialDescription={"タイガー公式ページでは、JPV-L100は圧力IHジャー炊飯器の上位モデル、JPV-M100はエントリーモデルとして案内されています。今回比較した100サイズは、どちらも5.5合炊きです。"}
  officialLinks={[
    { label: "JPV-L100 公式商品ページ", href: lOfficial },
    { label: "JPV-M100 公式商品ページ", href: mOfficial },
  ]}
  socialProofQuery={"タイガー JPV-L100 JPV-M100 炊飯器"}
  faqEntries={faqEntries}
  leftPurchaseName={"タイガー JPV-L100"}
  leftPurchaseAudience={lModel.audience}
  rightPurchaseName={"タイガー JPV-M100"}
  rightPurchaseAudience={mModel.audience}
  sourceLinks={[
    { label:"タイガー JPV-L100 公式商品ページ", href:lOfficial, checkedAt:"2026-08-13" },
    { label:"タイガー JPV-M100 公式商品ページ", href:mOfficial, checkedAt:"2026-08-13" },
  ]}
  purchaseWarning={"炊飯器は、炊飯容量、設置スペース、ふたを開けたときの高さ、炊飯メニュー、内なべの保証内容を購入前に公式ページで確認してください。価格や在庫は販売先で変わります。"}
  disclaimer={"この比較は、タイガー公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。"}
/>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {articleMetadata} from '../../content/articles';

const categories = [...new Set(articleMetadata.map((article) => article.category))].sort();
const tags = [...new Set(articleMetadata.flatMap((article) => article.tags))].sort();
const sorted = [...articleMetadata].sort((a, b) =>
  a.modifiedAt < b.modifiedAt ? 1 : a.modifiedAt > b.modifiedAt ? -1 : 0,
);
---
<BaseLayout title="比較記事一覧｜くらべる商品メモ" description="メーカー公式の情報で商品を比べる記事一覧">
  <section class="section wrap article-index" data-article-discovery>
    <p class="eyebrow">Comparison articles</p>
    <h1>比較記事一覧</h1>
    <p class="lead">確認できる公式情報と販売ページを起点に、商品を選ぶときの判断材料を整理しています。</p>

    <form class="article-filters" role="search" aria-label="比較記事を検索" data-discovery-form>
      <label>
        <span>キーワード</span>
        <input type="search" name="q" maxlength="100" autocomplete="off" placeholder="商品名・用途・悩みで検索" data-discovery-query />
      </label>
      <label>
        <span>カテゴリ</span>
        <select name="category" data-discovery-category>
          <option value="">すべて</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <label>
        <span>タグ</span>
        <select name="tag" data-discovery-tag>
          <option value="">すべて</option>
          {tags.map((tag) => <option value={tag}>{tag}</option>)}
        </select>
      </label>
      <button type="button" class="secondary-button" data-discovery-clear>条件をクリア</button>
    </form>
    <p class="meta" aria-live="polite" data-discovery-count>{articleMetadata.length}件の記事</p>

    <div class="article-list" data-discovery-results>
      {sorted.map((article) => (
        <article
          class={`card article-list-card${article.imagePath ? ' has-image' : ''}`}
          data-article-card
          data-search={[article.title, article.headline, article.summary, article.category, ...article.tags, ...article.audiences, ...article.uses].join(' ').normalize('NFKC').toLocaleLowerCase('ja-JP')}
          data-category={article.category}
          data-tags={JSON.stringify(article.tags)}
        >
          {article.imagePath && (
            <img class="card-thumb" src={article.imagePath} alt={article.headline} width="132" height="132" loading="lazy" />
          )}
          <div class="card-body">
            <span class="card-tag-row">
              <span class="tag">{article.category}</span>
            </span>
            <h2><a href={article.path}>{article.headline}</a></h2>
            <p class="card-desc">{article.summary}</p>
            <p class="meta">更新日 <time datetime={article.modifiedAt}>{article.modifiedAt}</time></p>
          </div>
        </article>
      ))}
    </div>
    <div class="card discovery-empty" hidden data-discovery-empty>
      <h2>条件に合う記事がありません</h2>
      <p>キーワードを短くするか、カテゴリ・タグをクリアしてください。</p>
      <button type="button" class="secondary-button" data-discovery-clear>条件をクリア</button>
    </div>
  </section>

  <script src="/scripts/article-discovery.js" defer is:inline></script>
</BaseLayout>

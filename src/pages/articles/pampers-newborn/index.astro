---
import { articlePurchaseLinks } from '../../../lib/products';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ExternalEmbed from '../../../components/ExternalEmbed.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {pampersNewbornArticle as articleMetadata} from '../../../content/articles';
import type {
  ComparisonCandidate, DifferenceRow,
} from '../../../lib/comparison';

const premium = 'https://www.jp.pampers.com/products/pampers-premium-line-tape';
const sarasara = 'https://www.jp.pampers.com/products/pampers-mainline-tape';

const premiumCandidate: ComparisonCandidate = {
  product: 'パンパース 新生児用',
  line: '肌へのいちばん',
  tone: 'premium',
  audience: '肌へのやさしさに関する機能を確認したい人の候補',
  note: '公式ページでサイズ・仕様を確認',
  status: 'official',
};

const standardCandidate: ComparisonCandidate = {
  product: 'パンパース 新生児用',
  line: 'さらさらケア',
  tone: 'standard',
  audience: 'モレ・ムレ対策の機能を確認したい人の候補',
  note: '公式ページでサイズ・仕様を確認',
  status: 'official',
};

const faqEntries = [
  {
    question: 'パンパースの新生児用テープはどっちがいい？',
    answer: '肌へのやさしさに関する機能（ゆるうんちを肌に残りにくくする設計・ワセリン配合シート・ふかふか肌ざわり）を確認するなら「肌へのいちばん」、モレ・ムレ対策の機能（360°ゆるうんちモレガード・のびのびフィットテープ・進化した吸収体）を確認するなら「さらさらケア」が候補です。どちらも新生児5kgまでのテープサイズが公式に案内されています。',
  },
  {
    question: '「肌へのいちばん」と「さらさらケア」は何が違う？',
    answer: '公式ページでは、肌へのいちばんは肌ざわりと肌へのやさしさ（ワセリン配合・ふかふか素材）、さらさらケアはおしっこ・ゆるうんちへの吸収とモレ対策（モレガード・吸収体）を中心に案内されています。新生児サイズはどちらも5kgまでで、小さめ新生児（3,000g）の表示もあるのは肌へのいちばんです。',
  },
  {
    question: '新生児用のサイズ選びの目安は？',
    answer: '公式では両方とも新生児サイズは5kgまでと案内されています。肌へのいちばんには小さめ新生児（3,000g）向けの表示もあります。実際の合いやすさは赤ちゃんの体型や肌状態でも変わるため、機能表示とサイズを確認して少量から試してください。',
  },
  {
    question: '価格や在庫はどこで確認できますか？',
    answer: 'このサイトでは価格・在庫を保証していません。楽天市場などの販売ページで、その時点の価格・在庫・送料・セット内容を確認してください。',
  },
];

const differenceRows: DifferenceRow[] = [
  {
    label: '公式が案内する主な機能',
    left: 'ゆるうんちを素早く吸収、ワセリン配合シート、ふかふか肌ざわり',
    right: 'ゆるうんちモレガード、のびのびフィットテープ、進化した吸収体',
    leftStatus: 'official',
    rightStatus: 'official',
  },
  {
    label: '新生児サイズ',
    left: '5kgまで。小さめ新生児3,000gも掲載',
    right: '5kgまで',
    leftStatus: 'official',
    rightStatus: 'official',
  },
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / おむつ · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">パンパースの新生児用テープ「肌へのいちばん」と「さらさらケア」を、公式商品ページで確認できる機能・サイズ展開で比較します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">結局どっち？</a>

      <a href="#faq">FAQ</a>
    </nav>
    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2
      left={{ brand: premiumCandidate.product, line: premiumCandidate.line, tagline: premiumCandidate.audience, image: '/products/pampers-premium-newborn.jpg', imageAlt: `${premiumCandidate.product} ${premiumCandidate.line}`, officialHref: premium, guidePoints: [premiumCandidate.audience], purchaseHref: articlePurchaseLinks['pampers-newborn:left'].purchaseUrl, productId: 'pampers-premium-newborn'}}
      right={{ brand: standardCandidate.product, line: standardCandidate.line, tagline: standardCandidate.audience, image: '/products/pampers-sarasara-newborn.jpg', imageAlt: `${standardCandidate.product} ${standardCandidate.line}`, officialHref: sarasara, guidePoints: [standardCandidate.audience], purchaseHref: articlePurchaseLinks['pampers-newborn:right'].purchaseUrl, productId: 'pampers-sarasara-newborn'}}
      rows={differenceRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
      purchaseLinkStatus={articleMetadata.purchaseLinkStatus}
      diagnosisHref="/tools/product-finder/diaper/"
    />


    <details class="fold-section" id="specs">
      <summary>詳細仕様（公式ページで確認した項目）</summary>
      <details class="source-toggle">
        <summary>根拠・確認先を表示</summary>
      </details>
      <div class="table-scroll">
      <table class="comparison">
        <thead><tr><th scope="col">比較項目</th><th scope="col">肌へのいちばん</th><th scope="col">さらさらケア</th><th scope="col">根拠・確認先</th></tr></thead>
        <tbody>
          <tr><th scope="row">公式上の位置づけ</th><td data-label="肌へのいちばん">肌にやさしいテープ</td><td data-label="さらさらケア">モレ・ムレ対策を案内するテープ</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
          <tr><th scope="row">新生児サイズ</th><td data-label="肌へのいちばん">5kg。小さめ新生児は3,000g</td><td data-label="さらさらケア">5kgまで</td><td data-label="根拠・確認先"><a href={premium} target="_blank" rel="noopener noreferrer">肌へのいちばん公式</a> / <a href={sarasara} target="_blank" rel="noopener noreferrer">さらさらケア公式</a></td></tr>
          <tr><th scope="row">主な機能</th><td data-label="肌へのいちばん">ゆるうんちを素早く吸収、ワセリン配合シート、ふかふか肌ざわり</td><td data-label="さらさらケア">360°ゆるうんちモレガード、のびのびフィットテープ、進化した吸収体</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
          <tr><th scope="row">価格・在庫</th><td data-label="肌へのいちばん">販売ページで確認</td><td data-label="さらさらケア">販売ページで確認</td><td data-label="根拠・確認先">楽天市場の検索結果</td></tr>
        </tbody>
      </table>
      </div>
      <p class="meta">商品仕様やサイズ展開は変更される可能性があります。購入時点の公式商品ページとパッケージを確認してください。</p>
    </details>

    <h2 id="official">公式情報</h2>
    <p>肌へのいちばんの公式ページでは、ゆるうんちを肌に残りにくくする設計、ワセリン配合シート、ふかふか素材が案内されています。さらさらケアの公式ページでは、ゆるうんちモレガード、フィットテープ、吸収体が案内されています。</p>
    <div class="source-links">
      <a class="card-link" href={premium} target="_blank" rel="noopener noreferrer">肌へのいちばん公式商品ページ →</a>
      <a class="card-link" href={sarasara} target="_blank" rel="noopener noreferrer">さらさらケア公式商品ページ →</a>
    </div>

    <ArticleSocialProof
      query="パンパース 肌へのいちばん さらさらケア"
      checkedAt="2026-08-12"
      hasPosts={true} bestMatch="series"
    >
      <div class="sns-embeds">
      <ExternalEmbed provider="x" match="series" url="https://x.com/i/status/1993099336415342914" title="パンパース 肌へのいちばん と さらさらケアについての投稿" purpose="2種類の違いに触れた個人投稿。使用感は個人差があるため、公式比較の根拠にはしません。" tone="mixed" autoload compact />
    </div>
    </ArticleSocialProof>

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>価格・在庫・販売条件は販売先で変わります。このサイトでは価格や在庫を保証しません。</p>
    <p>新生児用でも体重や体型には個人差があります。漏れや肌トラブルが続く場合は使用を中止し、必要に応じて専門家へ相談してください。</p>

    <div class="purchase-cards">
      <PurchaseCard
        name="肌へのいちばん"
        audience="肌ざわりと肌へのやさしさ（ワセリン配合・ふかふか素材）、小さめ新生児向けのサイズを優先する人向け"
        href={articlePurchaseLinks['pampers-newborn:left'].purchaseUrl}
        productId="pampers-premium-newborn"
        imagePath="/products/pampers-premium-newborn.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。" purchaseLinkStatus={articleMetadata.purchaseLinkStatus}/>
      <PurchaseCard
        name="さらさらケア"
        audience="モレ・ムレ対策（ゆるうんちモレガード・フィットテープ・吸収体）を優先する人向け"
        href={articlePurchaseLinks['pampers-newborn:right'].purchaseUrl}
        productId="pampers-sarasara-newborn"
        imagePath="/products/pampers-sarasara-newborn.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。" purchaseLinkStatus={articleMetadata.purchaseLinkStatus}/>
    </div>
    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog
        .slice()
        .sort((left, right) => right.date.localeCompare(left.date))
        .map((entry) => (
          <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
        ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={premium} target="_blank" rel="noopener noreferrer">パンパース：肌へのいちばん テープ</a>（2026-07-31確認）</li>
      <li><a href={sarasara} target="_blank" rel="noopener noreferrer">パンパース：さらさらケア テープ</a>（2026-07-31確認）</li>
      <li><a href={articlePurchaseLinks['pampers-newborn:left'].purchaseUrl} target="_blank" rel="noopener noreferrer">楽天市場：肌へのいちばん検索</a>（価格・在庫確認用）</li>
      <li><a href={articlePurchaseLinks['pampers-newborn:right'].purchaseUrl} target="_blank" rel="noopener noreferrer">楽天市場：さらさらケア検索</a>（価格・在庫確認用）</li>
    </ul>
    <h2>調査方法・免責事項</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式Q&Aで確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {thermosKfm020VsKfi020Article as articleMetadata} from '../../../content/articles';

const kfmOfficial = 'https://www.thermos.jp/product/series/kfm.html'

const kfiOfficial = 'https://www.thermos.jp/product/series/kfi.html'

const kfmImage = '/products/thermos-kfm-020.jpg'

const kfiImage = '/products/thermos-kfi-020.jpg'

const faqEntries = [
  {
    question: 'サーモス KFM-020 と KFI-020 はどっち？',
    answer: 'KFM-020はIH・ガス火の両方に対応する深型フライパンで、KFI-020はガス火専用の軽量モデルです。内径はどちらも約20cmですが、公式仕様ではKFM-020が約0.6kg、KFI-020が約0.4kgです。熱源と軽さのどちらを優先するかで確認する候補が変わります。',
  },
  {
    question: 'IHで使えるのはどっち？',
    answer: 'KFM-020は公式ページに「IH・ガスOK」と記載されています。KFI-020は「ガス火専用」と案内されているため、IHで使う候補にはKFM-020を選びます。',
  },
  {
    question: '軽いのはどっち？',
    answer: '公式仕様の本体重量は、KFM-020が約0.6kg、KFI-020が約0.4kgです。KFI-020の方が約0.2kg軽いと確認できます。',
  },
  {
    question: 'サイズと価格は違う？',
    answer: '内径はどちらも約20cmです。本体寸法はKFM-020が幅42.0×奥行21.5×高さ9.5cm、KFI-020が幅39.0×奥行21.0×高さ7.0cmです。メーカー希望小売価格はKFM-020が4,400円（税込）、KFI-020が3,520円（税込）と公式仕様に記載されています。',
  },
] as const

const keyDiffRows: KeyDiffRow[] = [
  {
    label: '対応熱源',
    left: 'IH・ガスOK',
    right: 'ガス火専用',
    highlight: 'left',
    highlightNote: 'IH対応',
  },
  {
    label: '本体重量',
    left: '約0.6kg',
    right: '約0.4kg',
    highlight: 'right',
    highlightNote: '約0.2kg軽い',
    bar: {left: 0.6, right: 0.4},
  },
  {
    label: '本体寸法',
    left: '幅42.0×奥行21.5×高さ9.5cm',
    right: '幅39.0×奥行21.0×高さ7.0cm',
  },
  {
    label: '価格（メーカー希望小売価格）',
    left: '4,400円（税込）',
    right: '3,520円（税込）',
  },
]

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: 'サーモス', line: 'KFM-020', tagline: 'IH対応なら', image: kfmImage, imageAlt: 'サーモス KFM-020 フライパン', officialHref: kfmOfficial, guidePoints: ['IHでも使いたい', 'ガス火とIHの両方で使いたい', '深型タイプを選びたい'], purchaseHref: articlePurchaseLinks['thermos-kfm-020-vs-kfi-020:left'].purchaseUrl}}
  right={{brand: 'サーモス', line: 'KFI-020', tagline: '軽さなら', image: kfiImage, imageAlt: 'サーモス KFI-020 フライパン', officialHref: kfiOfficial, guidePoints: ['ガス火専用で使う', '片手で軽く扱いたい', '約0.4kgを優先したい'], purchaseHref: articlePurchaseLinks['thermos-kfm-020-vs-kfi-020:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"サーモスの約20cmフライパン「KFM-020」と「KFI-020」を比較します。メーカー公式ページで確認できる熱源、重量、寸法、価格を整理し、確認できない使用感や耐久性の推測は加えていません。"}
  socialProofQuery={"サーモス KFM-020 KFI-020 フライパン"}
  faqEntries={faqEntries}
  leftPurchaseName={"サーモス KFM-020"}
  leftPurchaseAudience={"IH・ガス火の両方で使いたい人向け"}
  rightPurchaseName={"サーモス KFI-020"}
  rightPurchaseAudience={"ガス火で軽いフライパンを使いたい人向け"}
  sourceLinks={[
    { label:"サーモス KFM 公式ページ", href:kfmOfficial, checkedAt:"2026-08-16" },
    { label:"サーモス KFI 公式ページ", href:kfiOfficial, checkedAt:"2026-08-16" },
  ]}
/>
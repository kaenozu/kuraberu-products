---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {cradleArticle as articleMetadata} from '../../../content/articles';
import {isContentStale} from '../../../lib/content-freshness';
import type {ComparisonCandidate, DifferenceRow} from '../../../lib/comparison';

const cradleProductUrl = 'https://a.r10.to/hgUiG0';
const cocoNelProductUrl = 'https://a.r10.to/h8tr4u';
const cradleRakutenUrl = import.meta.env.PUBLIC_RAKUTEN_BABYBJORN_CRADLE_URL;
const cocoNelRakutenUrl = import.meta.env.PUBLIC_RAKUTEN_APRICA_COCONEL_AIR_URL;

const faqEntries = [
  {
    "question": "ベビービョルン クレードルは新生児から使える？",
    "answer": "ベビービョルン公式の案内によると、クレードルは「新生児から生後6か月（8kg）までご利用いただけます」。メッシュ素材とキャノピー（別売り）で透けて見えるデザインで、両親が手や足で簡単に優しく揺らせます。対象範囲は購入前に公式ページで確認してください。"
  },
  {
    "question": "クレードルとココネルエアー、どっちを選べばいい？",
    "answer": "各メーカー公式の案内によると、クレードルは新生児〜生後6か月（8kgまで）の手動ゆりかご型ベビーベッドで、揺らして寝かしつけられるのが特長です。ココネルエアー AB は新生児（2.5kg）〜24カ月（13kgまで）まで使える折りたたみ式で、大きくなったらベビーサークルとしても使えます。使用期間の長さと揺れ機能の有無が最大の違いです。実際の使い心地は、公式情報だけでは判断できません。"
  },
  {
    "question": "クレードルのサイズと重量は？",
    "answer": "ベビービョルン公式楽天市場店の案内によると、本体は幅約79×奥行約58×高さ約65cm、重量は約8kgです。公式は「軽量で女性でも簡単に移動させることができます」と案内しています。"
  },
  {
    "question": "ココネルエアー AB は折りたためる？",
    "answer": "アップリカ公式楽天市場店の案内によると、ココネルエアー AB は「カンタンに折りたたんで持ち運ぶことができる」構造で、閉じた状態は幅約260×奥行約260×高さ約951mm、収納袋付きです。帰省先や旅行先でも使えます。"
  },
  {
    "question": "クレードルとココネルエアーの価格はいくら？",
    "answer": "2026-08-10時点の確認では、ベビービョルン公式楽天市場店でクレードルが49,500円（送料無料）、アップリカ公式楽天市場店でココネルエアー AB が29,700円でした（他店では26,000円台〜の出品あり）。在庫やキャンペーンにより変動するため、購入時点の販売ページで確認してください。"
  },
  {
    "question": "ココネルエアーは安全基準を取得している？",
    "answer": "アップリカ公式楽天市場店の案内によると、ココネルエアー AB は PSCマーク取得品・製品安全協会乳幼児用ベッドSG合格品です。マットレス等を組み合わせて使用する場合は、周囲に隙間を生じないミニベッド用（サイズ60×90cm）のものを使用するよう案内されています。"
  }
];

const cradleCandidate: ComparisonCandidate = {
  product: 'ベビービョルン クレードル',
  line: 'クレードル',
  tone: 'premium',
  audience: '新生児期の揺らして寝かしつけを重視する人の候補',
  note: '手動ゆりかご型・新生児〜6か月（8kg）・メッシュ素材・約8kg',
  status: 'official',
};

const cocoNelCandidate: ComparisonCandidate = {
  product: 'アップリカ ココネルエアー AB',
  line: 'ココネルエアー AB',
  tone: 'standard',
  audience: '長く使えて折りたためるベビーベッドを探す人の候補',
  note: '新生児〜24カ月（13kg）・折りたたみ式・サークル兼用・収納袋付き',
  status: 'official',
};


const contentAsOf = new Date().toISOString().slice(0, 10);
const productInfoStale = isContentStale(articleMetadata.productInfoCheckedAt, contentAsOf);

const differenceRows: DifferenceRow[] = [
  {
    "label": "使用できる期間",
    "left": "新生児〜生後6か月（体重8kgまで）。使用期間は短めのゆりかご型。",
    "right": "新生児（2.5kg）〜24カ月（13kgまで）。上段・下段の2段階で長く使える。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "揺れ（ゆりかご機能）",
    "left": "両親が手や足で簡単に優しく揺らせることができる。「制御された、やさしい、はずみのある動き」を作り出す構造。",
    "right": "公式案内に揺れ機能の記載なし（固定式）。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "サイズ",
    "left": "本体 幅約79×奥行約58×高さ約65cm。マットレス 幅約71×奥行き約36×厚さ約3cm。",
    "right": "開いた状態 幅約1052×奥行約704×高さ約951mm。閉じた状態 幅約260×奥行約260×高さ約951mm。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "重量・持ち運び",
    "left": "約8kg。「軽量で女性でも簡単に移動させることができます」（公式案内）。",
    "right": "約14.5kg（収納袋を除く）。キャスター付きで移動できるが、クレードルより大きく重い。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "折りたたみ・収納",
    "left": "公式案内に折りたたみ・収納袋の記載なし（据え置き型）。",
    "right": "カンタンに折りたたんで持ち運べる。収納袋付き。帰省・旅行にも使える。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "多用途（サークル兼用など）",
    "left": "新生児期のベッド用途のみ。キャノピー（天蓋）は別売り。",
    "right": "大きくなったらベビーサークルとしても使える。おむつ替えやお掃除のときの一時置きにも。",
    "leftStatus": "official",
    "rightStatus": "official"
  },
  {
    "label": "安全基準・価格（2026-08-10確認）",
    "left": "49,500円（送料無料）。",
    "right": "PSCマーク・乳幼児用ベッドSG合格品。29,700円（他店26,000円台〜）。",
    "leftStatus": "official",
    "rightStatus": "official"
  }
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 育児用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">ベビービョルン クレードルとアップリカ ココネルエアー AB は、どちらも新生児期のベビーベッドです。最大の違いは、使用できる期間と揺れ（ゆりかご機能）の有無です。クレードルは新生児〜生後6か月の手動ゆりかご型、ココネルエアー AB は新生児〜24カ月まで使える折りたたみ式で、ベビーサークルとしても使えます。この記事では、ベビービョルン公式楽天市場店とアップリカ公式楽天市場店で2026年8月10日時点に確認できた情報だけを使って比較します。公式ページに記載されていることは「確認できること」として整理し、使用感や実際の寝心地など、公式情報だけでは判断できないことは推測しません。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">どっち向き？</a>

      <a href="#faq">FAQ</a>
    </nav>
    <div class="purchase-cards">
      <PurchaseCard
        name="クレードル"
        audience="手動のゆりかご機能で揺らして寝かしつけたい、新生児期の使用を優先する人向け"
        href={cradleRakutenUrl}
        productId="babybjorn-cradle"
        imagePath="/products/babybjorn-cradle.jpg"
        placement="after-decision"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="ココネルエアー AB"
        audience="新生児〜24カ月まで長く使えて、折りたたみ・ベビーサークル兼用を優先する人向け"
        href={cocoNelRakutenUrl}
        productId="aprica-coconel-air"
        imagePath="/products/aprica-coconel-air.jpg"
        placement="after-decision"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>
    <div class="verification-summary" aria-label="記事情報の確認状況">
      <p>商品情報確認日: <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time></p>
      {productInfoStale && <p class="notice">商品情報の確認から時間が経過しています。購入前に公式ページで最新仕様を確認してください。</p>}
    </div>
    <p class="notice">広告表示：この記事には広告リンクを含みます。価格・在庫は販売先で、仕様は公式ページで確認してください。</p>

    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2
      left={{ brand: cradleCandidate.product, line: cradleCandidate.line, tagline: cradleCandidate.audience, image: '/products/babybjorn-cradle.jpg', imageAlt: `${cradleCandidate.product} ${cradleCandidate.line}`, officialHref: cradleProductUrl, guidePoints: [cradleCandidate.audience] }}
      right={{ brand: cocoNelCandidate.product, line: cocoNelCandidate.line, tagline: cocoNelCandidate.audience, image: '/products/aprica-coconel-air.jpg', imageAlt: `${cocoNelCandidate.product} ${cocoNelCandidate.line}`, officialHref: cocoNelProductUrl, guidePoints: [cocoNelCandidate.audience] }}
      rows={differenceRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
    />


    <h2 id="official">公式情報</h2>
    <p>ここでは、ベビービョルン公式楽天市場店・アップリカ公式楽天市場店の商品ページで確認できた内容を整理します。使用感・実際の寝心地・赤ちゃんの反応など、公式情報だけでは確認できないことは書いていません。</p>
    <h3>ベビービョルン クレードル で公式に確認できること</h3>
    <ul class="official-list">
      <li>「優しい揺れに包まれて」をコンセプトに、両親が手や足で簡単に優しく揺らせてあげることができます（公式商品ページ）。</li>
      <li>対象は「新生児から生後6か月（8kg）までご利用いただけます」。</li>
      <li>メッシュ素材とキャノピー（別売り）は、透けて見えるメッシュ素材。制御された、やさしい、はずみのある動きを作り出します。隙間のない安全なデザイン（公式商品ページ）。</li>
      <li>製品サイズは本体 幅約79×奥行約58×高さ約65cm、マットレス 幅約71×奥行き約36×厚さ約3cm。製品重量は約8kg（公式商品ページ）。</li>
      <li>素材は本体がポリエステル100%・木（ブナ木）、マットレスがポリエステルフォーム100%（マットカバー付き）。</li>
      <li>「軽量で女性でも簡単に移動させることができます」（公式商品ページ）。</li>
      <li>2026-08-10時点の公式楽天市場店の表示価格は49,500円（送料無料）。</li>
    </ul>
    <h3>アップリカ ココネルエアー AB で公式に確認できること</h3>
    <ul class="official-list">
      <li>「コンパクトに折りたためる構造でありながら、PSC・SGマークを取得した安心・安全なベビーベッド」（公式商品ページ）。</li>
      <li>使用期間は「新生児（体重2.5kg）〜24カ月（体重13kg）まで」。上段：新生児〜つかまり立ちできる頃（概ね生後5カ月）、下段：つかまり立ちできる頃〜24カ月まで。</li>
      <li>通気性のある「やわらかマット」と「安心メッシュガード」を採用。</li>
      <li>カンタンに折りたたんで持ち運ぶことができ、帰省先や旅行先でも使える。収納袋付き。</li>
      <li>サイズは開いた状態 幅約1052×奥行約704×高さ約951mm、閉じた状態 幅約260×奥行約260×高さ約951mm。重さは約14.5kg（収納袋を除く）。</li>
      <li>キャスター付き。大きくなったらベビーサークルとしても使える。おむつ替えやお掃除のときの一時置きにも。</li>
      <li>PSCマーク取得品・製品安全協会乳幼児用ベッドSG合格品。マットレス等と組み合わせる場合は周囲に隙間を生じないミニベッド用（サイズ60×90cm）のものを使用。</li>
      <li>2026-08-10時点のアップリカ公式楽天市場店の表示価格は29,700円。</li>
    </ul>

    <ArticleSocialProof
      query="ベビービョルン クレードル ココネル"
      checkedAt="2026-08-12"
      hasPosts={false}
    />

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>この記事で記載した価格は、2026年8月10日時点で確認したベビービョルン公式楽天市場店・アップリカ公式楽天市場店の表示価格です。楽天市場など他のショップでは、販売価格、ポイント還元、送料、セット内容などが変わる場合があります。購入時は、商品名、カラー、付属品を販売ページで確認してください。また、ベビーベッドの安全性と正しい使用方法は必ず各メーカーの公式ページ・使用説明書で確認してください。</p>

    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog.slice().sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
      ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={cradleProductUrl} target="_blank" rel="noopener noreferrer">ベビービョルン クレードル（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={cocoNelProductUrl} target="_blank" rel="noopener noreferrer">ココネルエアー AB（アップリカ公式楽天市場店）</a>（2026-08-10確認）</li>
    </ul>
    <h2>調査方法・免責</h2>
    <p>本記事は、2026-08-10時点で各メーカー公式楽天市場店の商品ページに記載されていた情報をもとに作成しています。商品情報は確認日時点のものであり、その後の仕様変更・価格変動・販売終了の可能性があります。ご購入の際は必ずご自身で公式情報・販売ページをご確認ください。</p>
    <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
  </article>
</BaseLayout>

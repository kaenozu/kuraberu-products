---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import TrustLine from '../../../components/TrustLine.astro';
import {panasonicEhNa9mGuideArticle as articleMetadata} from '../../../content/articles';
import { articlePurchaseLinks } from '../../../lib/products';

const officialPage = 'https://panasonic.jp/hair/products/EH-NA9M.html';
const officialSpec = 'https://panasonic.jp/hair/products/EH-NA9M/spec.html';

const faqEntries = [
  {
    question: 'EH-NA9Mはどんなドライヤー？',
    answer:
      'パナソニック ナノケアの上位モデルです。ミネラル・UVケア・ナノイーイオンチャージPLUSを搭載し、温冷リズム・毛先集中ケア・スカルプ・スキンのモードが公式に案内されています。',
  },
  {
    question: '風量はどれくらい？',
    answer:
      '公式仕様ではTURBO時1.5㎥/分です。風量の値だけなら下位モデルのEH-NA7M（同じく1.5㎥/分）と同じです。',
  },
  {
    question: '重さやサイズは？',
    answer:
      '質量は約580g、本体寸法は高さ22.1×幅16.1×奥行7.4cm（公式仕様）です。折りたたみタイプのEH-NA7M（約565g）と比べると約15g重いです。',
  },
  {
    question: 'EH-NA7Mと何が違う？',
    answer:
      'EH-NA9Mはミネラル・UVケア・複数モードを搭載する一方、EH-NA7Mは折りたためる点が公式比較で案内されています。どちらにするか迷う場合は「パナソニック ナノケア EH-NA9MとEH-NA7M」の比較記事も確認してください。',
  },
  {
    question: '価格や在庫は？',
    answer:
      'この記事の購入導線は楽天市場の型番検索です。価格・在庫・ポイント・送料は変動するため、購入時点の販売ページで確認してください。',
  },
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 美容家電 · 商品ガイド · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <TrustLine checkedAt={articleMetadata.productInfoCheckedAt} />
    <p class="lead">パナソニック ナノケア EH-NA9Mは、ミネラル・UVケア・複数モードを搭載した上位モデルのドライヤーです。公式仕様ではTURBO時1.5㎥/分の風量で、質量は約580gです。この記事では、パナソニック公式ページで2026年8月16日時点に確認できた情報だけを使って、この製品の特徴と向いている人を整理します。公式ページに記載されていることは「確認できること」として扱い、使用感など公式情報だけでは判断できないことは推測しません。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#conclusion">向いている人</a>
      <a href="#official">公式情報</a>
      <a href="#faq">FAQ</a>
    </nav>

    <section id="conclusion">
      <h2>どんな人に向いている？</h2>
      <p>公式ページで確認できる機能から整理すると、EH-NA9Mは次のような人に向いています。</p>
      <ul class="official-list">
        <li>ミネラル・UVケア・ナノイーイオンチャージPLUSなど、髪のケア機能を重視する人</li>
        <li>温冷リズム・毛先集中ケア・スカルプ・スキンの複数モードを使い分けたい人</li>
        <li>公式仕様でTURBO時1.5㎥/分の風量を持つ上位モデルを探している人</li>
      </ul>
      <p>一方で、折りたたみやすさを重視する場合は、公式比較ではEH-NA9Mに折りたたみの案内がありません。持ち運びや収納性を優先するなら、折りたためるタイプのEH-NA7Mとの比較記事も確認してください。製品選びの前に、公式ページや販売ページで最新の情報を確認してください。</p>
    </section>

    <h2 id="official">公式情報</h2>
    <p>ここでは、パナソニック公式ページ（EH-NA9M 商品ページ・仕様ページ）で確認できた内容を整理します。使用感や実際の乾かしやすさなど、公式情報だけでは確認できないことは書いていません。</p>
    <h3>EH-NA9Mで公式に確認できること</h3>
    <ul class="official-list">
      <li>ミネラル・UVケア・ナノイーイオンチャージPLUSを搭載している。</li>
      <li>温冷リズム・毛先集中ケア・スカルプ・スキンのモードを備えている。</li>
      <li>風量はTURBO時1.5㎥/分（公式仕様）。</li>
      <li>質量は約580g（公式仕様）。</li>
      <li>本体寸法は高さ22.1×幅16.1×奥行7.4cm（公式仕様）。</li>
    </ul>

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>ドライヤーは機能の名称だけで使用感を断定できません。価格・在庫・付属品は購入時点の公式ページと販売先で確認してください。</p>

    <div class="purchase-cards">
      <PurchaseCard
        name="パナソニック ナノケア EH-NA9M"
        audience="髪のケア機能と複数モードを重視する人向け"
        href={articlePurchaseLinks['panasonic-eh-na9m-guide:card'].purchaseUrl}
        productId="panasonic-eh-na9m"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
        purchaseLinkStatus={articleMetadata.purchaseLinkStatus}
      />
    </div>
    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog.slice().sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
      ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={officialPage} target="_blank" rel="noopener noreferrer">パナソニック EH-NA9M 公式商品ページ</a>（2026-08-16確認）</li>
      <li><a href={officialSpec} target="_blank" rel="noopener noreferrer">パナソニック EH-NA9M 仕様ページ</a>（2026-08-16確認）</li>
      <li><a href={articlePurchaseLinks['panasonic-eh-na9m-guide:card'].purchaseUrl} target="_blank" rel="noopener noreferrer">楽天市場：パナソニック ナノケア EH-NA9M</a>（価格・在庫用）</li>
    </ul>
    <h2>調査方法・免責</h2>
    <p>このサイトの記事は、メーカー公式の商品ページ・公式Q&Aで確認できる情報のみを根拠としています。個人の感想や口コミは根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

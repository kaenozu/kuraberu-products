---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {tefalKettleArticle as articleMetadata} from '../../../content/articles';

const leftOfficial = 'https://www.t-fal.co.jp/kettle/products/justine-lock-7211419308/'

const rightOfficial = 'https://www.t-fal.co.jp/kettle/products/aprecia-lock-control-7211419696/'

const leftImage = '/products/tefal-ko5901jp.jpg'

const rightImage = '/products/tefal-ko8601j0.jpg'

const leftAudience = '容量1.2Lで、温度調節や保温より一度に沸かせる量を優先する人向け'

const rightAudience = '温度調節・保温・タッチパネル・給湯ロックを使いたい人向け'

const faqEntries = [
  {question: 'KO5901JPとKO8601J0の大きな違いは？', answer: '公式ページで確認できる主な違いは、容量がKO5901JPの1,200mL、KO8601J0の800mLであること、そしてKO8601J0には温度調節・保温・タッチパネル・給湯ロックボタンがあることです。'},
  {question: '本体重量はどちらが軽い？', answer: 'KO5901JPは約900g、KO8601J0は約790gです。公式記載の本体重量ではKO8601J0の方が軽いです。'},
  {question: '消費電力や安全機能は違う？', answer: '定格消費電力はどちらも1,250Wです。自動電源オフと空焚き防止も、公式ページで両方に搭載されていることを確認しています。'},
  {question: '楽天市場の価格は比較できる？', answer: '価格・在庫・ポイント・送料は変動するため、型番検索ページで購入時点の表示を確認してください。この記事では特定価格を掲載していません。'},
]

const keyDiffRows: KeyDiffRow[] = [
  {label: '容量', left: '1,200mL', right: '800mL', highlight: 'left', highlightNote: '400mL多い'},
  {label: '本体重量', left: '約900g', right: '約790g', highlight: 'right', highlightNote: '約110g軽い'},
  {label: '温度調節', left: 'なし', right: 'あり', highlight: 'right'},
  {label: '保温', left: 'なし', right: 'あり', highlight: 'right'},
  {label: 'タッチパネル・給湯ロック', left: 'なし', right: 'あり', highlight: 'right'},
]

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: 'ティファール', line: 'KO5901JP', tagline: '容量を優先するなら', image: leftImage, imageAlt: 'ティファール ジャスティン ロック ホワイト KO5901JP', officialHref: leftOfficial, guidePoints: [leftAudience], purchaseHref: articlePurchaseLinks['tefal-ko5901jp-vs-ko8601j0:left'].purchaseUrl}}
  right={{brand: 'ティファール', line: 'KO8601J0', tagline: '温度調節を使うなら', image: rightImage, imageAlt: 'ティファール アプレシア ロック コントロール ホワイト KO8601J0', officialHref: rightOfficial, guidePoints: [rightAudience], purchaseHref: articlePurchaseLinks['tefal-ko5901jp-vs-ko8601j0:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"ティファールの電気ケトル2機種を、公式ページで確認できる容量・重量・温度調節・保温・安全機能に分けて比較します。価格は販売先でご確認ください。"}
  summaryParagraph={"一度に多めに沸かしたいなら1,200mLのKO5901JP、温度を使い分けたり保温したりしたいなら800mLのKO8601J0が候補です。これは公式ページで確認した仕様差にもとづく選び分けです。"}
  officialDescription={"比較の根拠は、ティファール公式商品ページで確認した仕様です。KO5901JPはジャスティン ロック ホワイト、KO8601J0はアプレシア ロック コントロール ホワイトとして掲載されています。"}
  officialLinks={[
    { label: "KO5901JP 公式商品ページ", href: leftOfficial },
    { label: "KO8601J0 公式商品ページ", href: rightOfficial },
  ]}
  socialProofQuery={"ティファール KO5901JP KO8601J0"}
  faqEntries={faqEntries}
  leftPurchaseName={"ティファール KO5901JP"}
  leftPurchaseAudience={leftAudience}
  rightPurchaseName={"ティファール KO8601J0"}
  rightPurchaseAudience={rightAudience}
  sourceLinks={[
    { label:"ティファール ジャスティン ロック KO5901JP 公式商品ページ", href:leftOfficial, checkedAt:"2026-08-13" },
    { label:"ティファール アプレシア ロック コントロール KO8601J0 公式商品ページ", href:rightOfficial, checkedAt:"2026-08-13" },
  ]}
  purchaseWarning={"容量、温度調節、保温、給湯ロックなど、必要な機能を購入前に確認してください。価格・在庫・ポイント・送料は販売先で変わります。"}
  disclaimer={"この比較は、ティファール公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。"}
/>
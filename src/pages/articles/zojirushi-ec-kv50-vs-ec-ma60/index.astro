---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {zojirushiCoffeeArticle as articleMetadata} from '../../../content/articles';

const kvOfficial = 'https://www.zojirushi.co.jp/syohin/kitchen/coffee_maker/ec-kv/'

const maOfficial = 'https://www.zojirushi.co.jp/syohin/kitchen/coffee_maker/ec-ma/'

const kvModel = {brand: '象印', line: 'EC-KV50', image: '/products/zojirushi-ec-kv50.png', imageAlt: '象印 コーヒーメーカー EC-KV50', audience: 'ステンレスサーバーと3段階の濃度調節を確認したい人向け'}

const maModel = {brand: '象印', line: 'EC-MA60', image: '/products/zojirushi-ec-ma60.png', imageAlt: '象印 コーヒーメーカー EC-MA60', audience: '容量と本体のコンパクトさを確認したい人向け'}

const faqEntries = [
  {question: '象印 EC-KV50 と EC-MA60 の違いは？', answer: '公式仕様では、EC-KV50は容量675mL・カップ5杯タイプ（カップ1杯約120mL）で、3段階濃度調節とステンレスサーバーを採用しています。EC-MA60は容量810mL・カップ6杯タイプ（カップ1杯約120mL）で、2段階濃度調節とガラス容器を採用しています。'},
  {question: 'サイズと重さはどちらが小さい？', answer: '公式仕様では、EC-MA60は幅23×奥行15.5×高さ28cm、約1.7kgです。EC-KV50は幅24×奥行16.5×高さ31.5cm、約2.4kgです。'},
  {question: '濃さを細かく選べるのはどっち？', answer: 'EC-KV50は公式ページで「マイルド」「レギュラー」「ストロング」の3段階濃度調節を案内しています。EC-MA60は2段階濃度調節タイプです。'},
]

const keyDiffRows: KeyDiffRow[] = [
  // 容量とカップタイプは公式の「カップ1杯約120mL」を基準に比較できるが、
  // どちらが多い方が良いとは限らないため優劣表示はしない（別項目に分離）。
  {label: 'カップタイプ', left: '5杯', right: '6杯', highlight: null},
  {label: '容量', left: '675mL', right: '810mL', highlight: null},
  {label: '濃度調節', left: '3段階', right: '2段階', highlight: 'left', highlightNote: '選択肢が多い'},
  {label: 'サーバー・容器', left: 'ステンレスサーバー', right: 'ガラス容器'},
  {label: '外形寸法', left: '24×16.5×31.5cm', right: '23×15.5×28cm', highlight: 'right', highlightNote: '小さめ'},
  {label: '質量', left: '約2.4kg', right: '約1.7kg', highlight: 'right', highlightNote: '約0.7kg軽い'},
]

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: kvModel.brand, line: kvModel.line, tagline: '濃さの選択肢なら', image: kvModel.image, imageAlt: kvModel.imageAlt, officialHref: kvOfficial, guidePoints: [kvModel.audience], purchaseHref: articlePurchaseLinks['zojirushi-ec-kv50-vs-ec-ma60:left'].purchaseUrl}}
  right={{brand: maModel.brand, line: maModel.line, tagline: '小ささ・軽さなら', image: maModel.image, imageAlt: maModel.imageAlt, officialHref: maOfficial, guidePoints: [maModel.audience], purchaseHref: articlePurchaseLinks['zojirushi-ec-kv50-vs-ec-ma60:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"象印のEC-KV50とEC-MA60は、容量や抽出方法、濃度調節、本体サイズが異なるコーヒーメーカーです。この記事では、象印公式ページで確認できる仕様と、まだ販売先で確認が必要な情報を分けて整理します。"}
  summaryParagraph={"EC-KV50はステンレスサーバーと3段階濃度調節、EC-MA60はコンパクトな本体と2段階濃度調節が特徴です。容量の表記は公式ページのタイプ表示と仕様表で異なるため、購入前に必要な抽出量を確認してください。"}
  officialDescription={"象印公式ページでは、EC-KV50はステンレスサーバーや3段階濃度調節、EC-MA60は断熱スイングバスケットによる高温抽出や2段階濃度調節を案内しています。"}
  officialLinks={[
    { label: "EC-KV50 公式商品ページ", href: kvOfficial },
    { label: "EC-MA60 公式商品ページ", href: maOfficial },
  ]}
  socialProofQuery={"象印 EC-KV50 EC-MA60 コーヒーメーカー"}
  faqEntries={faqEntries}
  leftPurchaseName={"象印 EC-KV50"}
  leftPurchaseAudience={kvModel.audience}
  rightPurchaseName={"象印 EC-MA60"}
  rightPurchaseAudience={maModel.audience}
  sourceLinks={[
    { label:"象印 EC-KV50 公式商品ページ", href:kvOfficial, checkedAt:"2026-08-18" },
    { label:"象印 EC-MA60 公式商品ページ", href:maOfficial, checkedAt:"2026-08-18" },
  ]}
  purchaseWarning={"コーヒーメーカーは、必要な抽出量、サーバーの材質、濃度調節の段階、設置スペースを購入前に公式ページで確認してください。価格や在庫は販売先で変わります。"}
  disclaimer={"この比較は、象印公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。"}
/>
---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {yamazakiCondorWagonArticle as articleMetadata} from '../../../content/articles';

const meshOfficial = 'https://product.yamazaki-sangyo.co.jp/product/209460'

const selfOfficial = 'https://product.yamazaki-sangyo.co.jp/product/209477'

const meshImage = '/products/yamazaki-condor-fu943-000x-mb.jpg'

const selfImage = '/products/yamazaki-condor-fu944-000x-mb.jpg'

const meshAudience = '飲食店などで、荷物をメッシュ面のワゴンに置きたい人向け'

const selfAudience = '荷物置きとして、幅を抑えたワゴンを選びたい人向け'

const faqEntries = [
  {question: 'FU943-000X-MBとFU944-000X-MBの違いは？', answer: '公式商品ページで確認できる主な違いは、FU943が幅435×奥行260×高さ500mm・約1.4kg、FU944が幅430×奥行300×高さ485mm・約1.1kgであることです。商品名もFU943はサイドメッシュワゴンII、FU944はセルフワゴンIIです。'},
  {question: '軽いのはどちら？', answer: 'メーカー公式ページの重量表記では、FU944-000X-MBが約1.1kg、FU943-000X-MBが約1.4kgです。数値だけではFU944の方が約0.3kg軽いです。'},
  {question: 'どちらも折りたたみできますか？', answer: 'FU943-000X-MBの公式説明には折りたたみ式サイドワゴンと記載があります。FU944-000X-MBについては、この記事では公式ページで確認できたサイズ・重量などを比較し、折りたたみ可否は断定していません。'},
  {question: '楽天市場の価格は掲載していますか？', answer: '価格・在庫・送料・ポイントは販売先で変わるため、楽天市場の型番検索ページで購入時点の表示を確認してください。この記事では特定価格を掲載していません。'},
] as const

const keyDiffRows: KeyDiffRow[] = [
  {label: '商品名', left: 'サイドメッシュワゴンII', right: 'セルフワゴンII', highlight: null},
  {label: 'サイズ（幅×奥行×高さ）', left: '435×260×500mm', right: '430×300×485mm', highlight: null},
  {label: '重量', left: '約1.4kg', right: '約1.1kg', highlight: 'right', highlightNote: '約0.3kg軽い'},
  {label: '材質・成分', left: 'スチール粉体塗装', right: 'スチール粉体塗装', highlight: null},
  {label: '公式説明', left: '折りたたみ式サイドワゴン', right: '荷物置き', highlight: null},
]

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: '山崎産業 コンドル', line: 'FU943-000X-MB', tagline: 'サイドメッシュのワゴンなら', image: meshImage, imageAlt: '山崎産業 コンドル サイドメッシュワゴンII FU943-000X-MB', officialHref: meshOfficial, guidePoints: [meshAudience], purchaseHref: articlePurchaseLinks['yamazaki-condor-wagon-vs-self-wagon:left'].purchaseUrl}}
  right={{brand: '山崎産業 コンドル', line: 'FU944-000X-MB', tagline: '軽さを優先するなら', image: selfImage, imageAlt: '山崎産業 コンドル セルフワゴンII FU944-000X-MB', officialHref: selfOfficial, guidePoints: [selfAudience], purchaseHref: articlePurchaseLinks['yamazaki-condor-wagon-vs-self-wagon:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"山崎産業 コンドルのサイドメッシュワゴンIIとセルフワゴンIIを、メーカー公式ページで確認できる商品名・サイズ・重量・材質・説明の範囲で比較します。"}
  summaryParagraph={"サイドメッシュワゴンIIは公式説明に折りたたみ式とあり、セルフワゴンIIは今回確認した公式ページ上で約1.1kgと案内されています。設置場所に必要な幅・奥行・高さと、商品の説明を照らし合わせて選んでください。"}
  officialDescription={"仕様の根拠は、山崎産業公式の商品ページで2026年8月14日に確認しました。FU943は商品ページに「折りたたみ式サイドワゴン」と記載されています。"}
  officialLinks={[
    { label: "FU943-000X-MB 公式商品ページ", href: meshOfficial },
    { label: "FU944-000X-MB 公式商品ページ", href: selfOfficial },
  ]}
  socialProofQuery={"山崎産業 コンドル サイドメッシュワゴンII セルフワゴンII"}
  faqEntries={faqEntries}
  leftPurchaseName={"コンドル サイドメッシュワゴンII FU943-000X-MB"}
  leftPurchaseAudience={meshAudience}
  rightPurchaseName={"コンドル セルフワゴンII FU944-000X-MB"}
  rightPurchaseAudience={selfAudience}
  sourceLinks={[
    { label:"山崎産業公式：コンドル サイドメッシュワゴンII FU943-000X-MB", href:meshOfficial, checkedAt:"2026-08-14" },
    { label:"山崎産業公式：コンドル セルフワゴンII FU944-000X-MB", href:selfOfficial, checkedAt:"2026-08-14" },
  ]}
/>
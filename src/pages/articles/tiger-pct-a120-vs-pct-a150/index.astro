---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import { tigerPctA120VsPctA150Article as articleMetadata } from "../../../content/articles";

const official = "https://www.tiger-corporation.com/ja/jpn/product/kettle-pot/pct-a/";

const a120Model = {
  brand: "タイガー",
  line: "PCT-A120",
  image: "/products/tiger-pct-a120.jpg",
  imageAlt: "タイガー 電気ケトル PCT-A120",
  audience: "1.2Lの容量と本体の軽さを確認したい人向け",
};

const a150Model = {
  brand: "タイガー",
  line: "PCT-A150",
  image: "/products/tiger-pct-a150.jpg",
  imageAlt: "タイガー 電気ケトル PCT-A150",
  audience: "1.5Lの容量を優先して選びたい人向け",
};

const faqEntries = [
  { question: "タイガー PCT-A120とPCT-A150の違いは？", answer: "タイガー公式ページでは、PCT-A120は1.2L・約730g、PCT-A150は1.5L・約770gと案内されています。容量と本体質量が主な違いです。" },
  { question: "PCT-A120とPCT-A150の消費電力は？", answer: "公式ページでは、どちらも定格消費電力1300Wとして案内されています。" },
  { question: "どちらを選べばよい？", answer: "一度に沸かす量を優先するならPCT-A150、容量を抑えて本体の軽さを確認したいならPCT-A120が候補です。購入前に公式ページと販売ページの表示を確認してください。" },
];

const keyDiffRows: KeyDiffRow[] = [
  { label: "容量", left: "1.2L", right: "1.5L", highlight: "right", highlightNote: "0.3L多い", bar: { left: 1.2, right: 1.5 } },
  { label: "本体質量", left: "約730g", right: "約770g", highlight: "left", highlightNote: "約40g軽い", bar: { left: 730, right: 770 } },
  { label: "定格消費電力", left: "1300W", right: "1300W" },
  { label: "カップ1杯分の沸とう時間", left: "約59秒", right: "約59秒" },
];

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: a120Model.brand, line: a120Model.line, tagline: "軽さと1.2Lを確認するなら", image: a120Model.image, imageAlt: a120Model.imageAlt, officialHref: official, guidePoints: [a120Model.audience], purchaseHref: articlePurchaseLinks['tiger-pct-a120-vs-pct-a150:left'].purchaseUrl}}
  right={{brand: a150Model.brand, line: a150Model.line, tagline: "1.5Lの容量を優先するなら", image: a150Model.image, imageAlt: a150Model.imageAlt, officialHref: official, guidePoints: [a150Model.audience], purchaseHref: articlePurchaseLinks['tiger-pct-a120-vs-pct-a150:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"タイガーのPCT-A120とPCT-A150は、どちらも1300Wの電気ケトルです。公式ページで確認できる容量、本体質量、沸とう時間を分けて比較します。"}
  summaryParagraph={"PCT-A120は1.2Lで約730g、PCT-A150は1.5Lで約770gです。どちらも定格消費電力は1300W、カップ1杯分の沸とう時間は約59秒と公式ページに記載されています。"}
  officialDescription={"タイガー公式ページでは、PCT-A120（1.2L）とPCT-A150（1.5L）の容量別仕様が案内されています。両モデルの画像と仕様は同じ公式商品ページで確認できます。"}
  officialLinks={[
    { label: "PCT-A120/A150 公式商品ページ", href: official },
  ]}
  socialProofQuery={"タイガー PCT-A120 PCT-A150 電気ケトル"}
  faqEntries={faqEntries}
  leftPurchaseName={"タイガー PCT-A120"}
  leftPurchaseAudience={a120Model.audience}
  rightPurchaseName={"タイガー PCT-A150"}
  rightPurchaseAudience={a150Model.audience}
  sourceLinks={[
    { label:"タイガー PCT-A120/A150 公式商品ページ", href:official, checkedAt:"2026-08-17" },
  ]}
  purchaseWarning={"電気ケトルは、必要な容量、置き場所、電源コードの取り回し、注ぎ方を購入前に公式ページで確認してください。価格や在庫は販売先で変わります。"}
  disclaimer={"この比較は、タイガー公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。"}
/>
---
import { articlePurchaseLinks } from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {panasonicHairDryerArticle as articleMetadata} from '../../../content/articles';

const premiumOfficial = 'https://panasonic.jp/hair/products/EH-NE7M-W.html';
const standardOfficial = 'https://panasonic.jp/hair/products/EH-NE5M-W.html';

const leftModel = {
  brand: 'パナソニック', line: 'EH-NE7M', tagline: 'Wミネラルなら',
  image: '/products/panasonic-eh-ne7m.png', imageAlt: 'パナソニック イオニティ EH-NE7M ドライヤー',
  officialHref: premiumOfficial, guidePoints: ['Wミネラルと低温ケアモードを重視する人の候補'],
  purchaseHref: articlePurchaseLinks['panasonic-eh-ne7m-vs-eh-ne5m:left'].purchaseUrl,
};
const rightModel = {
  brand: 'パナソニック', line: 'EH-NE5M', tagline: '大風量・基本機能なら',
  image: '/products/panasonic-eh-ne5m.png', imageAlt: 'パナソニック イオニティ EH-NE5M ドライヤー',
  officialHref: standardOfficial, guidePoints: ['大風量と基本的なヘアケア機能を選びたい人の候補'],
  purchaseHref: articlePurchaseLinks['panasonic-eh-ne7m-vs-eh-ne5m:right'].purchaseUrl,
};

const faqEntries = [
  {question: 'パナソニック EH-NE7M と EH-NE5M の違いは？', answer: '公式ページで確認できる主な違いは、EH-NE7MがWミネラル＆マイナスイオンと低温ケアモードを案内しているのに対し、EH-NE5Mはマイナスイオンと低温ケアモードを案内していることです。'},
  {question: 'Wミネラルが搭載されているのはどっち？', answer: 'パナソニック公式ページでは、EH-NE7MにWミネラル＆マイナスイオンが案内されています。EH-NE5Mはマイナスイオンが案内されています。'},
  {question: 'どちらも大風量ですか？', answer: '両モデルとも、公式ページで大風量・速乾に関する案内があります。風量の具体的な数値や測定条件は、購入時点の各公式仕様ページで確認してください。'},
  {question: '価格は比較できますか？', answer: '両モデルとも公式ページではオープン価格として扱われています。価格の優劣は推測せず、Wミネラル、マイナスイオン、低温ケアモードなど公式に確認できる機能で比較しています。'},
];

const keyDiffRows: KeyDiffRow[] = [
  {label: 'ミネラル機能', left: 'Wミネラル＆マイナスイオン', right: 'マイナスイオン', highlight: 'left', highlightNote: 'Wミネラル'},
  {label: '低温ケアモード', left: '公式ページで案内あり', right: '公式ページで案内あり'},
  {label: '大風量・速乾', left: '公式ページで案内あり', right: '公式ページで案内あり'},
  {label: '価格', left: 'オープン価格', right: 'オープン価格'},
];

const specRows = [
  {label: 'ミネラル機能', left: 'Wミネラル＆マイナスイオン', right: 'マイナスイオン', sourceLeftHref: premiumOfficial, sourceLeftLabel: 'EH-NE7M公式', sourceRightHref: standardOfficial, sourceRightLabel: 'EH-NE5M公式'},
  {label: '低温ケアモード', left: '公式ページで案内あり', right: '公式ページで案内あり'},
  {label: '大風量・速乾', left: '公式ページで案内あり', right: '公式ページで案内あり'},
  {label: '価格', left: 'オープン価格', right: 'オープン価格'},
];
---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={leftModel}
  right={rightModel}
  keyDiffRows={keyDiffRows}
  lead="パナソニックのイオニティ EH-NE7MとEH-NE5Mを、公式ページで確認できるミネラル機能、マイナスイオン、低温ケアモード、大風量・速乾の案内に分けて比較します。"
  summaryParagraph="EH-NE7MはWミネラル＆マイナスイオン、EH-NE5Mはマイナスイオンを公式ページで確認できます。低温ケアモードと大風量・速乾は両モデルで案内されています。価格はどちらもオープン価格です。"
  officialDescription="パナソニック公式ページでは、EH-NE7MにWミネラル＆マイナスイオン、低温ケアモード、大風量速乾が案内されています。EH-NE5Mにもマイナスイオン、低温ケアモード、大風量・速乾の案内があります。"
  officialLinks={[
    {label: 'EH-NE7M 公式商品ページ', href: premiumOfficial},
    {label: 'EH-NE5M 公式商品ページ', href: standardOfficial},
  ]}
  specRows={specRows}
  socialProofQuery="パナソニック EH-NE7M EH-NE5M ドライヤー"
  socialProofCheckedAt="2026-08-13"
  faqEntries={faqEntries}
  leftPurchaseName="パナソニック イオニティ EH-NE7M"
  leftPurchaseAudience={leftModel.guidePoints[0]}
  rightPurchaseName="パナソニック イオニティ EH-NE5M"
  rightPurchaseAudience={rightModel.guidePoints[0]}
  sourceLinks={[
    {label: 'パナソニック EH-NE7M 公式商品ページ', href: premiumOfficial, checkedAt: '2026-08-13'},
    {label: 'パナソニック EH-NE5M 公式商品ページ', href: standardOfficial, checkedAt: '2026-08-13'},
  ]}
  disclaimer="この比較は、パナソニック公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。"
/>

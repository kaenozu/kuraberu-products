---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {yamazakiDustWagonArticle as articleMetadata} from '../../../content/articles';

const twoDivisionOfficial = 'https://www.yamajitsu.co.jp/products/240712'

const threeDivisionOfficial = 'https://www.yamajitsu.co.jp/products/240713'

const twoDivisionImage = '/products/yamazaki-dust-wagon-45l-2division.jpg'

const threeDivisionImage = '/products/yamazaki-dust-wagon-45l-3division.jpg'

const twoDivisionAudience = '分別数を抑え、設置幅を小さくしたい人向け'

const threeDivisionAudience = '45L袋を3つに分け、分別数を優先したい人向け'

const faqEntries = [
  {question: '2分別と3分別の違いは？', answer: '公式仕様では、分別数が2分別と3分別で異なります。商品サイズは2分別が幅52×奥行44×高さ60cm、3分別が幅76×奥行44×高さ60cmです。'},
  {question: '設置幅が小さいのはどちら？', answer: '公式記載の幅は2分別が52cm、3分別が76cmです。設置場所の幅を先に測ってから選んでください。'},
  {question: 'どちらも45Lのゴミ袋に対応しますか？', answer: '公式ページでは、2分別・3分別のどちらもゴミ袋45L対応と案内されています。'},
  {question: '楽天市場の価格は掲載していますか？', answer: '価格・在庫・送料・ポイントは販売先で変わるため、型番検索ページで購入時点の表示を確認してください。'},
] as const

const keyDiffRows: KeyDiffRow[] = [
  {label: '分別数', left: '2分別', right: '3分別', highlight: 'right', highlightNote: '分別数が多い'},
  {label: 'サイズ（幅×奥行×高さ）', left: '52×44×60cm', right: '76×44×60cm', highlight: 'left', highlightNote: '幅24cm小さい'},
  {label: '商品重量', left: '約7.7kg', right: '約10.35kg', highlight: 'left', highlightNote: '約2.65kg軽い'},
  {label: '対応ゴミ袋', left: '45L', right: '45L', highlight: null},
  {label: '耐荷重', left: '5kg', right: '7.5kg', highlight: null},
]

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: '山崎実業', line: '45L 2分別', tagline: '設置幅を抑えるなら', image: twoDivisionImage, imageAlt: '山崎実業 蓋付き目隠し分別ダストワゴン 45L 2分別', officialHref: twoDivisionOfficial, guidePoints: [twoDivisionAudience], purchaseHref: articlePurchaseLinks['yamazaki-dust-wagon-45l-2division-vs-3division:left'].purchaseUrl}}
  right={{brand: '山崎実業', line: '45L 3分別', tagline: '分別数を優先するなら', image: threeDivisionImage, imageAlt: '山崎実業 蓋付き目隠し分別ダストワゴン 45L 3分別', officialHref: threeDivisionOfficial, guidePoints: [threeDivisionAudience], purchaseHref: articlePurchaseLinks['yamazaki-dust-wagon-45l-2division-vs-3division:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"山崎実業の蓋付き目隠し分別ダストワゴン45Lを、2分別と3分別で比較します。メーカー公式ページで確認できる分別数・設置幅・重量・耐荷重をもとに、置き場所と分別数のどちらを優先するか整理します。"}
  summaryParagraph={"2分別は3分別より幅と重量を抑えやすく、3分別は同じ45L対応でも分別数を増やせます。ごみ箱を置く場所の幅と、必要な分別数を先に確認してください。"}
  officialDescription={"仕様の根拠は、山崎実業公式の商品ページで2026年8月15日に確認しました。この記事では公式に記載された分別数・サイズ・重量・対応サイズ・耐荷重だけを比較しています。"}
  officialLinks={[
    { label: "45L 2分別 公式商品ページ", href: twoDivisionOfficial },
    { label: "45L 3分別 公式商品ページ", href: threeDivisionOfficial },
  ]}
  socialProofQuery={"山崎実業 蓋付き目隠し分別ダストワゴン 45L"}
  faqEntries={faqEntries}
  leftPurchaseName={"蓋付き目隠し分別ダストワゴン 45L 2分別"}
  leftPurchaseAudience={twoDivisionAudience}
  rightPurchaseName={"蓋付き目隠し分別ダストワゴン 45L 3分別"}
  rightPurchaseAudience={threeDivisionAudience}
  sourceLinks={[
    { label:"山崎実業公式：蓋付き目隠し分別ダストワゴン 45L 2分別", href:twoDivisionOfficial, checkedAt:"2026-08-15" },
    { label:"山崎実業公式：蓋付き目隠し分別ダストワゴン 45L 3分別", href:threeDivisionOfficial, checkedAt:"2026-08-15" },
  ]}
/>
---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PurchaseCard from '../../../components/PurchaseCard.astro'
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro'
import ArticleComparisonV2Section from '../../../components/ArticleComparisonV2Section.astro'
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro'
import { additionalCommercialArticles } from '../../../content/articles'
import { articlePurchaseLinks } from '../../../lib/products'
import { comparisonV2Articles } from '../../../content/articles/comparison-v2'

const articleMetadata = additionalCommercialArticles.find((article) => article.id === 'panasonic-nt-t501-vs-nt-d700')!
const comparison = comparisonV2Articles['panasonic-nt-t501-vs-nt-d700']
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / キッチン家電 · 公式確認日 <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">パナソニックのオーブントースター NT-T501とNT-D700を、公式仕様で確認できるトースト枚数・消費電力・寸法・火力と温度調節・質量に分けて比較します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ"><a href="#key-differences">違い</a><a href="#decision-guide">どっち向き？</a><a href="#specs">詳細仕様</a><a href="#faq">FAQ</a></nav>
    <ArticleComparisonV2Section articleId="panasonic-nt-t501-vs-nt-d700" />
    <details class="fold-section" id="specs"><summary>詳細仕様（公式ページで確認した項目）</summary><details class="source-toggle"><summary>根拠・確認先を表示</summary></details><div class="table-scroll"><table class="comparison"><thead><tr><th scope="col">比較項目</th><th scope="col">NT-T501</th><th scope="col">NT-D700</th><th scope="col">根拠</th></tr></thead><tbody>{comparison.rows.map((row) => <tr><th scope="row">{row.label}</th><td data-label="NT-T501">{row.left}</td><td data-label="NT-D700">{row.right}</td><td data-label="根拠"><a href="https://panasonic.jp/toaster/products/NT-T501/spec.html" target="_blank" rel="noopener noreferrer">公式仕様</a> / <a href="https://panasonic.jp/toaster/products/NT-D700/spec.html" target="_blank" rel="noopener noreferrer">公式仕様</a></td></tr>)}</tbody></table></div><p class="meta">価格・在庫・仕様は購入時点の公式ページでご確認ください。</p></details>
    <h2 id="faq">よくある質問</h2><div class="faq-list">{comparison.faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}</div>
    <h2>公式情報</h2><div class="source-links"><a class="card-link" href={comparison.left.officialHref} target="_blank" rel="noopener noreferrer">NT-T501 公式商品ページ →</a><a class="card-link" href={comparison.right.officialHref} target="_blank" rel="noopener noreferrer">NT-D700 公式商品ページ →</a></div>
    <ArticleSocialProof query="パナソニック NT-T501 NT-D700 オーブントースター" checkedAt="2026-08-18" hasPosts={false} />
    <h2>購入時の注意</h2><p>価格・在庫・付属品は販売先で変わる場合があります。公式仕様と購入時点の販売ページを確認してください。</p>
    <div class="purchase-cards"><PurchaseCard name={comparison.left.imageAlt} audience={comparison.left.guidePoints[0]} href={articlePurchaseLinks['panasonic-nt-t501-vs-nt-d700:left'].purchaseUrl} imagePath={comparison.left.image} placement="article-end" note="価格・在庫は販売先でご確認ください。" purchaseLinkStatus={articleMetadata.purchaseLinkStatus} /><PurchaseCard name={comparison.right.imageAlt} audience={comparison.right.guidePoints[0]} href={articlePurchaseLinks['panasonic-nt-t501-vs-nt-d700:right'].purchaseUrl} imagePath={comparison.right.image} placement="article-end" note="価格・在庫は販売先でご確認ください。" purchaseLinkStatus={articleMetadata.purchaseLinkStatus} /></div>
    <h2>情報源一覧</h2><ul class="source-list"><li><a href={comparison.left.officialHref} target="_blank" rel="noopener noreferrer">パナソニック NT-T501 公式商品ページ</a>（2026-08-18確認）</li><li><a href={comparison.right.officialHref} target="_blank" rel="noopener noreferrer">パナソニック NT-D700 公式商品ページ</a>（2026-08-18確認）</li></ul>
    <h2>調査方法・免責事項</h2><p>この比較は、パナソニック公式の商品ページ・仕様ページで確認できる情報を根拠にしています。価格や個人の感想は比較の根拠にしていません。</p>
  </article>
</BaseLayout>

---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {tefalGarmentSteamerArticle as articleMetadata} from '../../../content/articles';

const supreOfficial = 'https://www.t-fal.co.jp/irons-steamer/garment-steamer-2way/products/steamsupre-1830009138/';

const rafreOfficial = 'https://www.t-fal.co.jp/irons-steamer/garment-steamer-2way/products/steam-rafrai-1830009402/';

const faqEntries = [
  {
    question: 'ティファール DV4030J0 と DV8070J0 はどっち？',
    answer: 'DV4030J0は通常スチーム平均13g/分・ジェットスチーム最大16g/分、立ち上がり約40秒、連続運転約9分です。DV8070J0は平均17g/分、立ち上がり約19秒、連続運転約14分です。スチーム量・準備時間・連続使用時間を重視するなら、公式仕様上はDV8070J0の数値が大きくなっています。',
  },
  {
    question: '立ち上がりが速いのはどっち？',
    answer: '公式仕様では、DV4030J0が高温設定時約40秒、DV8070J0が高温設定時約19秒です。数値だけを比較するとDV8070J0の方が短いです。',
  },
  {
    question: '長く使えるのはどっち？',
    answer: '公式仕様では、DV4030J0の連続運転時間は約9分、DV8070J0は約14分（中温設定時）です。連続使用時間を重視する場合は、使用条件の違いに注意しながらDV8070J0の公式値を確認できます。',
  },
  {
    question: '軽いのはどっち？',
    answer: '本体重量はDV4030J0が約690g、DV8070J0が約680gです。公式記載上の差は約10gで、どちらも軽量コンパクトと案内されています。',
  },
] as const;

const keyDiffRows: KeyDiffRow[] = [
  {label: 'スチーム量', left: '通常平均13g/分・ジェット最大16g/分', right: '平均17g/分', highlight: 'right', highlightNote: '平均値が大きい'},
  {label: '立ち上がり', left: '約40秒', right: '約19秒', highlight: 'right', highlightNote: '約21秒短い', bar: {left: 40, right: 19}, direction: 'lower-is-better'},
  {label: '連続運転時間', left: '約9分', right: '約14分', highlight: 'right', highlightNote: '約5分長い', bar: {left: 9, right: 14}},
  {label: '水タンク容量', left: '120mL', right: '140mL', highlight: 'right', highlightNote: '20mL多い', bar: {left: 120, right: 140}},
  {label: '本体重量', left: '約690g', right: '約680g', highlight: 'right', highlightNote: '約10g軽い', bar: {left: 690, right: 680}, direction: 'lower-is-better'},
  {label: 'かけ面', left: 'アルミニウム＋PTFE', right: 'セラミック'},
];

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: 'ティファール', line: 'DV4030J0', tagline: 'ジェットスチーム・コンパクトさなら', image: '/products/tefal-dv4030j0.jpg', imageAlt: 'ティファール スチーム シュプレ DV4030J0', officialHref: supreOfficial, guidePoints: ['ジェットスチーム最大16g/分を確認したい', 'コンパクトな2WAYモデルを選びたい', 'ワンプッシュおまかせスチームを使いたい'], purchaseHref: articlePurchaseLinks['tefal-dv4030j0-vs-dv8070j0:left'].purchaseUrl}}
  right={{brand: 'ティファール', line: 'DV8070J0', tagline: '量・速さ・連続使用なら', image: '/products/tefal-dv8070j0.png', imageAlt: 'ティファール スチーム ラフレ DV8070J0', officialHref: rafreOfficial, guidePoints: ['平均17g/分のスチーム量を重視したい', '立ち上がり約19秒を優先したい', '連続運転約14分・140mLタンクを確認したい'], purchaseHref: articlePurchaseLinks['tefal-dv4030j0-vs-dv8070j0:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"ティファールの衣類スチーマー「スチーム シュプレ DV4030J0」と「スチーム ラフレ DV8070J0」を比較します。公式仕様から、スチーム量・立ち上がり・連続使用時間・水タンク容量の違いを整理します。"}
  socialProofQuery={"ティファール DV4030J0 DV8070J0"}
  faqEntries={faqEntries}
  leftPurchaseName={"ティファール DV4030J0"}
  leftPurchaseAudience={"ジェットスチーム・コンパクトさを重視する人向け"}
  rightPurchaseName={"ティファール DV8070J0"}
  rightPurchaseAudience={"スチーム量・速さ・連続使用を重視する人向け"}
  sourceLinks={[
    { label:"ティファール DV4030J0 公式ページ", href:supreOfficial, checkedAt:"2026-08-13" },
    { label:"ティファール DV8070J0 公式ページ", href:rafreOfficial, checkedAt:"2026-08-13" },
  ]}
/>
---
import { articlePurchaseLinks } from '../../../lib/products';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2Section from '../../../components/ArticleComparisonV2Section.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {pigeonBottle240Article as articleMetadata} from '../../../content/articles';
import {comparisonV2Articles} from '../../../content/articles/comparison-v2';

const comparison = comparisonV2Articles['pigeon-bottle-240'];
const materialFaq = 'https://support.pigeon.co.jp/faq/detail-1.html';

const left = comparison.left;
const right = comparison.right;
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 授乳用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">母乳実感240mlの「耐熱ガラス製」と「プラスチック製（PPSU）」を、ピジョン公式で確認できる素材・容量・付属品・消毒方法で比較します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">結局どっち？</a>

      <a href="#faq">FAQ</a>
    </nav>
    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2Section articleId="pigeon-bottle-240" />


    <details class="fold-section" id="specs">
      <summary>詳細仕様（公式ページで確認した項目）</summary>
      <details class="source-toggle">
        <summary>根拠・確認先を表示</summary>
      </details>
      <div class="table-scroll">
    <table class="comparison">
      <thead><tr><th scope="col">比較項目</th><th scope="col">耐熱ガラス製（240ml）</th><th scope="col">プラスチック製（PPSU）（240ml）</th><th scope="col">根拠・確認先</th></tr></thead>
      <tbody>
        <tr><th scope="row">びんの素材</th><td data-label="耐熱ガラス製（240ml）">ほうけい酸ガラス</td><td data-label="プラスチック製（PPSU）（240ml）">ポリフェニルサルホン（PPSU）</td><td data-label="根拠・確認先"><a href={left.officialHref} target="_blank" rel="noopener noreferrer">ガラス製公式</a> / <a href={right.officialHref} target="_blank" rel="noopener noreferrer">プラスチック製公式</a></td></tr>
        <tr><th scope="row">容量</th><td data-label="耐熱ガラス製（240ml）">240ml</td><td data-label="プラスチック製（PPSU）（240ml）">240ml</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
        <tr><th scope="row">対象月齢の目安</th><td data-label="耐熱ガラス製（240ml）">3ヵ月頃から</td><td data-label="プラスチック製（PPSU）（240ml）">3ヵ月頃から</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
        <tr><th scope="row">付属の乳首</th><td data-label="耐熱ガラス製（240ml）">Mサイズ、Y字形</td><td data-label="プラスチック製（PPSU）（240ml）">Mサイズ、Y字形</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
        <tr><th scope="row">消毒・除菌</th><td data-label="耐熱ガラス製（240ml）">煮沸/スチーム/薬液で可・電子レンジ不可</td><td data-label="プラスチック製（PPSU）（240ml）">煮沸/スチーム/薬液で可・電子レンジ不可</td><td data-label="根拠・確認先">各公式商品ページ</td></tr>
        <tr><th scope="row">公式が挙げる長所</th><td data-label="耐熱ガラス製（240ml）">汚れが落ちやすいので清潔</td><td data-label="プラスチック製（PPSU）（240ml）">軽い、落ちても割れにくい</td><td data-label="根拠・確認先"><a href={materialFaq} target="_blank" rel="noopener noreferrer">ピジョン公式Q&A</a></td></tr>
        <tr><th scope="row">公式が挙げる注意点</th><td data-label="耐熱ガラス製（240ml）">重い／欠け・割れることがある</td><td data-label="プラスチック製（PPSU）（240ml）">キズがつきやすく、色・においなどが吸着しやすい</td><td data-label="根拠・確認先"><a href={materialFaq} target="_blank" rel="noopener noreferrer">ピジョン公式Q&A</a></td></tr>
        <tr><th scope="row">価格・在庫</th><td data-label="耐熱ガラス製（240ml）">販売ページで確認</td><td data-label="プラスチック製（PPSU）（240ml）">販売ページで確認</td><td data-label="根拠・確認先">楽天市場の検索結果</td></tr>
      </tbody>
    </table>
      </div>
      <p class="meta">商品仕様や素材は変更される可能性があります。購入時点の公式商品ページとパッケージを確認してください。</p>
    </details>

    <h2 id="official">公式情報</h2>
    <p>ピジョン公式Q&Aでは、ガラス製の長所を「汚れが落ちやすいので清潔」、注意点を「重い／欠け・割れることがある」、プラスチック製の長所を「軽い、落としても割れにくい」、注意点を「ガラスに比べてキズがつきやすく、色やにおいなどが吸着しやすい」と案内しています。どちらの素材も煮沸消毒・スチーム除菌（専用除菌器）・薬液消毒・除菌が可能です。さらに「それぞれに特長がありますので、たとえばご家庭ではガラス製、おでかけの時はプラスチック製など、使い分けてみてください」とあります。</p>
    <div class="source-links">
      <a class="card-link" href={left.officialHref} target="_blank" rel="noopener noreferrer">母乳実感 耐熱ガラス製 240ml 公式商品ページ →</a>
      <a class="card-link" href={right.officialHref} target="_blank" rel="noopener noreferrer">母乳実感 プラスチック製（PPSU）240ml 公式商品ページ →</a>
      <a class="card-link" href={materialFaq} target="_blank" rel="noopener noreferrer">ピジョン公式Q&A：ガラス製とプラスチック製の選び方 →</a>
    </div>

    <ArticleSocialProof
      query="ピジョン 母乳実感 ガラス PPSU 240ml"
      checkedAt="2026-08-12"
      hasPosts={false}
    />

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {comparison.faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>価格・在庫・販売条件は販売先で変わります。このサイトでは価格や在庫を保証しません。</p>

    <div class="purchase-cards">
      <PurchaseCard
        name="母乳実感 耐熱ガラス製 240ml"
        audience="自宅中心で、汚れの落ちやすさ・清潔さを優先する人向け"
        href={articlePurchaseLinks['pigeon-bottle-240:left'].purchaseUrl}
        productId="pigeon-glass-240"
        imagePath="/products/pigeon-bottle-glass240.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="母乳実感 プラスチック製 240ml"
        audience="持ち運びや軽さ・割れにくさを優先し、外出時にも使いたい人向け"
        href={articlePurchaseLinks['pigeon-bottle-240:right'].purchaseUrl}
        productId="pigeon-ppsu-240"
        imagePath="/products/pigeon-bottle-ppsu240.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>
    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog
        .slice()
        .sort((left, right) => right.date.localeCompare(left.date))
        .map((entry) => (
          <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
        ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={left.officialHref} target="_blank" rel="noopener noreferrer">ピジョン：母乳実感 耐熱ガラス製 240ml</a>（2026-08-09確認）</li>
      <li><a href={right.officialHref} target="_blank" rel="noopener noreferrer">ピジョン：母乳実感 プラスチック製 240ml</a>（2026-08-09確認）</li>
      <li><a href={materialFaq} target="_blank" rel="noopener noreferrer">ピジョン公式Q&A：ガラス製とプラスチック製の選び方</a>（2026-08-09確認）</li>
      <li><a href={articlePurchaseLinks['pigeon-bottle-240:left'].purchaseUrl} target="_blank" rel="noopener noreferrer">楽天市場：哺乳びん検索</a>（価格・在庫確認用）</li>
      <li><a href={articlePurchaseLinks['pigeon-bottle-240:right'].purchaseUrl} target="_blank" rel="noopener noreferrer">楽天市場：PPSU検索</a>（価格・在庫確認用）</li>
    </ul>
    <h2>調査方法・免責事項</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式Q&Aで確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

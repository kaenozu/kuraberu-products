---
import { articlePurchaseLinks } from '../../../lib/products';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2Section from '../../../components/ArticleComparisonV2Section.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {babybjornBouncerArticle as articleMetadata} from '../../../content/articles';
import {comparisonV2Articles} from '../../../content/articles/comparison-v2';

const comparison = comparisonV2Articles['babybjorn-bouncer'];
const bouncerGuideUrl = 'https://www.rakuten.ne.jp/gold/babybjorn/topics/bouncer-guide/';

const left = comparison.left;
const right = comparison.right;
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 育児用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">ベビービョルンのバウンサー「Bliss」と「バランスソフト」を、公式のガイド・商品ページで確認できる内容で比較します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ">
      <a href="#key-differences">違い</a>
      <a href="#decision-guide">結局どっち？</a>

      <a href="#faq">FAQ</a>
    </nav>

    <!-- Canonical comparison shell: hero -> key differences -> decision guide. -->
    <ArticleComparisonV2Section articleId="babybjorn-bouncer" />


    <details class="fold-section" id="official">
      <summary>公式情報（確認できた項目）</summary>
      <p>ここでは、ベビービョルン公式のガイド・商品ページで確認できた内容を整理します。使用感・実際の肌触り・赤ちゃんの反応など、公式情報だけでは確認できないことは書いていません。</p>
    <h3>バウンサー Bliss で公式に確認できること</h3>
    <ul class="official-list">
      <li>ベビービョルンのバウンサー「最新モデル」と案内。シートカバーをより柔らかく仕上げたモデルで、赤ちゃんを優しく包み込みます。</li>
      <li>対象は生後約1ヶ月〜2才くらい（最大体重13kg）。バウンサーとしてのご使用は体重9kgまで（公式商品ページ）。</li>
      <li>20種類以上のバリエーションの中から選べます（公式バウンサーガイド）。</li>
      <li>素材は3Dジャージー（内側は3Dメッシュで放熱効果）・コットン・Air（メッシュ）・ウーブンなど。</li>
      <li>セルフバウンシング構造。独自開発の構造で、赤ちゃん自身の動きでゆらゆら揺れます。</li>
      <li>3段階リクライニング。製品サイズは幅約39×奥行約89×高さ46〜58cm、重量は約2.1kg。</li>
      <li>SG認証。ASTM（アメリカ）・EN（ヨーロッパ）に準拠。2年保証（公式楽天市場店の案内）。</li>
    </ul>
    <h3>バウンサー バランスソフト で公式に確認できること</h3>
    <ul class="official-list">
      <li>2トーンの生地が特長。直近カラーバリエーションが増えています（公式バウンサーガイド）。</li>
      <li>対象は生後約1ヶ月〜2才くらい（最大体重13kg）。バウンサーとしてのご使用は体重9kgまで（公式商品ページ）。</li>
      <li>1ヶ月から2歳まで使えるロングユースタイプ。3段階リクライニングで快適に長く使えます（公式商品ページ）。</li>
      <li>素材はコットン（綿100%）・Air（メッシュ）・ウーブン/ジャージー（ポリエステル65%、コットン35%）。</li>
      <li>セルフバウンシング構造。独自開発の構造で、赤ちゃん自身の動きでゆらゆら揺れます。</li>
      <li>製品サイズは幅約39×奥行約89×高さ46〜58cm、重量は約2.1kg。</li>
      <li>SG認証。ASTM（アメリカ）・EN（ヨーロッパ）に準拠。2年保証（公式楽天市場店の案内）。</li>
    </ul>

    </details>
    <ArticleSocialProof
      query="ベビービョルン バウンサー Bliss バランスソフト"
      checkedAt="2026-08-12"
      hasPosts={false}
    />

    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">
      {comparison.faqEntries.map((entry) => (
        <details class="faq-item">
          <summary><h3>{entry.question}</h3></summary>
          <p>{entry.answer}</p>
        </details>
      ))}
    </div>

    <h2>購入時の注意</h2>
    <p>この記事で記載した価格は、2026年8月10日時点で確認したベビービョルン公式楽天市場店の表示価格です。楽天市場など他のショップでは、販売価格、ポイント還元、送料、セット内容などが変わる場合があります。購入時は、商品名、カラー、付属品を販売ページで確認してください。また、バウンサーの安全性と正しい使用方法は必ず公式の使用説明書で確認してください。</p>

    <div class="purchase-cards">
      <PurchaseCard
        name="バウンサー Bliss"
        audience="シートカバーの柔らかさと、3Dジャージーを含む20種類以上の素材バリエーションを優先する人向け"
        href={articlePurchaseLinks['babybjorn-bouncer:left'].purchaseUrl}
        productId="babybjorn-bouncer-bliss"
        imagePath="/products/babybjorn-bouncer-bliss.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
      <PurchaseCard
        name="バウンサー バランスソフト"
        audience="2トーンの落ち着いたデザインと、コットン・メッシュなど定番素材を優先する人向け"
        href={articlePurchaseLinks['babybjorn-bouncer:right'].purchaseUrl}
        productId="babybjorn-bouncer-balance"
        imagePath="/products/babybjorn-bouncer-balance.jpg"
        placement="article-end"
        note="価格・在庫は販売先でご確認ください。"
      />
    </div>
    <h2>更新履歴</h2>
    <ol class="change-log">
      {articleMetadata.changeLog.slice().sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>
      ))}
    </ol>

    <h2>情報源一覧</h2>
    <ul class="source-list">
      <li><a href={bouncerGuideUrl} target="_blank" rel="noopener noreferrer">バウンサーガイド（ベビービョルン公式楽天市場店）</a>（2026-08-10確認）</li>
      <li><a href={left.officialHref} target="_blank" rel="noopener noreferrer">バウンサー Bliss（ベビービョルン公式）</a>（2026-08-10確認）</li>
      <li><a href={right.officialHref} target="_blank" rel="noopener noreferrer">バウンサー バランスソフト（ベビービョルン公式）</a>（2026-08-10確認）</li>
    </ul>
    <h2>調査方法・免責</h2>
    <p>このサイトの比較は、メーカー公式の商品ページ・公式のガイドで確認できる情報のみを根拠としています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

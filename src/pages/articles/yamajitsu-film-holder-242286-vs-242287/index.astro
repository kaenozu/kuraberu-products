---
import { articlePurchaseLinks } from '../../../lib/products'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import RelatedArticles from '../../../components/RelatedArticles.astro'
import PurchaseCard from '../../../components/PurchaseCard.astro'
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro'
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro'
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro'
import {yamajitsuFilmHolderArticle as articleMetadata} from '../../../content/articles'
import type {KeyDiffRow} from '../../../components/VisualKeyDifferences.astro'

const leftOfficial = 'https://www.yamajitsu.co.jp/products/242286'
const rightOfficial = 'https://www.yamajitsu.co.jp/products/242287'
const leftImage = '/products/yamazaki-film-holder-242286.jpg'
const rightImage = '/products/yamazaki-film-holder-242287.jpg'
const leftAudience = '厚みの異なるまな板を2枚、壁面に浮かせて収納したい人向け'
const rightAudience = '直径14〜30cmの鍋蓋を壁面に収納したい人向け'

const faqEntries = [
  {question: 'まな板ホルダーと鍋蓋ホルダーの違いは？', answer: 'まな板ホルダーは厚み1.5cmと2.5cm以内のまな板を各1枚、鍋蓋ホルダーは直径14〜30cmの鍋蓋を収納する商品です。'},
  {question: '耐荷重は同じ？', answer: '公式ページでは、どちらも耐荷重2kgと記載されています。'},
  {question: '取り付けられる壁面は？', answer: 'どちらも光沢のある平らで油染みのない面が対象です。タイル、プラスチック、ステンレス、ガラス、金属塗装面、人工大理石などが例として案内されています。'},
  {question: '価格と在庫は確認できますか？', answer: '価格・在庫・送料・ポイントは販売先で変わるため、購入時点の販売ページで確認してください。'},
] as const

const keyDiffRows: KeyDiffRow[] = [
  {label: '収納するもの', left: 'まな板2枚', right: '鍋蓋1枚', highlight: null},
  {label: '対応サイズ', left: '厚み1.5cm・2.5cm以内を各1枚', right: '直径14〜30cm', highlight: null},
  {label: '商品サイズ', left: 'W12×D5.7×H12cm', right: 'W13.5×D6.2×H14cm', highlight: null},
  {label: '商品重量', left: '140g', right: '120g', highlight: 'right', highlightNote: '20g軽い'},
  {label: '耐荷重', left: '2kg', right: '2kg', highlight: null},
]
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / キッチン用品 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">山崎実業のフィルムフック収納2商品を、公式ページで確認できる収納対象・対応サイズ・寸法・重量・耐荷重に分けて比較します。価格は販売先でご確認ください。</p>
    <p class="jump-nav"><a href="#key-differences">違い</a><a href="#specs">詳細仕様</a><a href="#faq">FAQ</a></p>
    <ArticleComparisonV2
      left={{brand: '山崎実業 tower', line: 'フィルムフックまな板ホルダー 242286', tagline: 'まな板2枚を浮かせて収納するなら', image: leftImage, imageAlt: '山崎実業 フィルムフックまな板ホルダー タワー 242286', officialHref: leftOfficial, guidePoints: [leftAudience], purchaseHref: articlePurchaseLinks['yamajitsu-film-holder-242286-vs-242287:left'].purchaseUrl}}
      right={{brand: '山崎実業 tower', line: 'フィルムフック鍋蓋ホルダー 242287', tagline: '鍋蓋を浮かせて収納するなら', image: rightImage, imageAlt: '山崎実業 フィルムフック鍋蓋ホルダー タワー 242287', officialHref: rightOfficial, guidePoints: [rightAudience], purchaseHref: articlePurchaseLinks['yamajitsu-film-holder-242286-vs-242287:right'].purchaseUrl}}
      rows={keyDiffRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
      purchaseLinkStatus={articleMetadata.purchaseLinkStatus}
    />
    <p>まな板を2枚収納したいなら242286、直径14〜30cmの鍋蓋を収納したいなら242287を確認してください。どちらもフィルムフックで取り付け、耐荷重は2kgです。</p>

    <details class="fold-section" id="specs" open><summary>詳細仕様（公式ページで確認した項目）</summary><details class="source-toggle"><summary>根拠・確認先を表示</summary></details><div class="table-scroll"><table class="comparison"><thead><tr><th scope="col">比較項目</th><th scope="col">242286</th><th scope="col">242287</th><th scope="col">根拠</th></tr></thead><tbody>
      <tr><th scope="row">収納対象</th><td data-label="242286">まな板</td><td data-label="242287">鍋蓋</td><td data-label="根拠"><a href={leftOfficial} target="_blank" rel="noopener noreferrer">公式ページ</a> / <a href={rightOfficial} target="_blank" rel="noopener noreferrer">公式ページ</a></td></tr>
      <tr><th scope="row">対応サイズ</th><td data-label="242286">厚み1.5cm・2.5cm以内のまな板を各1枚</td><td data-label="242287">直径14〜30cmの鍋蓋</td><td data-label="根拠">各公式商品ページ</td></tr>
      <tr><th scope="row">商品サイズ</th><td data-label="242286">W12×D5.7×H12cm（フィルムフック含まず）</td><td data-label="242287">W13.5×D6.2×H14cm（フィルムフック含まず）</td><td data-label="根拠">各公式商品ページ</td></tr>
      <tr><th scope="row">商品重量</th><td data-label="242286">140g</td><td data-label="242287">120g</td><td data-label="根拠">各公式商品ページ</td></tr>
      <tr><th scope="row">耐荷重</th><td data-label="242286">2kg</td><td data-label="242287">2kg</td><td data-label="根拠">各公式商品ページ</td></tr>
      <tr><th scope="row">取り付け可能な壁面</th><td data-label="242286">光沢のある平らで油染みのない面</td><td data-label="242287">光沢のある平らで油染みのない面</td><td data-label="根拠">各公式商品ページ</td></tr>
    </tbody></table></div><p class="meta">仕様・価格・在庫は変更される可能性があります。購入時点の公式ページと販売ページを確認してください。</p></details>
    <h2 id="official">公式情報</h2><p>比較の根拠は、山崎実業公式の商品ページで2026年8月19日に確認した仕様です。まな板・鍋蓋の対応サイズと、取り付け可能な壁面を確認して選んでください。</p>
    <div class="source-links"><a class="card-link" href={leftOfficial} target="_blank" rel="noopener noreferrer">242286 公式商品ページ →</a><a class="card-link" href={rightOfficial} target="_blank" rel="noopener noreferrer">242287 公式商品ページ →</a></div>
    <ArticleSocialProof query="山崎実業 242286 242287 まな板 鍋蓋" checkedAt="2026-08-19" hasPosts={false} />
    <h2 id="faq">よくある質問</h2><div class="faq-list">{faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}</div>
    <h2>購入時の注意</h2><p>収納したいものの種類・サイズと、取り付け場所の材質を購入前に確認してください。価格・在庫・ポイント・送料は販売先で変わります。</p>
    <div class="purchase-cards">
      <PurchaseCard name="山崎実業 フィルムフックまな板ホルダー タワー 242286" audience={leftAudience} href={articlePurchaseLinks['yamajitsu-film-holder-242286-vs-242287:left'].purchaseUrl} imagePath={leftImage} placement="article-end" note="価格・在庫は販売先でご確認ください。" purchaseLinkStatus={articleMetadata.purchaseLinkStatus}/>
      <PurchaseCard name="山崎実業 フィルムフック鍋蓋ホルダー タワー 242287" audience={rightAudience} href={articlePurchaseLinks['yamajitsu-film-holder-242286-vs-242287:right'].purchaseUrl} imagePath={rightImage} placement="article-end" note="価格・在庫は販売先でご確認ください。" purchaseLinkStatus={articleMetadata.purchaseLinkStatus}/>
    </div>
    <h2>更新履歴</h2><ol class="change-log">{articleMetadata.changeLog.map((entry) => <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>)}</ol>
    <h2>情報源一覧</h2><ul class="source-list"><li><a href={leftOfficial} target="_blank" rel="noopener noreferrer">山崎実業 242286 公式商品ページ</a>（2026-08-19確認）</li><li><a href={rightOfficial} target="_blank" rel="noopener noreferrer">山崎実業 242287 公式商品ページ</a>（2026-08-19確認）</li></ul>
    <h2>調査方法・免責事項</h2><p>この比較は、山崎実業公式の商品ページで確認できる情報を根拠にしています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ComparisonHero from '../../../components/ComparisonHero.astro';
import HeroComparison from '../../../components/HeroComparison.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import {tigerMtaJ050GuideArticle as articleMetadata} from '../../../content/articles';
import {tigerMtaJ050} from '../../../lib/products';
import {isContentStale} from '../../../lib/content-freshness';

const officialPage = tigerMtaJ050.officialUrl;
const rakutenSearch = tigerMtaJ050.rakutenSearchUrl;
const productInfoStale = isContentStale(articleMetadata.productInfoCheckedAt, new Date().toISOString().slice(0, 10));
const faqEntries = [
  {
    question: 'MTA-J050の特徴は？',
    answer: '公式ページでは、ワンプッシュせん、せんとパッキンが一体になった「らくらくキャップ」、持ち運び時に指にフィットするスラントハンドルなどが案内されています。',
  },
  {
    question: 'お手入れで確認することは？',
    answer: '公式ページでは、パッキン着脱の手間を減らせる構造や、飲み口を外して洗えることが案内されています。購入前に販売ページでセット内容と最新の取扱表示を確認してください。',
  },
  {
    question: 'スポーツドリンクは入れられる？',
    answer: 'タイガー公式ページでは、スーパークリーンPlusの説明としてスポーツドリンク対応が案内されています。使用後のお手入れ方法など、具体的な注意事項は公式の取扱説明を確認してください。',
  },
] as const;
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 生活雑貨 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonHero
      lines={[{condition: 'ハンドル・お手入れ・スポーツドリンク対応を確認して選ぶ', brand: tigerMtaJ050.brand, model: tigerMtaJ050.model}]}
      differences={[{label: 'らくらくキャップ', note: 'パッキン一体型'}, {label: 'スラントハンドル', note: '持ち運び時にフィット'}, {label: 'スーパークリーンPlus', note: 'スポーツドリンク対応の案内'}]}
      diffAnchor="#features"
      checkedAt={articleMetadata.productInfoCheckedAt}
    />
    <HeroComparison
      left={{brand: tigerMtaJ050.brand, line: tigerMtaJ050.model, tagline: 'ハンドル・お手入れを確認するなら', image: tigerMtaJ050.imagePath, imageAlt: tigerMtaJ050.fullName, officialHref: officialPage}}
    />
    <p class="lead">タイガー MTA-J050は、持ち歩きやすさと日常のお手入れを確認しながら選びたい真空断熱ボトルです。この記事では、タイガー公式ページで確認できる機能だけをもとに、向いている人と購入前の確認ポイントを整理します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ"><a href="#features">主な特徴</a><a href="#decision-guide">向いている人</a><a href="#faq">FAQ</a></nav>

    <section id="features" class="feature-panel">
      <div class="subsection-heading"><p class="section-label">主な特徴</p><h2>公式ページで確認できること</h2></div>
      <ul class="official-list">
        <li>ワンプッシュで開けられるせんを採用。</li>
        <li>せんとパッキンが一体になった「らくらくキャップ」で、パッキン着脱の手間を減らせる。</li>
        <li>飲み口を外して洗える構造。</li>
        <li>スラントハンドル付きで、持ち運び時に指にフィットする設計。</li>
        <li>内面のスーパークリーンPlusについて、汚れ・においがつきにくく、スポーツドリンクにも対応すると案内されている。</li>
      </ul>
    </section>

    <section class="decision-guide" id="decision-guide" aria-label="向いている人">
      <div class="subsection-heading"><p class="section-label">どんな人向き？</p><h2>選ぶ前に確認したいこと</h2></div>
      <div class="decision-guide-grid single-guide-grid">
        <div class="decision-side"><p class="decision-side-brand">MTA-J050</p><p class="decision-side-head">こんな人に向いています</p><ul class="decision-side-list"><li>片手で開けられるワンプッシュ式を選びたい</li><li>パッキンを別々に外す手間を減らしたい</li><li>持ち運ぶときに握りやすいハンドルがほしい</li><li>スポーツドリンク対応を公式に確認して選びたい</li></ul></div>
        <div class="decision-side"><p class="decision-side-brand">購入前の確認</p><p class="decision-side-head">販売ページで確認すること</p><ul class="decision-side-list"><li>容量・カラー・セット内容</li><li>価格・在庫・送料</li><li>購入時点の取扱説明や注意事項</li></ul></div>
      </div>
      <p class="decision-guide-note">※ この記事の判断材料はメーカー公式の情報です。使用感や耐久性は公式情報だけでは判断していません。</p>
    </section>

    <div class="purchase-cards"><PurchaseCard name="タイガー MTA-J050" audience="ハンドル・お手入れ・スポーツドリンク対応を確認して選びたい人向け" href={rakutenSearch} productId="tiger-mta-j050" placement="after-decision" note="価格・在庫は販売先でご確認ください。" /></div>
    <ArticleSocialProof query="タイガー MTA-J050 水筒" checkedAt="2026-08-16" hasPosts={false} />
    <h2 id="faq">よくある質問</h2>
    <div class="faq-list">{faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}</div>
    <div class="verification-summary" aria-label="記事情報の確認状況"><p>商品情報確認日: <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time></p>{productInfoStale && <p class="notice">商品情報の確認から時間が経過しています。購入前に公式ページで最新情報を確認してください。</p>}</div>
    <p class="notice">広告表示：この記事には広告リンクを含みます。価格・在庫は販売先で、仕様は公式ページで確認してください。</p>
    <div class="purchase-cards"><PurchaseCard name="タイガー MTA-J050" audience="公式情報を確認して購入候補を探す人向け" href={rakutenSearch} productId="tiger-mta-j050" placement="article-end" note="価格・在庫は販売先でご確認ください。" /></div>
    <h2>更新履歴</h2><ol class="change-log">{articleMetadata.changeLog.map((entry) => <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>)}</ol>
    <h2>情報源一覧</h2><ul class="source-list"><li><a href={officialPage} target="_blank" rel="noopener noreferrer">タイガー MTA-Jシリーズ（公式）</a>（2026-08-16確認）</li><li><a href={rakutenSearch} target="_blank" rel="noopener noreferrer">楽天市場：タイガー MTA-J050</a>（価格・在庫用）</li></ul>
    <p>この記事はメーカー公式の商品ページを根拠に整理しています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

<style>
  .single-guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 720px) { .single-guide-grid { grid-template-columns: 1fr; } }
</style>

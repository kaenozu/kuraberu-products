---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import PurchaseCard from '../../../components/PurchaseCard.astro';
import ArticleComparisonV2 from '../../../components/ArticleComparisonV2.astro';
import ArticleSocialProof from '../../../components/ArticleSocialProof.astro';
import ComparisonMemoButton from '../../../components/ComparisonMemoButton.astro';
import {tigerMtaJ050GuideArticle as articleMetadata} from '../../../content/articles';
import {tigerMtaJ050} from '../../../lib/products';
import {isContentStale} from '../../../lib/content-freshness';
import type {KeyDiffRow} from '../../../components/VisualKeyDifferences.astro';

const officialPage = tigerMtaJ050.officialUrl;
const mtaJ080Image = 'https://www.tiger-corporation.com/wp-content/uploads/2025/07/MTA-J080_750x750-d1adb21a6e79c156ac1d5d974c9b75dd.jpg';
// 既存サイトで検証済みの楽天アフィリエイト導線に、MTA-J080の検索先を設定。
const mtaJ080Rakuten = 'https://hb.afl.rakuten.co.jp/hgc/34e76967.d5cc3ae1.34e76968.3eade5e6/?pc=https%3A%2F%2Fsearch.rakuten.co.jp%2Fsearch%2Fmall%2F%25E3%2582%25BF%25E3%2582%25A4%25E3%2582%25AC%25E3%2583%25BC%2520MTA-J080&link_type=text';
const productInfoStale = isContentStale(articleMetadata.productInfoCheckedAt, new Date().toISOString().slice(0, 10));
const faqEntries = [
  {question: 'MTA-J050とMTA-J080の違いは？', answer: '容量がMTA-J050は0.5L、MTA-J080は0.8Lです。公式仕様では、MTA-J050が約0.26kg、MTA-J080が約0.36kgで、MTA-J080の方が容量と重量が大きくなっています。'},
  {question: '軽いのはどっち？', answer: '公式仕様の本体質量は、MTA-J050が約0.26kg、MTA-J080が約0.36kgです。持ち運び時の軽さを優先するなら、MTA-J050が候補になります。'},
  {question: '保冷力が高いのはどっち？', answer: '公式仕様の保冷効力（6時間）は、MTA-J050が8℃以下、MTA-J080が7℃以下です。数値だけで比較すると、MTA-J080の方が低い温度を保つ案内です。'},
] as const;
const keyDiffRows: KeyDiffRow[] = [
  {label: '容量', left: '0.5L', right: '0.8L', highlight: 'right', highlightNote: '大容量', bar: {left: 0.5, right: 0.8}},
  {label: '本体質量', left: '約0.26kg', right: '約0.36kg', highlight: 'left', highlightNote: '約100g軽い', bar: {left: 0.26, right: 0.36}},
  {label: '保冷効力（6時間）', left: '8℃以下', right: '7℃以下', highlight: 'right', highlightNote: '低い温度を保つ', bar: {left: 8, right: 7}},
  {label: '保温効力（6時間）', left: '68℃以上', right: '75℃以上', highlight: 'right', highlightNote: '高い温度を保つ', bar: {left: 68, right: 75}},
  {label: '本体寸法', left: '幅7.5×奥行8.6×高さ23.3cm', right: '幅7.5×奥行8.6×高さ31.4cm'},
];
---
<BaseLayout title={articleMetadata.title} description={articleMetadata.description} article={articleMetadata} faq={faqEntries}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / 生活雑貨 · 公開日 <time datetime={articleMetadata.publishedAt}>{articleMetadata.publishedAt}</time> · 更新日 <time datetime={articleMetadata.modifiedAt}>{articleMetadata.modifiedAt}</time></p>
    <h1>{articleMetadata.headline}</h1>
    <ComparisonMemoButton articleId={articleMetadata.id} />
    <p class="lead">タイガー MTA-J050とMTA-J080は、ハンドル付きのワンプッシュマグボトルです。この記事では、タイガー公式ページで確認できる容量・重量・保温保冷効力・寸法の違いを比較します。お手入れやハンドルなどシリーズ共通の特徴と、サイズ選びに関わる差分を分けて整理します。</p>
    <nav class="jump-nav" aria-label="ページ内ジャンプ"><a href="#key-differences">違い</a><a href="#decision-guide">どっち向き？</a><a href="#faq">FAQ</a></nav>
    <div class="purchase-cards">
      <PurchaseCard name="タイガー MTA-J050" audience="0.5L・軽さを優先する人向け" href={tigerMtaJ050.rakutenUrl} productId="tiger-mta-j050" imagePath={tigerMtaJ050.imagePath} placement="after-decision" note="価格・在庫は販売先でご確認ください。" />
      <PurchaseCard name="タイガー MTA-J080" audience="0.8L・容量を優先する人向け" href={mtaJ080Rakuten} productId="tiger-mta-j080" imagePath={mtaJ080Image} placement="after-decision" note="価格・在庫は販売先でご確認ください。" />
    </div>
    <div class="verification-summary" aria-label="記事情報の確認状況"><p>商品情報確認日: <time datetime={articleMetadata.productInfoCheckedAt}>{articleMetadata.productInfoCheckedAt}</time></p>{productInfoStale && <p class="notice">商品情報の確認から時間が経過しています。購入前に公式ページで最新仕様を確認してください。</p>}</div>
    <p class="notice">広告表示：この記事には広告リンクを含みます。価格・在庫は販売先で、仕様は公式ページで確認してください。</p>
    <ArticleComparisonV2
      left={{brand: 'タイガー', line: 'MTA-J050', tagline: '0.5L・軽さを優先するなら', image: tigerMtaJ050.imagePath, imageAlt: 'タイガー MTA-J050', officialHref: officialPage, guidePoints: ['容量0.5Lで持ち歩きやすい', '本体質量約0.26kgで軽い', '通勤・通学など日常の持ち歩き向け']}}
      right={{brand: 'タイガー', line: 'MTA-J080', tagline: '0.8L・容量を優先するなら', image: mtaJ080Image, imageAlt: 'タイガー MTA-J080', officialHref: officialPage, guidePoints: ['容量0.8Lで多めに入れられる', '保冷効力7℃以下の案内', '長時間の外出や水分補給向け']}}
      rows={keyDiffRows}
      checkedAt={articleMetadata.productInfoCheckedAt}
    />
    <h2 id="official">公式情報</h2>
    <p>タイガー公式のMTA-J050/J080商品ページで確認できる内容を整理します。シリーズ共通の仕様と、容量による差を分けて掲載しています。</p>
    <h3>シリーズ共通で公式に確認できること</h3>
    <ul class="official-list"><li>ハンドル付きのワンプッシュマグボトル。</li><li>せんとパッキンが一体になった「らくらくキャップ」を搭載。</li><li>外せる飲み口で洗える構造。</li><li>スーパークリーンPlusを採用し、スポーツドリンク対応が案内されている。</li><li>ステンレス製真空二重構造で保温・保冷する。</li></ul>
    <h3>容量ごとの違い</h3>
    <ul class="official-list"><li>MTA-J050は0.5L、約0.26kg、保冷効力8℃以下、保温効力68℃以上です。</li><li>MTA-J080は0.8L、約0.36kg、保冷効力7℃以下、保温効力75℃以上です。</li><li>カラーはどちらも4色のラインアップが公式ページに掲載されています。</li></ul>
    <ArticleSocialProof query="タイガー MTA-J050 MTA-J080 水筒" checkedAt="2026-08-16" hasPosts={false} />
    <h2 id="faq">よくある質問</h2><div class="faq-list">{faqEntries.map((entry) => <details class="faq-item"><summary><h3>{entry.question}</h3></summary><p>{entry.answer}</p></details>)}</div>
    <h2>購入時の注意</h2><p>価格・在庫・カラーの販売状況は販売先で変わる可能性があります。購入時は型番、容量、カラー、付属品、最新の取扱説明を確認してください。</p>
    <div class="purchase-cards"><PurchaseCard name="タイガー MTA-J050" audience="0.5L・軽さを優先する人向け" href={tigerMtaJ050.rakutenUrl} productId="tiger-mta-j050" imagePath={tigerMtaJ050.imagePath} placement="article-end" note="価格・在庫は販売先でご確認ください。" /><PurchaseCard name="タイガー MTA-J080" audience="0.8L・容量を優先する人向け" href={mtaJ080Rakuten} productId="tiger-mta-j080" imagePath={mtaJ080Image} placement="article-end" note="価格・在庫は販売先でご確認ください。" /></div>
    <h2>更新履歴</h2><ol class="change-log">{articleMetadata.changeLog.map((entry) => <li><time datetime={entry.date}>{entry.date}</time>：{entry.summary}</li>)}</ol>
    <h2>情報源一覧</h2><ul class="source-list"><li><a href={officialPage} target="_blank" rel="noopener noreferrer">タイガー MTA-J050/J080公式ページ</a>（2026-08-16確認）</li><li><a href={mtaJ080Rakuten} target="_blank" rel="noopener noreferrer">楽天市場：タイガー MTA-J080</a>（価格・在庫用）</li></ul>
    <p>この記事はメーカー公式の商品ページを根拠に整理しています。個人の感想や口コミは比較の根拠にしていません。</p>
  </article>
  <RelatedArticles currentPath={articleMetadata.path} currentCategory={articleMetadata.category} />
</BaseLayout>

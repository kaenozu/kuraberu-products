---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {yamazakiTowerDeskPanelArticle as articleMetadata} from '../../../content/articles';

const panelOfficial = 'https://www.yamajitsu.co.jp/products/240034'

const penStandOfficial = 'https://www.yamajitsu.co.jp/products/240051'

const panelImage = '/products/yamazaki-tower-desk-panel.jpg'

const penStandImage = '/products/yamazaki-tower-magnetic-pen-stand.jpg'

const panel = {
  brand: '山崎実業 tower',
  line: 'デスク横トレー付きスチールパネル（10066 / 10067）',
  image: panelImage,
  imageAlt: '山崎実業 tower デスク横トレー付きスチールパネル',
  audience: 'デスク横にトレーとマグネット収納をまとめたい人向け',
}

const penStand = {
  brand: '山崎実業 tower',
  line: 'マグネットペンスタンド（10096 / 10097）',
  image: penStandImage,
  imageAlt: '山崎実業 tower マグネットペンスタンド',
  audience: 'ペンを立てて省スペースに収納したい人向け',
}

const faqEntries = [
  {question: 'パネルはどのデスクにも取り付けられる？', answer: '公式ページでは、天板の厚さ1.2〜5cm、幅60cm以上、奥行4.6cm以上などの条件が案内されています。購入前に使うデスクの寸法を確認してください。'},
  {question: 'ペンスタンドはどこに取り付けられる？', answer: 'マグネットがつく平らな面やスチール面に取り付ける商品です。パネルに組み合わせるほか、条件に合う別の場所でも使えます。'},
  {question: '2商品は組み合わせて使える？', answer: '公式ページでは、パネルにマグネット小物を追加する使い方と、ペンスタンドをパネルに取り付ける使い方が案内されています。デスク横に収納面を作るか、単体で小物を立てるかで選ぶと整理しやすいです。'},
] as const

const keyDiffRows: KeyDiffRow[] = [
  {label: '向いている使い方', left: 'デスク横に収納面とトレーを作る', right: 'ペンや小物を立てて置く', highlight: null},
  {label: '設置条件', left: '天板厚1.2〜5cm・幅60cm以上など', right: 'マグネットがつく平らな面・スチール面', highlight: null},
  {label: '組み合わせ', left: 'マグネット小物を追加できる', right: 'パネルに取り付けて使える', highlight: null},
  {label: 'サイズ', left: 'W58×D4.8×H41.7〜45.5cm', right: 'W6.2×D6.2×H20.8cm', highlight: null},
]

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: panel.brand, line: panel.line, tagline: 'デスク横の面を使ってまとめるなら', image: panel.image, imageAlt: panel.imageAlt, officialHref: panelOfficial, guidePoints: [panel.audience], purchaseHref: articlePurchaseLinks['yamazaki-tower-desk-panel-vs-pen-stand:left'].purchaseUrl, productId: 'yamazaki-tower-desk-panel'}}
  right={{brand: penStand.brand, line: penStand.line, tagline: 'ペンを立てて省スペースに置くなら', image: penStand.image, imageAlt: penStand.imageAlt, officialHref: penStandOfficial, guidePoints: [penStand.audience], purchaseHref: articlePurchaseLinks['yamazaki-tower-desk-panel-vs-pen-stand:right'].purchaseUrl, productId: 'yamazaki-tower-magnetic-pen-stand'}}
  keyDiffRows={keyDiffRows}
  lead={"山崎実業 towerのデスク横トレー付きスチールパネルとマグネットペンスタンドを、買って使えるかに直結する設置条件・用途・組み合わせ方を中心に比較します。重量や耐荷重などの数値は詳細仕様にまとめます。"}
  officialDescription={"上の比較は、山崎実業公式の商品ページ（240034・240051）で2026年8月13日に確認した内容です。カラー別品番、仕様、設置条件は購入前に公式ページで再確認してください。"}
  socialProofQuery={"山崎実業 tower 10066 10067 10096 10097"}
  faqEntries={faqEntries}
  leftPurchaseName={panel.line}
  leftPurchaseAudience={panel.audience}
  rightPurchaseName={penStand.line}
  rightPurchaseAudience={penStand.audience}
  sourceLinks={[
    { label:"山崎実業公式：デスク横トレー付きスチールパネル", href:panelOfficial, checkedAt:"2026-08-13" },
    { label:"山崎実業公式：マグネットペンスタンド", href:penStandOfficial, checkedAt:"2026-08-13" },
  ]}
/>
---
import { articlePurchaseLinks} from '../../../lib/products';
import ArticleComparisonPage from '../../../components/ArticleComparisonPage.astro';
import type { KeyDiffRow } from '../../../components/VisualKeyDifferences.astro';
import {panasonicEhNa9mVsEhNa7mArticle as articleMetadata} from '../../../content/articles';

const leftOfficial = 'https://panasonic.jp/hair/products/EH-NA9M.html';

const rightOfficial = 'https://panasonic.jp/hair/products/EH-NA7M.html';



const leftImage = '/products/panasonic-eh-na9m.jpg';

const rightImage = '/products/panasonic-eh-na7m.jpg';

const leftAudience = '髪のケア機能と複数モードを重視する人向け';

const rightAudience = '折りたたみやすさと持ち運びを重視する人向け';

const faqEntries = [
  {question: 'EH-NA9MとEH-NA7Mの大きな違いは？', answer: '公式仕様では、EH-NA9Mがミネラル・UVケア・ナノイーイオンチャージPLUSと複数のモードを搭載する一方、EH-NA7Mはナノイー・静電気抑制・ナノイーイオンチャージを搭載しています。EH-NA7Mは折りたためる点も公式比較で案内されています。'},
  {question: '風量が大きいのはどちら？', answer: '両モデルとも、公式仕様でTURBO時1.5㎥/分と確認できます。風量だけでは大きな差がないため、機能や収納性も合わせて選ぶのがよさそうです。'},
  {question: '軽いのはどちら？', answer: '公式仕様では、EH-NA7Mが約565g、EH-NA9Mが約580gです。差は約15gなので、重さだけでなく搭載機能や折りたたみの有無も確認してください。'},
  {question: '価格や在庫は比較できる？', answer: 'この記事の購入導線は楽天市場の型番検索です。価格・在庫・ポイント・送料は変動するため、購入時点の販売ページで確認してください。'},
];

const keyDiffRows: KeyDiffRow[] = [
  {label: '搭載機能', left: 'ミネラル・UVケア・ナノイーイオンチャージPLUS', right: '静電気抑制・ナノイーイオンチャージ', highlight: 'left'},
  {label: 'モード', left: '温冷リズム・毛先集中ケア・スカルプ・スキン', right: '公式比較では記載なし', highlight: 'left'},
  {label: '風量（TURBO）', left: '1.5㎥/分', right: '1.5㎥/分'},
  {label: '質量', left: '約580g', right: '約565g', highlight: 'right', highlightNote: '約15g軽い'},
  {label: '収納性', left: '公式比較では折りたたみ案内なし', right: '折りたためるタイプ', highlight: 'right'},
];

---

<ArticleComparisonPage
  articleMetadata={articleMetadata}
  left={{brand: 'パナソニック ナノケア', line: 'EH-NA9M', tagline: '髪のケア機能・モードなら', image: leftImage, imageAlt: 'パナソニック ナノケア EH-NA9M', officialHref: leftOfficial, guidePoints: [leftAudience], purchaseHref: articlePurchaseLinks['panasonic-eh-na9m-vs-eh-na7m:left'].purchaseUrl}}
  right={{brand: 'パナソニック ナノケア', line: 'EH-NA7M', tagline: '持ち運び・収納性なら', image: rightImage, imageAlt: 'パナソニック ナノケア EH-NA7M', officialHref: rightOfficial, guidePoints: [rightAudience], purchaseHref: articlePurchaseLinks['panasonic-eh-na9m-vs-eh-na7m:right'].purchaseUrl}}
  keyDiffRows={keyDiffRows}
  lead={"パナソニックのナノケア EH-NA9MとEH-NA7Mを、公式ページで確認できる搭載機能・モード・風量・重さ・収納性から比較します。"}
  summaryParagraph={"EH-NA9Mはミネラル・UVケア・複数モードなどの機能を重視する人向け、EH-NA7Mは折りたたみやすさと軽さを重視する人向けです。風量は両モデルとも公式仕様で1.5㎥/分と確認できます。"}
  officialDescription={"比較の根拠は、パナソニック公式の商品ページと仕様ページで確認した情報です。公式情報確認日：{articleMetadata.productInfoCheckedAt}。"}
  officialLinks={[
    { label: "EH-NA9M 公式商品ページ", href: leftOfficial },
    { label: "EH-NA7M 公式商品ページ", href: rightOfficial },
  ]}
  socialProofQuery={"パナソニック EH-NA9M EH-NA7M ナノケア"}
  faqEntries={faqEntries}
  leftPurchaseName={"パナソニック ナノケア EH-NA9M"}
  leftPurchaseAudience={leftAudience}
  rightPurchaseName={"パナソニック ナノケア EH-NA7M"}
  rightPurchaseAudience={rightAudience}
  sourceLinks={[
    { label:"パナソニック EH-NA9M 公式商品ページ", href:leftOfficial, checkedAt:"{articleMetadata.productInfoCheckedAt}" },
    { label:"パナソニック EH-NA7M 公式商品ページ", href:rightOfficial, checkedAt:"{articleMetadata.productInfoCheckedAt}" },
  ]}
  purchaseWarning={"ドライヤーは機能の名称だけで使用感を断定できません。価格・在庫・付属品は購入時点の公式ページと販売先で確認してください。"}
  disclaimer={"この比較は、パナソニック公式の商品ページと仕様ページで確認できる情報を根拠にしています。口コミや未確認の販売情報は比較の根拠にしていません。"}
/>
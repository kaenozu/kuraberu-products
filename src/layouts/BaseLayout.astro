---
import '../styles/global.css';
import '../styles/accessibility.css';
import {site} from '../config/site';
import type {ArticleMetadata} from '../content/articles';
import {contentTypeFor} from '../../config/article-layout.mjs';
import {safeJsonForScript} from '../lib/safe-json';

interface Props {
  title?: string;
  description?: string;
  robots?: 'index,follow' | 'noindex,nofollow';
  ogType?: 'website' | 'article';
  article?: ArticleMetadata;
  faq?: readonly { question: string; answer: string }[];
}

const {
  title = site.name,
  description = site.description,
  robots,
  ogType,
  article,
  faq,
} = Astro.props;
const isProduction = import.meta.env.DEPLOYMENT_ENV === 'production';
// 本番デプロイ時のみ tools/production が注入するビルド元コミットSHA（PostDeploy検証で照合）。未設定時は出力しない。
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
const canonical = new URL(Astro.url.pathname, `${site.url}/`).toString();
const robotsContent = robots ?? (isProduction ? 'index,follow' : 'noindex,nofollow');
const resolvedOgType = article ? 'article' : (ogType ?? 'website');
const currentPath = Astro.url.pathname;
const articleImage = article?.imagePath
  ? new URL(article.imagePath, `${site.url}/`).toString()
  : undefined;
// 記事の JSON-LD 分化（article:content-type と同一の contentTypeFor から導出）。
// 商品名を宣言した記事だけ about（schema.org Product）を出力する:
// 商品ガイド = 1 商品、比較記事 = 2 商品。未宣言の比較記事は about を出さない。
const aboutProducts = article?.aboutProductNames?.map((name) => ({
  '@type': 'Product',
  name,
}));
const organization = {
  '@type': 'Organization',
  name: site.name,
  url: site.url,
};
const structuredData = resolvedOgType === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: article?.headline ?? title,
      description: article?.description ?? description,
      url: canonical,
      mainEntityOfPage: canonical,
      datePublished: article?.publishedAt,
      dateModified: article?.modifiedAt,
      ...(articleImage ? {image: articleImage} : {}),
      ...(aboutProducts ? {about: aboutProducts} : {}),
      author: organization,
      publisher: organization,
      isAccessibleForFree: true,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical,
      isPartOf: {
        '@type': 'WebSite',
        name: site.name,
        url: site.url,
      },
    };
const structuredDataJson = safeJsonForScript(structuredData);

const breadcrumbStructuredData = article
  ? safeJsonForScript({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'ホーム',
          item: site.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: '比較記事一覧',
          item: `${site.url}/articles/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: article?.headline ?? title,
          item: canonical,
        },
      ],
    })
  : undefined;
const faqStructuredData = faq && faq.length > 0
  ? safeJsonForScript({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((entry) => ({
        '@type': 'Question',
        name: entry.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: entry.answer,
        },
      })),
    })
  : undefined;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {buildSha && <meta name="build-sha" content={buildSha} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {articleImage && (
      <>
        <meta property="og:image" content={articleImage} />
        {/* 実寸（og:image:width/height）は不明のため出力しない。alt は記事見出し由来。 */}
        <meta property="og:image:alt" content={article?.headline ?? title} />
      </>
    )}
    {article?.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
    {article?.modifiedAt && <meta property="article:modified_time" content={article.modifiedAt} />}
    {article?.modifiedAt && <meta property="og:updated_time" content={article.modifiedAt} />}
    {/* 商品数（品質ゲートが CTA 期待枚数を記事ごとに導出するための内部メタ） */}
    {article && <meta name="article:product-count" content={String(article.productCount)} />}
    {article && <meta name="article:content-type" content={contentTypeFor(article.productCount)} />}
    {article?.purchaseLinkStatus && <meta name="article:purchase-link-status" content={article.purchaseLinkStatus} />}
    {article?.productInfoCheckedAt && (
      <meta name="article:product-info-checked-at" content={article.productInfoCheckedAt} />
    )}
    <meta name="twitter:card" content={articleImage ? 'summary_large_image' : 'summary'} />
    {articleImage && <meta name="twitter:image" content={articleImage} />}
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    {breadcrumbStructuredData && <script is:inline type="application/ld+json" set:html={breadcrumbStructuredData} />}
    {faqStructuredData && <script is:inline type="application/ld+json" set:html={faqStructuredData} />}
  </head>
  <body class={currentPath === '/' ? 'home-page' : undefined}>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">{site.name}</a>
        <!-- スマホ（<560px）では ロゴ + ☰ になり、リンクはドロワーパネルに格納される。
              details/summary のネイティブ開閉を使うため JS 不要。
              デスクトップ（≥561px）では summary が display:none のため、閉じた details の
              中身は描画されない。下のインラインスクリプトが幅に応じて open を同期する。 -->
        <details class="nav-toggle" data-nav-toggle>
          <summary aria-label="メニューを開く"><span class="nav-toggle-icon" aria-hidden="true"></span></summary>
          <nav class="navlinks" aria-label="主要メニュー">
            <a href="/articles/" aria-current={currentPath.startsWith('/articles/') ? 'page' : undefined}>比較記事</a>
            <a href="/memo/" aria-current={currentPath === '/memo/' ? 'page' : undefined}>比較メモ</a>
            <a href="/tools/product-finder/" aria-current={currentPath.startsWith('/tools/product-finder/') ? 'page' : undefined}>商品診断</a>
            <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>運営者情報</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="footer">
      <div class="wrap">
        <p>広告を含みます。価格・在庫・仕様は販売先でご確認ください。</p>
        {import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG?.trim() && (
          <p>Amazonのアソシエイトとして、{site.name}は適格販売により収入を得ています。</p>
        )}
        <p><a href="/privacy/">プライバシーポリシー</a> · <a href="/disclaimer/">広告・免責事項</a> · <a href="/about/">運営者情報</a></p>
      </div>
    </footer>
    <!-- グローバルナビの開閉状態をビューポート幅へ同期する。
          summary はデスクトップで display:none のため、閉じた details の中身
          （navlinks）は CSS では再表示できない。広い幅では details を open にして
          ナビを常時表示し、狭い幅では閉じてモバイルのドロワー挙動（ネイティブ開閉）を維持する。
          外部JS化: inline script は Production CSP（script-src 'self'）で実行不可のため、
          同一オリジンの /nav-toggle.js として外部化。
          marker: nav-toggle-sync -->
    <script is:inline src="/nav-toggle.js" defer></script>
    <!-- クリック計測（プライバシー配慮型・同一オリジン）。詳細: docs/click-analytics.md -->
    <script is:inline src="/click-beacon.js" defer></script>
    <!-- 比較表のスマホ比較カード表示用: 各セルへ列見出し（商品名）を data-label として付与する。
         2026-08-18 から全記事の比較表は静的 HTML に data-label を焼き込み済みのため、
         このスクリプトは未付与セルへのフォールバック（ゲートが焼き込みを強制）。
         marker: comparison-card-labels -->
    <script is:inline src="/comparison-table-labels.js" defer></script>
  </body>
</html>

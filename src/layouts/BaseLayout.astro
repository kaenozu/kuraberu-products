---
import '../styles/global.css';
import '../styles/accessibility.css';
import {site} from '../config/site';
import type {ArticleMetadata} from '../content/articles';

interface Props {
  title?: string;
  description?: string;
  robots?: 'index,follow' | 'noindex,nofollow';
  ogType?: 'website' | 'article';
  article?: ArticleMetadata;
}

const {
  title = site.name,
  description = site.description,
  robots,
  ogType,
  article,
} = Astro.props;
const isProduction = import.meta.env.DEPLOYMENT_ENV === 'production';
if (isProduction && !site.buildSha) {
  throw new Error('Production HTML requires PUBLIC_BUILD_SHA');
}
const canonical = new URL(Astro.url.pathname, `${site.url}/`).toString();
const robotsContent = robots ?? (isProduction ? 'index,follow' : 'noindex,nofollow');
const resolvedOgType = article ? 'article' : (ogType ?? 'website');
const articleImage = article?.imagePath
  ? new URL(article.imagePath, `${site.url}/`).toString()
  : undefined;
const organization = {
  '@type': 'Organization',
  name: site.name,
  url: site.url,
};
const structuredData = resolvedOgType === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: article?.headline ?? title,
      description: article?.description ?? description,
      url: canonical,
      mainEntityOfPage: canonical,
      datePublished: article?.publishedAt,
      dateModified: article?.modifiedAt,
      ...(articleImage ? {image: articleImage} : {}),
      author: organization,
      publisher: organization,
      isAccessibleForFree: true,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical,
      isPartOf: {
        '@type': 'WebSite',
        name: site.name,
        url: site.url,
      },
    };
const structuredDataJson = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {site.buildSha && <meta name="x-build-sha" content={site.buildSha} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {articleImage && <meta property="og:image" content={articleImage} />}
    {article?.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
    {article?.modifiedAt && <meta property="article:modified_time" content={article.modifiedAt} />}
    <meta name="twitter:card" content={articleImage ? 'summary_large_image' : 'summary'} />
    {articleImage && <meta name="twitter:image" content={articleImage} />}
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">{site.name}</a>
        <nav class="navlinks" aria-label="主要メニュー">
          <a href="/articles/">比較記事</a>
          <a href="/memo/">比較メモ</a>
          <a href="/about/">運営者情報</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="wrap">
        <p>広告を含みます。価格・在庫・仕様は販売先でご確認ください。</p>
        <p><a href="/privacy/">プライバシーポリシー</a> · <a href="/disclaimer/">広告・免責事項</a></p>
      </div>
    </footer>
  </body>
</html>

DEPLOYMENT_ENV=preview
PUBLIC_SITE_URL=https://kuraberu-products.pages.dev
# Productionの購入リンクは、次の直接URL2件を両方設定するか、楽天API認証情報3件をすべて設定する。
PUBLIC_RAKUTEN_PREMIUM_URL=
PUBLIC_RAKUTEN_SARASARA_URL=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# 任意：楽天アフィリエイトリダイレクトのURLプレフィックス。未設定時はデフォルト値を使用。
PUBLIC_RAKUTEN_AFFILIATE_REDIRECT=
# 任意：aboutページの問い合わせ先HTTPS URL。未設定時は「準備中」表示にフォールバックする。
PUBLIC_CONTACT_URL=
PUBLIC_RAKUTEN_BABYBJORN_CRADLE_URL=
PUBLIC_RAKUTEN_APRICA_COCONEL_AIR_URL=
PUBLIC_RAKUTEN_PIGEON_160_URL=
# 任意：AmazonアソシエイトのトラッキングID。設定時に全購入カードへAmazon導線を表示する。
# Amazonの商品情報・価格は取得せず、型番/商品名の検索結果へリンクする。
PUBLIC_AMAZON_ASSOCIATE_TAG=
